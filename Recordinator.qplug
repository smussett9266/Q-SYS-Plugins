-- Recordinator
-- Lecture recording TCP client for The Record-Inator (from recordinator v1.0 user component)
-- Protocol: The Record-Inator v1.0 communication manual (STX/ETX, TCP 5201)
-- by Skip Mussett / Cursor Agent
-- August 2026

PluginInfo = {
  Name = "Utilities~Recordinator",
  Version = "1.0.6",
  BuildVersion = "1.0.6.0",
  Id = "c4e8a1d2-7b93-4f6e-91a0-5d2c8b47e6f1",
  Author = "Skip Mussett",
  Description = [[
Controls a Record-Inator lecture recorder over TCP. Query the class list,
confirm a session, record, and stop/save. Power and operational states
follow the v1.0 communication manual (WTG / RDY / REC / SAV).
  ]],
  ShowDebug = true,
}

PageNames = { "Setup", "Recording" }
LED_STATES = { "WTG", "RDY", "REC", "SAV" }
MAX_RECORD_SECONDS = 999

function GetColor(props)
  return { 1, 102, 255 }
end

function GetPrettyName(props)
  return "Recordinator v" .. PluginInfo.Version
end

UI = {
  boldBlue = { 1, 102, 255 },
  cyan = { 27, 212, 219 },
  balancedBlack = { 28, 28, 28 },
  pureWhite = { 255, 255, 255 },
  expertGreen = { 0, 196, 120 },
  electricRed = { 255, 45, 85 },
  bg = { 28, 28, 28 },
  panel = { 40, 40, 44 },
  card = { 48, 48, 54 },
  cardAlt = { 56, 56, 62 },
  stroke = { 78, 78, 88 },
  accent = { 1, 102, 255 },
  accentSoft = { 27, 212, 219 },
  text = { 255, 255, 255 },
  muted = { 168, 168, 176 },
  ledOn = { 0, 196, 120 },
  ledOff = { 112, 36, 48 },
  btnOn = { 1, 102, 255 },
  btnOff = { 56, 56, 64 },
  header = { 28, 28, 28 },
}

function GetPages(props)
  pages = {}
  for idx, name in ipairs(PageNames) do
    table.insert(pages, { name = PageNames[idx] })
  end
  return pages
end

function GetProperties()
  props = {}
  table.insert(props, {
    Name = "Default IP",
    Type = "string",
    Value = "127.0.0.1",
  })
  table.insert(props, {
    Name = "Default Port",
    Type = "integer",
    Min = 1,
    Max = 65535,
    Value = 5201,
  })
  table.insert(props, {
    Name = "Poll Seconds",
    Type = "double",
    Min = 1,
    Max = 30,
    Value = 5,
  })
  return props
end

function RectifyProperties(props)
  if props["Default Port"].Value < 1 then
    props["Default Port"].Value = 1
  elseif props["Default Port"].Value > 65535 then
    props["Default Port"].Value = 65535
  end
  if props["Poll Seconds"].Value < 1 then
    props["Poll Seconds"].Value = 1
  elseif props["Poll Seconds"].Value > 30 then
    props["Poll Seconds"].Value = 30
  end
  return props
end

