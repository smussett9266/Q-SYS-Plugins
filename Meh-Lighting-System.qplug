-- Meh Lighting System
-- TCP client for the ReallyMeh Lighting 1995 Controller
-- (The ReallyMeh Lights & Shades Co.)
--
-- Transport: TCP port 5103. Every command ends with ASCII CR (\r).
-- Zones: 4.
--
--   Command          Syntax       Response
--   Set Level        SET:Zn:xx    none
--   Query Level      LVL:?        Zn@xx
--
--   n  = zone number (1-4)
--   xx = level value (00-99)
--
-- by Skip Mussett / Cursor Agent
-- August 2026

PluginInfo = {
  Name = "Lighting~Meh Lighting System",
  Version = "1.6.8",
  BuildVersion = "1.6.8.0",
  Id = "95fe9765-641d-4608-a063-7b67fcbf83f8",
  Author = "Skip Mussett",
  Description = [[
TCP control for the ReallyMeh Lighting 1995 Controller (port 5103).
Four lighting zones. Set Level is SET:Zn:xx (no reply). Query Level
is LVL:? and returns Zn@xx. All frames end with CR.
ACTUAL level is the source of truth: fader and preset buttons follow it.
  ]],
  ShowDebug = true,
}

MAX_ZONES = 4
MAX_PRESETS = 8
MAX_LEVEL = 99
DEFAULT_ZONE_COUNT = 4
DEFAULT_PRESET_COUNT = 5
DEFAULT_PORT = 5103
DEFAULT_POLL_SECONDS = 3
MIN_POLL_SECONDS = 0.5
MAX_POLL_SECONDS = 30
PAGE_SETUP = "Setup"

function GetColor(props)
  return { 1, 102, 255 }
end

function GetPrettyName(props)
  return string.format(
    "Meh Lighting System v%s (%d zones, %d presets)",
    PluginInfo.Version,
    props["Zone Count"].Value,
    props["Preset Count"].Value
  )
end

UI = {
  boldBlue = { 1, 102, 255 },
  cyan = { 27, 212, 219 },
  balancedBlack = { 28, 28, 28 },
  pureWhite = { 255, 255, 255 },
  expertGreen = { 0, 196, 120 },
  electricRed = { 255, 45, 85 },
  bg = { 28, 28, 28 },
  panel = { 40, 40, 44 },
  card = { 48, 48, 54 },
  cardAlt = { 56, 56, 62 },
  stroke = { 78, 78, 88 },
  accent = { 1, 102, 255 },
  accentSoft = { 27, 212, 219 },
  text = { 255, 255, 255 },
  muted = { 168, 168, 176 },
  ledOn = { 0, 196, 120 },
  ledOff = { 48, 48, 54 },
  btnOn = { 1, 102, 255 },
  btnOff = { 56, 56, 64 },
  header = { 28, 28, 28 },
}

function clampInt(value, minVal, maxVal)
  n = math.floor((tonumber(value) or minVal) + 0.5)
  if n < minVal then
    return minVal
  elseif n > maxVal then
    return maxVal
  end
  return n
end

function propertyZoneCount(props)
  return clampInt(props["Zone Count"].Value, 1, MAX_ZONES)
end

function propertyPresetCount(props)
  return clampInt(props["Preset Count"].Value, 1, MAX_PRESETS)
end

-- Shared list for GetPages / GetControlLayout / runtime page helpers.
-- page_index is 1-based: 1=Setup, 2=Zone 1, ...
function buildPageNameList(zoneCount)
  names = { PAGE_SETUP }
  for zoneIdx = 1, zoneCount do
    table.insert(names, "Zone " .. zoneIdx)
  end
  return names
end

function GetPages(props)
  pages = {}
  for _, name in ipairs(buildPageNameList(propertyZoneCount(props))) do
    table.insert(pages, { name = name })
  end
  return pages
end

function pageNameFromIndex(props)
  names = buildPageNameList(propertyZoneCount(props))
  pageIdx = tonumber(props["page_index"] and props["page_index"].Value)
  if pageIdx == nil then
    return PAGE_SETUP
  end
  pageIdx = math.floor(pageIdx + 0.5)
  if pageIdx < 1 or pageIdx > #names then
    return PAGE_SETUP
  end
  return names[pageIdx] or PAGE_SETUP
end

function zoneIndexFromPageName(pageName)
  return tonumber(string.match(tostring(pageName or ""), "^Zone (%d+)$"))
end

-- Stable flat index across MAX extents so control IDs stay put when
-- Zone Count / Preset Count change. Zone 2 Preset 1 is always index 9.
function presetFlatIndex(zoneIdx, presetIdx)
  if zoneIdx < 1 or zoneIdx > MAX_ZONES then
    return nil
  end
  if presetIdx < 1 or presetIdx > MAX_PRESETS then
    return nil
  end
  return ((zoneIdx - 1) * MAX_PRESETS) + presetIdx
end

function layoutName(base, idx)
  return base .. " " .. idx
end

function GetProperties()
  props = {}
  table.insert(props, {
    Name = "Zone Count",
    Type = "integer",
    Min = 1,
    Max = MAX_ZONES,
    Value = DEFAULT_ZONE_COUNT,
  })
  table.insert(props, {
    Name = "Preset Count",
    Type = "integer",
    Min = 1,
    Max = MAX_PRESETS,
    Value = DEFAULT_PRESET_COUNT,
  })
  table.insert(props, {
    Name = "Default IP",
    Type = "string",
    Value = "127.0.0.1",
  })
  table.insert(props, {
    Name = "Default Port",
    Type = "integer",
    Min = 1,
    Max = 65535,
    Value = DEFAULT_PORT,
  })
  table.insert(props, {
    Name = "Poll Seconds",
    Type = "double",
    Min = MIN_POLL_SECONDS,
    Max = MAX_POLL_SECONDS,
    Value = DEFAULT_POLL_SECONDS,
  })
  return props
end

function RectifyProperties(props)
  props["Zone Count"].Value = propertyZoneCount(props)
  props["Preset Count"].Value = propertyPresetCount(props)
  if props["Default Port"].Value < 1 then
    props["Default Port"].Value = 1
  elseif props["Default Port"].Value > 65535 then
    props["Default Port"].Value = 65535
  end
  if props["Poll Seconds"].Value < MIN_POLL_SECONDS then
    props["Poll Seconds"].Value = MIN_POLL_SECONDS
  elseif props["Poll Seconds"].Value > MAX_POLL_SECONDS then
    props["Poll Seconds"].Value = MAX_POLL_SECONDS
  end
  return props
end

function GetControls(props)
  ctrls = {}

  table.insert(ctrls, {
    Name = "txtIPAddress",
    ControlType = "Text",
    Count = 1,
    UserPin = true,
    PinStyle = "Both",
    DefaultValue = props["Default IP"].Value,
  })
  table.insert(ctrls, {
    Name = "knbPort",
    ControlType = "Knob",
    ControlUnit = "Integer",
    Min = 1,
    Max = 65535,
    Count = 1,
    UserPin = true,
    PinStyle = "Both",
    DefaultValue = props["Default Port"].Value,
  })
  table.insert(ctrls, {
    Name = "knbPollSeconds",
    ControlType = "Knob",
    ControlUnit = "Float",
    Min = MIN_POLL_SECONDS,
    Max = MAX_POLL_SECONDS,
    Count = 1,
    UserPin = true,
    PinStyle = "Both",
    DefaultValue = props["Poll Seconds"].Value,
  })
  table.insert(ctrls, {
    Name = "status",
    ControlType = "Indicator",
    IndicatorType = "Status",
    Count = 1,
    UserPin = true,
    PinStyle = "Output",
  })
  table.insert(ctrls, {
    Name = "txtStatus",
    ControlType = "Text",
    Count = 1,
    UserPin = true,
    PinStyle = "Output",
  })
  table.insert(ctrls, {
    Name = "ledConnected",
    ControlType = "Indicator",
    IndicatorType = "Led",
    Count = 1,
    UserPin = true,
    PinStyle = "Output",
  })
  table.insert(ctrls, {
    Name = "lightingFader",
    ControlType = "Knob",
    ControlUnit = "Integer",
    Min = 0,
    Max = MAX_LEVEL,
    Count = MAX_ZONES,
    UserPin = true,
    PinStyle = "Both",
  })
  table.insert(ctrls, {
    Name = "actualLevel",
    ControlType = "Knob",
    ControlUnit = "Integer",
    Min = 0,
    Max = MAX_LEVEL,
    Count = MAX_ZONES,
    UserPin = true,
    PinStyle = "Output",
  })
  table.insert(ctrls, {
    Name = "lightingPreset",
    ControlType = "Button",
    ButtonType = "Toggle",
    Count = MAX_ZONES * MAX_PRESETS,
    UserPin = true,
    PinStyle = "Both",
  })
  table.insert(ctrls, {
    Name = "setLightLevels",
    ControlType = "Knob",
    ControlUnit = "Integer",
    Min = 0,
    Max = MAX_LEVEL,
    Count = MAX_ZONES * MAX_PRESETS,
    UserPin = true,
    PinStyle = "Both",
  })

  return ctrls
end

function GetControlLayout(props)
  layout = {}
  graphics = {}
  zoneCount = propertyZoneCount(props)
  presetCount = propertyPresetCount(props)
  currentPage = pageNameFromIndex(props)
  currentZone = zoneIndexFromPageName(currentPage)
  panelWidth = 680
  setupWidth = 480
  setupHeight = 216
  presetRowHeight = 36
  zoneBodyHeight = math.max(248, 56 + (presetCount * 42))
  zoneHeight = 56 + 16 + zoneBodyHeight + 16

  function hideCtrl(name, pretty)
    layout[name] = {
      PrettyName = pretty,
      Style = "None",
    }
  end

  hideCtrl("txtIPAddress", "Setup~IP Address")
  hideCtrl("knbPort", "Setup~Port")
  hideCtrl("knbPollSeconds", "Setup~Poll Seconds")
  hideCtrl("status", "Setup~Status")
  hideCtrl("txtStatus", "Setup~Status Text")
  hideCtrl("ledConnected", "Setup~Connected")

  for zoneIdx = 1, MAX_ZONES do
    hideCtrl(
      layoutName("lightingFader", zoneIdx),
      string.format("Zone %d~Level", zoneIdx)
    )
    hideCtrl(
      layoutName("actualLevel", zoneIdx),
      string.format("Zone %d~Actual Level", zoneIdx)
    )
    for presetIdx = 1, MAX_PRESETS do
      flatIdx = presetFlatIndex(zoneIdx, presetIdx)
      hideCtrl(
        layoutName("lightingPreset", flatIdx),
        string.format("Zone %d~Preset %d", zoneIdx, presetIdx)
      )
      hideCtrl(
        layoutName("setLightLevels", flatIdx),
        string.format("Zone %d~Preset Level %d", zoneIdx, presetIdx)
      )
    end
  end

  function blendRgb(colorA, colorB, amount)
    if amount < 0 then
      amount = 0
    elseif amount > 1 then
      amount = 1
    end
    return {
      math.floor(colorA[1] + ((colorB[1] - colorA[1]) * amount) + 0.5),
      math.floor(colorA[2] + ((colorB[2] - colorA[2]) * amount) + 0.5),
      math.floor(colorA[3] + ((colorB[3] - colorA[3]) * amount) + 0.5),
    }
  end

  function drawBrandGradientBar(x, y, width, height, steps)
    if steps < 2 then
      steps = 2
    end
    stepWidth = width / steps
    for stepIdx = 0, steps - 1 do
      amount = stepIdx / (steps - 1)
      segX = math.floor(x + (stepIdx * stepWidth))
      nextX = math.floor(x + ((stepIdx + 1) * stepWidth))
      if stepIdx == steps - 1 then
        nextX = x + width
      end
      table.insert(graphics, {
        Type = "GroupBox",
        Fill = blendRgb(UI.boldBlue, UI.cyan, amount),
        StrokeWidth = 0,
        CornerRadius = 0,
        Position = { segX, y },
        Size = { math.max(1, nextX - segX), height },
      })
    end
  end

  function drawPageChrome(title, width, bodyHeight)
    table.insert(graphics, {
      Type = "GroupBox",
      Fill = UI.bg,
      StrokeWidth = 0,
      CornerRadius = 0,
      Position = { 0, 0 },
      Size = { width, bodyHeight },
    })
    table.insert(graphics, {
      Type = "GroupBox",
      Fill = UI.header,
      StrokeWidth = 0,
      CornerRadius = 0,
      Position = { 0, 0 },
      Size = { width, 44 },
    })
    drawBrandGradientBar(0, 44, width, 3, 24)
    table.insert(graphics, {
      Type = "Label",
      Text = title,
      Position = { 14, 10 },
      Size = { width - 28, 24 },
      Color = UI.text,
      Font = "Montserrat",
      FontStyle = "Bold",
      FontSize = 15,
      HTextAlign = "Left",
    })
  end

  function drawCard(x, y, width, height)
    table.insert(graphics, {
      Type = "GroupBox",
      Fill = UI.panel,
      StrokeWidth = 1,
      StrokeColor = UI.stroke,
      CornerRadius = 12,
      Position = { x, y },
      Size = { width, height },
    })
  end

  function drawLabel(text, x, y, width, color, size)
    table.insert(graphics, {
      Type = "Label",
      Text = text,
      Position = { x, y },
      Size = { width, 14 },
      Color = color or UI.accentSoft,
      Font = "Montserrat",
      FontStyle = "Bold",
      FontSize = size or 10,
      HTextAlign = "Left",
    })
  end

  function textField(pretty)
    return {
      PrettyName = pretty,
      Style = "Text",
      CornerRadius = 6,
      Color = UI.card,
      StrokeColor = UI.stroke,
      TextColor = UI.text,
    }
  end

  if currentPage == PAGE_SETUP then
    drawPageChrome("Lighting System", setupWidth, setupHeight)
    drawCard(10, 56, setupWidth - 20, 148)
    drawLabel("SETUP CONNECTION", 24, 64, 200)
    drawLabel("IP Address", 24, 88, 90, UI.muted, 11)
    drawLabel("Port", 24, 118, 90, UI.muted, 11)
    drawLabel("Poll (s)", 250, 118, 70, UI.muted, 11)
    drawLabel("Status", 24, 148, 90, UI.muted, 11)

    layout["txtIPAddress"] = textField("Setup~IP Address")
    layout["txtIPAddress"].Position = { 128, 84 }
    layout["txtIPAddress"].Size = { 318, 22 }

    layout["knbPort"] = textField("Setup~Port")
    layout["knbPort"].Position = { 128, 114 }
    layout["knbPort"].Size = { 100, 22 }
    layout["knbPort"].Style = "Text"

    layout["knbPollSeconds"] = textField("Setup~Poll Seconds")
    layout["knbPollSeconds"].Position = { 328, 114 }
    layout["knbPollSeconds"].Size = { 70, 22 }
    layout["knbPollSeconds"].Style = "Text"

    layout["ledConnected"] = {
      PrettyName = "Setup~Connected",
      Style = "Led",
      Position = { 128, 148 },
      Size = { 16, 16 },
      CornerRadius = 8,
      Color = UI.ledOn,
      OffColor = UI.ledOff,
      UnlinkOffColor = true,
    }

    -- Status Indicator (Value + String). txtStatus stays pin-only Style None.
    layout["status"] = {
      PrettyName = "Setup~Status",
      Style = "Status",
      Position = { 152, 144 },
      Size = { 294, 22 },
    }

  elseif currentZone and currentZone >= 1 and currentZone <= zoneCount then
    drawPageChrome("Zone " .. currentZone, panelWidth, zoneHeight)
    drawCard(10, 56, 330, zoneBodyHeight)
    drawCard(350, 56, 320, zoneBodyHeight)
    drawLabel("LEVEL", 24, 64, 80)
    drawLabel("PRESETS", 130, 64, 180)
    drawLabel("PRESET LEVELS", 364, 64, 180)
    drawLabel("ACTUAL", 24, 56 + zoneBodyHeight - 40, 88, UI.accentSoft, 9)

    layout[layoutName("lightingFader", currentZone)] = {
      PrettyName = string.format("Zone %d~Level", currentZone),
      Style = "Fader",
      Position = { 24, 86 },
      Size = { 88, zoneBodyHeight - 78 },
      Color = UI.accent,
      ShowTextbox = true,
    }

    layout[layoutName("actualLevel", currentZone)] = {
      PrettyName = string.format("Zone %d~Actual Level", currentZone),
      Style = "Text",
      Position = { 24, 56 + zoneBodyHeight - 26 },
      Size = { 88, 22 },
      CornerRadius = 6,
      Color = UI.card,
      StrokeColor = UI.stroke,
      TextColor = UI.accentSoft,
      HTextAlign = "Center",
    }

    btnH = math.max(28, math.min(40, math.floor((zoneBodyHeight - 50) / presetCount) - 6))
    for presetIdx = 1, presetCount do
      flatIdx = presetFlatIndex(currentZone, presetIdx)
      btnY = 86 + ((presetIdx - 1) * (btnH + 6))
      layout[layoutName("lightingPreset", flatIdx)] = {
        PrettyName = string.format("Zone %d~Preset %d", currentZone, presetIdx),
        Style = "Button",
        ButtonStyle = "Toggle",
        ButtonVisualStyle = "Flat",
        Position = { 128, btnY },
        Size = { 196, btnH },
        CornerRadius = 8,
        Color = UI.btnOn,
        OffColor = UI.btnOff,
        UnlinkOffColor = true,
        StrokeWidth = 0,
        Legend = string.format("Preset %d", presetIdx),
        FontSize = 11,
        Font = "Montserrat",
        FontStyle = "Bold",
        TextColor = UI.text,
      }

      rowY = 86 + ((presetIdx - 1) * presetRowHeight)
      table.insert(graphics, {
        Type = "Label",
        Text = string.format("Preset %d", presetIdx),
        Position = { 364, rowY + 4 },
        Size = { 90, 16 },
        Color = UI.muted,
        Font = "Roboto",
        FontSize = 11,
        HTextAlign = "Left",
      })
      layout[layoutName("setLightLevels", flatIdx)] = {
        PrettyName = string.format("Zone %d~Preset Level %d", currentZone, presetIdx),
        Style = "Text",
        Position = { 458, rowY },
        Size = { 196, 22 },
        CornerRadius = 6,
        Color = UI.card,
        StrokeColor = UI.stroke,
        TextColor = UI.text,
      }
    end
  end

  return layout, graphics
end

if Controls then
  print(PluginInfo.Version)

  zoneCount = propertyZoneCount(Properties)
  presetCount = propertyPresetCount(Properties)
  DEBUG = true
  EOL = "\r"
  STATUS_OK = 0
  STATUS_FAULT = 2
  STATUS_MISSING = 4
  STATUS_INIT = 5

  sock = TcpSocket.New()
  sock.ReconnectTimeout = 5
  sock.ReadTimeout = 0
  pollTime = Timer.New()
  rxBuf = ""
  lastRx = ""
  pollsWithoutRx = 0
  intentionalDisconnect = false
  suppressConfigHandlers = false
  userHoldUntil = {}

  handlerMuteDepth = 0
  arrayPresetLevels = {}
  lastSentLevel = {}
  feedbackUntil = {}
  ignorePresetUntil = {}
  selectedPreset = {}

  function debugPrint(...)
    if DEBUG then
      print(...)
    end
  end

  function toPrintable(s)
    return string.gsub(tostring(s or ""), ".", function(ch)
      b = string.byte(ch)
      if b < 32 or b > 126 then
        return string.format("<%02X>", b)
      end
      return ch
    end)
  end

  -- Block EventHandlers without isUpdating. Designer drops Boolean/Value
  -- faceplate commits while a suppressing/isUpdating flag is true.
  function muteHandlers(fn)
    handlerMuteDepth = handlerMuteDepth + 1
    okMute, errMute = pcall(fn)
    handlerMuteDepth = handlerMuteDepth - 1
    if handlerMuteDepth < 0 then
      handlerMuteDepth = 0
    end
    if not okMute then
      error(errMute)
    end
  end

  function handlersMuted()
    return handlerMuteDepth > 0
  end

  function beginFeedback(zoneIdx)
    feedbackUntil[zoneIdx] = Timer.Now() + 0.25
  end

  function isFeedback(zoneIdx)
    return Timer.Now() < (feedbackUntil[zoneIdx] or 0)
  end

  function beginUserHold(zoneIdx)
    -- Block fader EventHandler echo briefly after we write the fader from ACTUAL.
    userHoldUntil[zoneIdx] = Timer.Now() + 0.35
  end

  function isUserHold(zoneIdx)
    return Timer.Now() < (userHoldUntil[zoneIdx] or 0)
  end

  function beginPresetSync(zoneIdx)
    ignorePresetUntil[zoneIdx] = Timer.Now() + 0.2
  end

  function isPresetSync(zoneIdx)
    return Timer.Now() < (ignorePresetUntil[zoneIdx] or 0)
  end

  function trimText(s)
    s = tostring(s or "")
    s = string.gsub(s, "^%s+", "")
    s = string.gsub(s, "%s+$", "")
    return s
  end

  function clampLevel(value)
    n = tonumber(value)
    if not n then
      return 0
    end
    n = math.floor(n + 0.5)
    if n < 0 then
      return 0
    elseif n > MAX_LEVEL then
      return MAX_LEVEL
    end
    return n
  end

  -- Text-style Integer: faceplate edits String. Prefer String when present.
  function readLevelControl(ctl)
    s = trimText(ctl.String)
    n = tonumber(s)
    if n ~= nil then
      return clampLevel(n)
    end
    return clampLevel(ctl.Value)
  end

  function writeLevelControl(ctl, level)
    n = clampLevel(level)
    ctl.Value = n
    ctl.String = string.format("%d", n)
  end

  -- Match typical exam layout: high → low (e.g. 99, 75, 50, 25, 0).
  function defaultPresetLevel(presetIdx)
    if presetCount <= 1 then
      return 80
    end
    return clampLevel(MAX_LEVEL - (((presetIdx - 1) / (presetCount - 1)) * MAX_LEVEL))
  end

  function faderCtl(zoneIdx)
    return Controls.lightingFader[zoneIdx]
  end

  function actualCtl(zoneIdx)
    return Controls.actualLevel[zoneIdx]
  end

  function presetCtl(zoneIdx, presetIdx)
    return Controls.lightingPreset[presetFlatIndex(zoneIdx, presetIdx)]
  end

  function levelCtl(zoneIdx, presetIdx)
    return Controls.setLightLevels[presetFlatIndex(zoneIdx, presetIdx)]
  end

  -- Status Indicator: Value = state code, String = message.
  -- 0 OK, 2 Fault, 4 Missing, 5 Initializing.
  function setStatus(code, msg)
    msg = tostring(msg or "")
    if Controls.status then
      Controls.status.Value = code
      Controls.status.String = msg
    end
    if Controls.txtStatus then
      Controls.txtStatus.String = msg
    end
  end

  function currentIp()
    return trimText(Controls.txtIPAddress.String)
  end

  -- Text-style port field: prefer String (what the faceplate shows).
  function currentPort()
    port = tonumber(Controls.knbPort.String)
    if not port then
      port = tonumber(Controls.knbPort.Value)
    end
    return math.floor(port or 0)
  end

  function endpointLabel()
    return currentIp() .. ":" .. tostring(currentPort())
  end

  function looksLikeRecordInator(text)
    text = tostring(text or "")
    if string.find(text, "\x02", 1, true) or string.find(text, "\x03", 1, true) then
      return true
    end
    upper = string.upper(text)
    if string.find(upper, "NOPE", 1, true) then
      return true
    end
    if string.find(upper, "QPOW", 1, true) then
      return true
    end
    if string.find(upper, "SRY;", 1, true) then
      return true
    end
    return false
  end

  function applySlotVisibility()
    for zoneIdx = 1, MAX_ZONES do
      zoneUsed = zoneIdx <= zoneCount
      faderCtl(zoneIdx).IsInvisible = not zoneUsed
      actualCtl(zoneIdx).IsInvisible = not zoneUsed
      for presetIdx = 1, MAX_PRESETS do
        slotUsed = zoneUsed and presetIdx <= presetCount
        presetCtl(zoneIdx, presetIdx).IsInvisible = not slotUsed
        levelCtl(zoneIdx, presetIdx).IsInvisible = not slotUsed
      end
    end
  end

  lastConnectedUi = nil

  function setConnectedUi(connected)
    connected = connected and true or false
    Controls.ledConnected.Boolean = connected
    -- Only rewrite IsDisabled when link state changes (avoids wiping toggles every poll).
    if lastConnectedUi == connected then
      return
    end
    lastConnectedUi = connected
    for zoneIdx = 1, zoneCount do
      faderCtl(zoneIdx).IsDisabled = not connected
      for presetIdx = 1, presetCount do
        presetCtl(zoneIdx, presetIdx).IsDisabled = not connected
        levelCtl(zoneIdx, presetIdx).IsDisabled = false
      end
    end
  end

  function buildPresetArray(zoneIdx)
    arrayPresetLevels[zoneIdx] = arrayPresetLevels[zoneIdx] or {}
    for presetIdx = 1, presetCount do
      arrayPresetLevels[zoneIdx][presetIdx] = presetLevel(zoneIdx, presetIdx)
    end
  end

  function ensurePresetLevels(zoneIdx)
    for presetIdx = 1, presetCount do
      ctl = levelCtl(zoneIdx, presetIdx)
      s = trimText(ctl.String)
      -- Seed only when both String and Value are empty/unset.
      if s == "" and (tonumber(ctl.Value) == nil) then
        writeLevelControl(ctl, defaultPresetLevel(presetIdx))
      else
        -- Sync Value ↔ String from whichever the faceplate has.
        writeLevelControl(ctl, readLevelControl(ctl))
      end
    end
    buildPresetArray(zoneIdx)
  end

  function setPresetLabels(zoneIdx)
    for presetIdx = 1, presetCount do
      presetCtl(zoneIdx, presetIdx).Legend = string.format(
        "Preset %d  (%d)",
        presetIdx,
        presetLevel(zoneIdx, presetIdx)
      )
    end
  end

  function buttonInterlock(zoneIdx, presetIdx)
    selectedPreset[zoneIdx] = presetIdx or 0
    beginPresetSync(zoneIdx)
    muteHandlers(function()
      for idx = 1, presetCount do
        ctl = presetCtl(zoneIdx, idx)
        want = (idx == presetIdx)
        ctl.Boolean = false
        if want then
          ctl.Boolean = true
        end
      end
    end)
  end

  function latchPresetButtons(zoneIdx, presetIdx)
    buttonInterlock(zoneIdx, presetIdx)
    Timer.CallAfter(function()
      buttonInterlock(zoneIdx, selectedPreset[zoneIdx] or 0)
    end, 0)
  end

  function presetLevel(zoneIdx, presetIdx)
    return readLevelControl(levelCtl(zoneIdx, presetIdx))
  end

  function firstMatchingPreset(zoneIdx, level)
    buildPresetArray(zoneIdx)
    n = clampLevel(level)
    -- Prefer the highest preset index on ties so level 0 → last preset (5), not preset 1.
    matchIdx = 0
    for presetIdx = 1, presetCount do
      if arrayPresetLevels[zoneIdx][presetIdx] == n then
        matchIdx = presetIdx
      end
    end
    return matchIdx
  end

  function presetButtonsMatch(zoneIdx, presetIdx)
    for idx = 1, presetCount do
      if presetCtl(zoneIdx, idx).Boolean ~= (idx == presetIdx) then
        return false
      end
    end
    return true
  end

  -- Radio-lock preset *buttons* to ACTUAL. Match a right-hand preset
  -- level → that button on; no match → all off. Level knobs unchanged.
  function syncPresetsToActual(zoneIdx)
    n = clampLevel(actualCtl(zoneIdx).Value)
    matchIdx = firstMatchingPreset(zoneIdx, n)
    debugPrint(string.format("Zone %d ACTUAL=%d → preset match %d", zoneIdx, n, matchIdx))
    latchPresetButtons(zoneIdx, matchIdx)
  end

  -- Fader + preset *buttons* follow ACTUAL only.
  function applyControlsFromActual(zoneIdx)
    n = clampLevel(actualCtl(zoneIdx).Value)
    beginUserHold(zoneIdx)
    beginFeedback(zoneIdx)
    -- Lighting level (ACTUAL) → fader
    muteHandlers(function()
      faderCtl(zoneIdx).Value = n
    end)
    -- Lighting level (ACTUAL) → which preset button is latched
    syncPresetsToActual(zoneIdx)
    Timer.CallAfter(function()
      n2 = clampLevel(actualCtl(zoneIdx).Value)
      muteHandlers(function()
        faderCtl(zoneIdx).Value = n2
      end)
      syncPresetsToActual(zoneIdx)
    end, 0)
  end

  -- Write lighting level (ACTUAL); fader and presets update from that.
  function setActualLevel(zoneIdx, level)
    if zoneIdx < 1 or zoneIdx > zoneCount then
      return
    end
    n = clampLevel(level)
    muteHandlers(function()
      writeLevelControl(actualCtl(zoneIdx), n)
    end)
    applyControlsFromActual(zoneIdx)
    debugPrint(string.format("Zone %d lighting level ACTUAL=%d → fader/presets", zoneIdx, n))
    return n
  end

  -- User dragged fader: that value becomes lighting level (ACTUAL) → fader mirrors → SET.
  function sendLevel(zoneIdx, level, force)
    n = clampLevel(level)
    if not force and lastSentLevel[zoneIdx] == n then
      return
    end
    lastSentLevel[zoneIdx] = n
    setActualLevel(zoneIdx, n)
    if not sock.IsConnected then
      setStatus(STATUS_FAULT, "Not connected — ACTUAL updated, no TX")
      return
    end
    line = string.format("SET:Z%d:%02d%s", zoneIdx, n, EOL)
    sock:Write(line)
    debugPrint("TX", toPrintable(line))
    setStatus(STATUS_OK, string.format("OK - SET Z%d=%02d on %s", zoneIdx, n, endpointLabel()))
  end

  -- Preset button → preset's stored level → ACTUAL (lighting level) → fader.
  -- Does not write the fader directly.
  function pressPreset(zoneIdx, presetIdx)
    if zoneIdx < 1 or zoneIdx > zoneCount then
      return
    end
    if presetIdx < 1 or presetIdx > presetCount then
      return
    end
    n = presetLevel(zoneIdx, presetIdx)
    lastSentLevel[zoneIdx] = n
    -- Chain: preset setpoint → lighting level (ACTUAL) → fader + preset latch
    setActualLevel(zoneIdx, n)
    if sock.IsConnected then
      line = string.format("SET:Z%d:%02d%s", zoneIdx, n, EOL)
      sock:Write(line)
      debugPrint("TX", toPrintable(line))
      setStatus(
        STATUS_OK,
        string.format("OK - Preset %d → level %d → fader", presetIdx, n)
      )
    else
      setStatus(
        STATUS_FAULT,
        string.format("Preset %d → level %d (not connected)", presetIdx, n)
      )
    end
  end

  -- Device Zn@xx → ACTUAL → fader / presets.
  function applyLevelFromDevice(zoneIdx, level)
    if zoneIdx < 1 or zoneIdx > zoneCount then
      debugPrint(string.format("Ignoring out-of-range zone %s level %s", tostring(zoneIdx), tostring(level)))
      return
    end
    n = clampLevel(level)
    lastSentLevel[zoneIdx] = n
    setActualLevel(zoneIdx, n)
  end

  -- Keep-alive + feedback. Query Level is LVL:? and returns Zn@xx (PDF / UC).
  function currentPollSeconds()
    n = tonumber(Controls.knbPollSeconds.Value) or tonumber(Controls.knbPollSeconds.String)
    if not n then
      return DEFAULT_POLL_SECONDS
    end
    if n < MIN_POLL_SECONDS then
      return MIN_POLL_SECONDS
    elseif n > MAX_POLL_SECONDS then
      return MAX_POLL_SECONDS
    end
    return n
  end

  function pollLevel()
    -- Original UC: refresh disabled state every poll tick from IsConnected.
    connected = sock.IsConnected and true or false
    setConnectedUi(connected)
    if not connected then
      return
    end
    line = string.format("LVL:?%s", EOL)
    sock:Write(line)
    debugPrint("TX", toPrintable(line))
    pollsWithoutRx = pollsWithoutRx + 1
    -- Emulator may omit CR; drain buffer shortly after each poll.
    Timer.CallAfter(function()
      if sock.IsConnected then
        pcall(processRx)
      end
    end, 0.2)
    if pollsWithoutRx >= 2 and (lastRx == nil or lastRx == "") then
      setStatus(
        STATUS_OK,
        "OK - Connected " .. endpointLabel() .. " | TX LVL:? (waiting for Zn@xx)"
      )
    end
  end

  function startPolling()
    pollsWithoutRx = 0
    lastRx = ""
    rxBuf = ""
    pollTime:Stop()
    pollTime:Start(currentPollSeconds())
    if sock.IsConnected then
      pollLevel()
    end
    debugPrint("Polling every " .. tostring(currentPollSeconds()) .. "s")
  end

  function noteRx(text)
    lastRx = tostring(text or "")
    pollsWithoutRx = 0
    if looksLikeRecordInator(lastRx) then
      setStatus(
        STATUS_FAULT,
        "Wrong device on " .. endpointLabel() .. " (Record-Inator). Use port 5103"
      )
      return
    end
    if sock.IsConnected then
      setStatus(STATUS_OK, "OK - RX " .. toPrintable(lastRx))
    end
  end

  function parseLevelMessage(text)
    text = tostring(text or "")
    hits = {}
    seen = {}
    for zoneStr, levelStr in string.gmatch(string.upper(text), "Z(%d+)@(%d+)") do
      z = tonumber(zoneStr)
      if z and not seen[z] then
        table.insert(hits, { zone = z, level = tonumber(levelStr) })
        seen[z] = true
      end
    end
    -- Original UC fixed-offset extract when Z3@ is present but digits are odd.
    if not seen[3] and string.find(text, "Z3@", 1, true) then
      level = tonumber(string.match(text, "Z3@(%d+)")) or tonumber(string.sub(text, -8, -7))
      if level then
        table.insert(hits, { zone = 3, level = level })
      end
    end
    return hits
  end

  function consumeLevelReplies(text)
    hits = parseLevelMessage(text)
    if #hits == 0 then
      return false
    end
    for _, hit in ipairs(hits) do
      okApply, errApply = pcall(function()
        applyLevelFromDevice(hit.zone, hit.level)
      end)
      if not okApply then
        debugPrint("applyLevelFromDevice error", errApply)
      end
    end
    return true
  end

  function handleChunk(text)
    text = tostring(text or "")
    if text == "" then
      return
    end
    debugPrint("RX", toPrintable(text))
    noteRx(text)
    if looksLikeRecordInator(text) then
      return
    end
    if not consumeLevelReplies(text) then
      debugPrint("RX unmatched", toPrintable(text))
    end
  end

  -- Original UC uses ReadLine(Custom, CR). Also drain raw buffer / Any EOL
  -- so a silent wait is not caused by a missing CR on Zn@xx.
  function processRx()
    message = sock:ReadLine(TcpSocket.EOL.Custom, EOL)
    while message ~= nil do
      handleChunk(message)
      message = sock:ReadLine(TcpSocket.EOL.Custom, EOL)
    end

    message = sock:ReadLine(TcpSocket.EOL.Any)
    while message ~= nil do
      handleChunk(message)
      message = sock:ReadLine(TcpSocket.EOL.Any)
    end

    nBuf = sock.BufferLength or 0
    if nBuf > 0 then
      chunk = sock:Read(nBuf)
      if chunk and chunk ~= "" then
        rxBuf = rxBuf .. chunk
      end
    end
    if rxBuf == "" then
      return
    end
    work = rxBuf
    rxBuf = ""
    pos = 1
    split = false
    while true do
      a, b = string.find(work, "[\r\n]+", pos)
      if not a then
        break
      end
      split = true
      line = string.sub(work, pos, a - 1)
      if line ~= "" then
        handleChunk(line)
      end
      pos = b + 1
    end
    rest = string.sub(work, pos)
    if rest ~= "" then
      if string.find(string.upper(rest), "Z%d+@%d+") or string.find(rest, "Z3@", 1, true) then
        handleChunk(rest)
      elseif split then
        rxBuf = rest
      else
        handleChunk(rest)
      end
    end
  end

  function connectSocket()
    ip = currentIp()
    port = currentPort()
    suppressConfigHandlers = true
    if port >= 1 and port <= 65535 then
      Controls.knbPort.Value = port
      Controls.knbPort.String = tostring(port)
    end
    suppressConfigHandlers = false

    pollTime:Stop()
    lastRx = ""
    pollsWithoutRx = 0
    intentionalDisconnect = true
    pcall(function()
      sock:Disconnect()
    end)
    intentionalDisconnect = false

    if ip == "" then
      setConnectedUi(false)
      setStatus(STATUS_FAULT, "Enter an IP address")
      return
    end
    if port < 1 or port > 65535 then
      setConnectedUi(false)
      setStatus(STATUS_FAULT, "Invalid port")
      return
    end
    if port == 5201 then
      setConnectedUi(false)
      setStatus(STATUS_FAULT, "Port 5201 is Record-Inator. Use 5103 for lighting")
      return
    end

    setConnectedUi(false)
    setStatus(STATUS_INIT, "Connecting " .. endpointLabel())
    success, err = pcall(function()
      sock:Connect(ip, port)
    end)
    if not success then
      setStatus(STATUS_FAULT, tostring(err))
      return
    end
    if sock.IsConnected then
      setConnectedUi(true)
      setStatus(STATUS_OK, "OK - Connected " .. endpointLabel())
      startPolling()
    end
  end

  -- Match original UC: discrete socket callbacks (not EventHandler).
  sock.Connected = function()
    debugPrint("TCP connected", endpointLabel())
    setStatus(STATUS_OK, "OK - Connected " .. endpointLabel())
    setConnectedUi(true)
    startPolling()
  end

  sock.Reconnect = function()
    if intentionalDisconnect then
      return
    end
    debugPrint("TCP reconnecting")
    setStatus(STATUS_INIT, "Reconnecting " .. endpointLabel())
    setConnectedUi(false)
  end

  sock.Data = function()
    okRx, errRx = pcall(processRx)
    if not okRx then
      debugPrint("RX error", errRx)
    end
  end

  sock.Closed = function()
    if intentionalDisconnect then
      return
    end
    debugPrint("TCP closed")
    setConnectedUi(false)
    setStatus(STATUS_FAULT, "Closed " .. endpointLabel())
  end

  sock.Error = function(sockObj, err)
    if intentionalDisconnect then
      return
    end
    debugPrint("TCP error", err)
    setConnectedUi(false)
    setStatus(STATUS_FAULT, tostring(err or "Socket error"))
  end

  sock.Timeout = function(sockObj, err)
    if intentionalDisconnect then
      return
    end
    debugPrint("TCP timeout", err)
    setConnectedUi(false)
    setStatus(STATUS_FAULT, "Timeout " .. endpointLabel())
  end

  pollTime.EventHandler = function()
    pollLevel()
  end

  function bindFader(zoneIdx)
    faderCtl(zoneIdx).EventHandler = function()
      if handlersMuted() or isFeedback(zoneIdx) or isUserHold(zoneIdx) then
        return
      end
      -- User setpoint → ACTUAL (controls follow ACTUAL) → SET.
      sendLevel(zoneIdx, faderCtl(zoneIdx).Value, true)
    end
  end

  function bindActual(zoneIdx)
    actualCtl(zoneIdx).EventHandler = function()
      if handlersMuted() then
        return
      end
      applyControlsFromActual(zoneIdx)
    end
  end

  function bindPreset(zoneIdx, presetIdx)
    presetCtl(zoneIdx, presetIdx).EventHandler = function()
      if handlersMuted() or isPresetSync(zoneIdx) then
        return
      end
      pressPreset(zoneIdx, presetIdx)
    end
    levelCtl(zoneIdx, presetIdx).EventHandler = function()
      if handlersMuted() then
        return
      end
      -- Keep Value in sync with the Text faceplate, then re-match ACTUAL.
      writeLevelControl(levelCtl(zoneIdx, presetIdx), readLevelControl(levelCtl(zoneIdx, presetIdx)))
      buildPresetArray(zoneIdx)
      setPresetLabels(zoneIdx)
      syncPresetsToActual(zoneIdx)
    end
  end

  function setup()
    suppressConfigHandlers = true
    if Controls.txtIPAddress.String == "" then
      Controls.txtIPAddress.String = Properties["Default IP"].Value
    end
    if not Controls.knbPort.Value or Controls.knbPort.Value < 1 then
      Controls.knbPort.Value = Properties["Default Port"].Value or DEFAULT_PORT
    end
    Controls.knbPort.String = tostring(math.floor(tonumber(Controls.knbPort.Value) or DEFAULT_PORT))
    if not Controls.knbPollSeconds.Value or Controls.knbPollSeconds.Value < MIN_POLL_SECONDS then
      Controls.knbPollSeconds.Value = Properties["Poll Seconds"].Value or DEFAULT_POLL_SECONDS
    end
    suppressConfigHandlers = false

    applySlotVisibility()
    for zoneIdx = 1, zoneCount do
      selectedPreset[zoneIdx] = 0
      userHoldUntil[zoneIdx] = 0
      lastSentLevel[zoneIdx] = nil
      ensurePresetLevels(zoneIdx)
      setPresetLabels(zoneIdx)
      muteHandlers(function()
        writeLevelControl(actualCtl(zoneIdx), 0)
      end)
      applyControlsFromActual(zoneIdx)
      bindFader(zoneIdx)
      bindActual(zoneIdx)
      for presetIdx = 1, presetCount do
        bindPreset(zoneIdx, presetIdx)
      end
    end

    setConnectedUi(false)
    setStatus(STATUS_MISSING, "Meh Lighting System v" .. PluginInfo.Version)

    Controls.txtIPAddress.EventHandler = function()
      if suppressConfigHandlers then
        return
      end
      connectSocket()
    end
    Controls.knbPort.EventHandler = function()
      if suppressConfigHandlers then
        return
      end
      connectSocket()
    end
    Controls.knbPollSeconds.EventHandler = function()
      if suppressConfigHandlers then
        return
      end
      startPolling()
    end

    if Properties["page_index"] then
      Properties["page_index"].EventHandler = function()
        zoneIdx = zoneIndexFromPageName(pageNameFromIndex(Properties))
        if zoneIdx then
          setPresetLabels(zoneIdx)
        end
      end
    end

    -- Original UC starts the poll timer at script load; Connected also refreshes it.
    startPolling()
    connectSocket()
  end

  success, err = pcall(setup)
  if not success then
    print("Script error: " .. tostring(err))
    setStatus(STATUS_FAULT, "Script error: " .. tostring(err))
  end
end
