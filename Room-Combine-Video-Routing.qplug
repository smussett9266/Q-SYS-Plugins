MAX_ROOMS = 8
MAX_LOCAL_SOURCES = 4
MAX_OUTPUTS_PER_ROOM = 4
MAX_GLOBAL_SOURCES = 8
LOCAL_SLOT_COUNT = MAX_ROOMS * MAX_LOCAL_SOURCES
TOTAL_SOURCE_SLOTS = LOCAL_SLOT_COUNT + MAX_GLOBAL_SOURCES

DEFAULT_ROOM_COUNT = 3
DEFAULT_SOURCES_PER_ROOM = 2
DEFAULT_OUTPUTS_PER_ROOM = 2
DEFAULT_GLOBAL_SOURCE_COUNT = 3

PAGE_SETUP = "Setup"
PAGE_GLOBAL = "Global Sources"

---------------------------------------------------------------------------
-- Design-time setup (runs when dragged / properties change / Designer reload)
-- PluginInfo, GetProperties, RectifyProperties, GetPages, GetControls,
-- GetControlLayout. Control-code changes apply on recompile; Setup changes
-- need re-drag (or Designer reload) on existing schematic instances.
---------------------------------------------------------------------------

function GetColor(props)
  return { 1, 102, 255 }
end

function GetPrettyName(props)
  return string.format(
    "Room Combine Video Routing v%s (%d rooms)",
    PluginInfo.Version,
    props["Room Count"].Value
  )
end

UI = {
  bg = { 51, 51, 51 },
  panel = { 51, 51, 51 },
  card = { 51, 51, 51 },
  cardAlt = { 51, 51, 51 },
  stroke = { 255, 255, 255 },
  controlStroke = { 198, 198, 206 },
  cyan = { 27, 212, 219 },
  headerLabel = { 220, 220, 228 },
  text = { 220, 220, 228 },
  muted = { 168, 168, 176 },
  textDark = { 20, 20, 24 },
  btnOn = { 1, 102, 255 },
  btnOff = { 90, 90, 98 },
  btnSelOn = { 255, 255, 255 },
  btnSelOff = { 90, 90, 98 },
  fieldGrid = { 245, 245, 248 },
  fieldSummary = { 245, 245, 248 },
  fieldOut = { 245, 245, 248 },
}

function clampInt(value, minVal, maxVal)
  n = math.floor((tonumber(value) or minVal) + 0.5)
  if n < minVal then n = minVal end
  if n > maxVal then n = maxVal end
  return n
end

-- Slot model ---------------------------------------------------------------
-- Two different numbers describe a source and they must never be conflated.
--
-- Control slot, 1..TOTAL_SOURCE_SLOTS: fixed-stride identity used for array
-- indexes. Local sources keep MAX_LOCAL_SOURCES per room; globals sit above
-- LOCAL_SLOT_COUNT. Room 2 Src 1 is always slot 5 even when Sources Per Room
-- is 2. Everything in this plugin that talks about a "slot" means this.
--
-- Dense AV number, 1..(RoomCount*SourcesPerRoom + GlobalCount): the default
-- OutputStrings value. Packed from the active properties with no gaps, so
-- with 2 rooms / 2 sources / 2 globals, Room 2 Src 1 is "AV 3" (or "3" in
-- Number mode) and Global 1 is "AV 5" (or "5"). Format is controlled by
-- setupOutputStringFormat on the Setup tab.

-- Control-slot index of a room's local source. Fixed stride, always.
function localSlotIndex(roomIdx, localIdx)
  return ((roomIdx - 1) * MAX_LOCAL_SOURCES) + localIdx
end

-- Control-slot index of a global source. Always above the local block.
function globalSlotIndex(globalIdx)
  return LOCAL_SLOT_COUNT + globalIdx
end

function slotIsGlobal(slot)
  return slot > LOCAL_SLOT_COUNT
end

function slotGlobalIndex(slot)
  return slot - LOCAL_SLOT_COUNT
end

function slotRoomIndex(slot)
  return math.floor((slot - 1) / MAX_LOCAL_SOURCES) + 1
end

function slotLocalIndex(slot)
  return ((slot - 1) % MAX_LOCAL_SOURCES) + 1
end

-- setupOutputStringFormat (Setup toggle): true = Name ("AV N"), false = Number
-- ("N"). Product default is Name. Design-time / missing control → Name.
function outputStringUsesAvPrefix()
  if Controls and Controls.setupOutputStringFormat ~= nil then
    return Controls.setupOutputStringFormat.Boolean == true
  end
  return true
end

-- Dense OutputStrings default from the active Room / Sources / Global counts.
-- Returns "" for slots outside the active property slice.
-- Format follows setupOutputStringFormat (Name "AV N" vs Number "N").
function defaultOutputStringForSlot(slot)
  dense = denseSlotIndex(slot)
  if dense == nil then
    return ""
  end
  if outputStringUsesAvPrefix() then
    return "AV " .. dense
  end
  return tostring(dense)
end

function avStringForSlot(slot)
  return defaultOutputStringForSlot(slot)
end

-- Auto OutputString: blank, "AV N", or plain dense "N". Custom names stick.
function isAutoAvOutputString(text)
  text = tostring(text or "")
  text = string.match(text, "^%s*(.-)%s*$") or ""
  if text == "" then return true end
  if string.match(text, "^AV %d+$") ~= nil then return true end
  if string.match(text, "^%d+$") ~= nil then return true end
  return false
end

function defaultLabelForSlot(slot)
  if slotIsGlobal(slot) then
    return "Global " .. slotGlobalIndex(slot)
  end
  return "Rm " .. slotRoomIndex(slot) .. " Src " .. slotLocalIndex(slot)
end

-- Blank / nil / stock "Rm # Src #" / "Global #" are all treated as auto so
-- Designer placeholders cannot block default population. Custom names stick.
function isAutoLabelString(text)
  text = tostring(text or "")
  text = string.match(text, "^%s*(.-)%s*$") or ""
  if text == "" then return true end
  if string.match(text, "^Rm %d+ Src %d+$") then return true end
  if string.match(text, "^Global %d+$") then return true end
  return false
end

-- Design-time combo seeds: own-room sources from Sources Per Room, and the
-- Global Sources tab list from Global Source Count. Runtime rebuilds these
-- from the live pool (Visibility / Global / combiner) as soon as script runs.
function designTimeRoomChoices(viewRoomIdx, sourcesPerRoom)
  choices = {}
  for localIdx = 1, sourcesPerRoom do
    table.insert(choices, defaultLabelForSlot(localSlotIndex(viewRoomIdx, localIdx)))
  end
  return choices
end

function designTimeGlobalChoices(globalCount)
  choices = {}
  for globalIdx = 1, globalCount do
    table.insert(choices, defaultLabelForSlot(globalSlotIndex(globalIdx)))
  end
  return choices
end

-- Row order for a room tab: the viewing room's own sources first, then the
-- remaining rooms in ascending order. Globals are appended separately so they
-- always land last. Shared by the layout and the runtime so the row a slot
-- occupies never drifts between them.
function orderedLocalSlots(viewRoomIdx, roomCount, sourcesPerRoom)
  slots = {}
  for localIdx = 1, sourcesPerRoom do
    table.insert(slots, localSlotIndex(viewRoomIdx, localIdx))
  end
  for srcRoomIdx = 1, roomCount do
    if srcRoomIdx ~= viewRoomIdx then
      for localIdx = 1, sourcesPerRoom do
        table.insert(slots, localSlotIndex(srcRoomIdx, localIdx))
      end
    end
  end
  return slots
end

-- Active dimensions --------------------------------------------------------
-- Design time reads the props table Designer passes to GetControls and
-- GetControlLayout, the runtime reads the Properties table. Both funnel
-- through setActiveDimensions, because a dense index that meant one thing in
-- the layout and another at run time would point every control at the wrong
-- source.

ACTIVE_ROOM_COUNT = DEFAULT_ROOM_COUNT
ACTIVE_SOURCES_PER_ROOM = DEFAULT_SOURCES_PER_ROOM
ACTIVE_OUTPUTS_PER_ROOM = DEFAULT_OUTPUTS_PER_ROOM
ACTIVE_GLOBAL_COUNT = DEFAULT_GLOBAL_SOURCE_COUNT
ACTIVE_SLOTS_PER_COLUMN = 0
ACTIVE_SLOT_LIST = {}

-- The AV numbers one output column carries, in dense order. Rebuilt only when
-- the dimensions change so the sync loops can walk it directly. The
-- accumulator name is deliberately unlike anything a callee here builds into.
function buildActiveSlotList()
  avList = {}
  for roomIdx = 1, ACTIVE_ROOM_COUNT do
    for localIdx = 1, ACTIVE_SOURCES_PER_ROOM do
      table.insert(avList, localSlotIndex(roomIdx, localIdx))
    end
  end
  for globalIdx = 1, ACTIVE_GLOBAL_COUNT do
    table.insert(avList, globalSlotIndex(globalIdx))
  end
  return avList
end

function setActiveDimensions(roomCountIn, sourcesPerRoomIn, outputsPerRoomIn, globalCountIn)
  ACTIVE_ROOM_COUNT = clampInt(roomCountIn, 2, MAX_ROOMS)
  ACTIVE_SOURCES_PER_ROOM = clampInt(sourcesPerRoomIn, 1, MAX_LOCAL_SOURCES)
  ACTIVE_OUTPUTS_PER_ROOM = clampInt(outputsPerRoomIn, 1, MAX_OUTPUTS_PER_ROOM)
  ACTIVE_GLOBAL_COUNT = clampInt(globalCountIn, 0, MAX_GLOBAL_SOURCES)
  ACTIVE_SLOTS_PER_COLUMN = (ACTIVE_ROOM_COUNT * ACTIVE_SOURCES_PER_ROOM) + ACTIVE_GLOBAL_COUNT
  ACTIVE_SLOT_LIST = buildActiveSlotList()
  return ACTIVE_SLOTS_PER_COLUMN
end

-- The one derivation path. Works on either table because Designer's props and
-- the runtime's Properties expose the same Name -> { Value } shape.
function applyActiveDimensions(props)
  return setActiveDimensions(
    propertyRoomCount(props),
    propertySourcesPerRoom(props),
    propertyOutputsPerRoom(props),
    propertyGlobalSourceCount(props)
  )
end

function activeOutputCount()
  return ACTIVE_ROOM_COUNT * ACTIVE_OUTPUTS_PER_ROOM
end

-- Select buttons: rooms x outs x AV slots (per-room; not page-virtualized).
function activeSelectSlotCount()
  return ACTIVE_ROOM_COUNT * ACTIVE_OUTPUTS_PER_ROOM * ACTIVE_SLOTS_PER_COLUMN
end

-- Shared Labels / OutputStrings: one entry per active AV slot.
function activeSharedSlotCount()
  return ACTIVE_SLOTS_PER_COLUMN
end

-- Legacy name used by older call sites / harness notes.
function activeSourceSlotCount()
  return activeSelectSlotCount()
end

setActiveDimensions(
  DEFAULT_ROOM_COUNT,
  DEFAULT_SOURCES_PER_ROOM,
  DEFAULT_OUTPUTS_PER_ROOM,
  DEFAULT_GLOBAL_SOURCE_COUNT
)

-- AV number <-> dense storage index ----------------------------------------

function denseLocalSlotIndex(roomIdx, localIdx)
  return ((roomIdx - 1) * ACTIVE_SOURCES_PER_ROOM) + localIdx
end

function denseGlobalSlotIndex(globalIdx)
  return (ACTIVE_ROOM_COUNT * ACTIVE_SOURCES_PER_ROOM) + globalIdx
end

-- nil means the AV number is outside the active configuration, so no control
-- was ever declared for it and the caller must skip it.
function denseSlotIndex(avSlot)
  if avSlot == nil then return nil end
  if slotIsGlobal(avSlot) then
    denseGlobalIdx = slotGlobalIndex(avSlot)
    if denseGlobalIdx < 1 or denseGlobalIdx > ACTIVE_GLOBAL_COUNT then return nil end
    return denseGlobalSlotIndex(denseGlobalIdx)
  end
  denseRoomIdx = slotRoomIndex(avSlot)
  denseLocalIdx = slotLocalIndex(avSlot)
  if denseRoomIdx < 1 or denseRoomIdx > ACTIVE_ROOM_COUNT then return nil end
  if denseLocalIdx < 1 or denseLocalIdx > ACTIVE_SOURCES_PER_ROOM then return nil end
  return denseLocalSlotIndex(denseRoomIdx, denseLocalIdx)
end

function avNumberForDenseIndex(denseIdx)
  return ACTIVE_SLOT_LIST[denseIdx]
end

-- Flat control indexes -----------------------------------------------------
-- Three index spaces (never mix them):
--   outputFlatIndex  = ((room-1)*outs) + out          → Combo / Output pin
--   selectIndex      = denseAv                        → index within that output's Select bank
--   sharedSlotIndex  = denseSlotIndex(avSlot)         → Label / OutputString
-- Q-SYS Count max is 256. Selects are one array per dest/out/source-room.
-- selectFlatIndex / slotFlatIndex are aliases of selectIndex (older call sites).

-- One Select array per dest/output/source-room, plus one Global array.
--   rm#Out#Rm#Src  Count = Sources Per Room → key rm#Out#Rm#Src#
--   rm#Out#Global  Count = Global Source Count → key rm#Out#Global#
-- Q-SYS treats a trailing digit as an array index, so rm2Out2Global3 is
-- rm2Out2Global[3]. PrettyName stays "Room N Output M <label>".
function selectBankName(roomIdx, outIdx, avSlot)
  roomIdx = tonumber(roomIdx)
  outIdx = tonumber(outIdx)
  if roomIdx == nil or outIdx == nil or avSlot == nil then return nil end
  if roomIdx < 1 or roomIdx > MAX_ROOMS then return nil end
  if outIdx < 1 or outIdx > MAX_OUTPUTS_PER_ROOM then return nil end
  if slotIsGlobal(avSlot) then
    return "rm" .. roomIdx .. "Out" .. outIdx .. "Global"
  end
  srcRoom = slotRoomIndex(avSlot)
  if srcRoom < 1 or srcRoom > MAX_ROOMS then return nil end
  return "rm" .. roomIdx .. "Out" .. outIdx .. "Rm" .. srcRoom .. "Src"
end

function selectCtlIndex(avSlot)
  if avSlot == nil then return nil end
  if slotIsGlobal(avSlot) then
    gIdx = slotGlobalIndex(avSlot)
    if gIdx < 1 or gIdx > MAX_GLOBAL_SOURCES then return nil end
    return gIdx
  end
  srcLocal = slotLocalIndex(avSlot)
  if srcLocal < 1 or srcLocal > MAX_LOCAL_SOURCES then return nil end
  return srcLocal
end

function selectCtlName(roomIdx, outIdx, avSlot)
  bank = selectBankName(roomIdx, outIdx, avSlot)
  idx = selectCtlIndex(avSlot)
  if bank == nil or idx == nil then return nil end
  return bank .. idx
end

function comboCtlName(roomIdx, outIdx)
  roomIdx = tonumber(roomIdx)
  outIdx = tonumber(outIdx)
  if roomIdx == nil or outIdx == nil then return nil end
  if roomIdx < 1 or roomIdx > MAX_ROOMS then return nil end
  if outIdx < 1 or outIdx > MAX_OUTPUTS_PER_ROOM then return nil end
  return "comboBoxRm" .. roomIdx .. "Out" .. outIdx
end

function roomOutputMirrorCtlName(roomIdx, outIdx)
  roomIdx = tonumber(roomIdx)
  outIdx = tonumber(outIdx)
  if roomIdx == nil or outIdx == nil then return nil end
  if roomIdx < 1 or roomIdx > MAX_ROOMS then return nil end
  if outIdx < 1 or outIdx > MAX_OUTPUTS_PER_ROOM then return nil end
  return "rm" .. roomIdx .. "Out" .. outIdx .. "Mirror"
end

function outputCtlName(roomIdx, outIdx)
  roomIdx = tonumber(roomIdx)
  outIdx = tonumber(outIdx)
  if roomIdx == nil or outIdx == nil then return nil end
  if roomIdx < 1 or roomIdx > MAX_ROOMS then return nil end
  if outIdx < 1 or outIdx > MAX_OUTPUTS_PER_ROOM then return nil end
  return "outputRm" .. roomIdx .. "Out" .. outIdx
end

function namedRoomOutCtl(stem, roomIdx, outIdx)
  if Controls == nil then return nil end
  roomIdx = tonumber(roomIdx)
  outIdx = tonumber(outIdx)
  if roomIdx == nil or outIdx == nil then return nil end
  name = stem .. "Rm" .. roomIdx .. "Out" .. outIdx
  named = safeIndex(Controls, name)
  if named ~= nil then return named end
  return indexedControl(safeIndex(Controls, stem .. "Rm" .. roomIdx .. "Out"), outIdx)
end

function comboCtl(roomIdx, outIdx)
  if comboCtlName(roomIdx, outIdx) == nil then return nil end
  return namedRoomOutCtl("comboBox", roomIdx, outIdx)
end

function outputPinCtl(roomIdx, outIdx)
  if outputCtlName(roomIdx, outIdx) == nil then return nil end
  return namedRoomOutCtl("output", roomIdx, outIdx)
end

function outputFlatIndex(roomIdx, outIdx)
  if roomIdx < 1 or roomIdx > ACTIVE_ROOM_COUNT then return nil end
  if outIdx < 1 or outIdx > ACTIVE_OUTPUTS_PER_ROOM then return nil end
  return ((roomIdx - 1) * ACTIVE_OUTPUTS_PER_ROOM) + outIdx
end

function outputPinFlatIndex(roomIdx, outIdx)
  return outputFlatIndex(roomIdx, outIdx)
end

function activeOutputPinCount()
  return ACTIVE_ROOM_COUNT * ACTIVE_OUTPUTS_PER_ROOM
end

function sharedSlotIndex(avSlot)
  return denseSlotIndex(avSlot)
end

-- Source Labels: one array per room (rm#OutSourceLabels, Count = Sources
-- Per Room) plus globalOutSourceLabels (Count = Global Source Count).
-- Index is the local/global source number, not the dense AV slot.
-- PrettyName is Rm N Src M Label / Global N Label.
function sourceLabelCtlName(avSlot)
  if avSlot == nil then return nil end
  if slotIsGlobal(avSlot) then
    return "globalOutSourceLabels"
  end
  roomIdx = slotRoomIndex(avSlot)
  if roomIdx < 1 or roomIdx > MAX_ROOMS then return nil end
  return "rm" .. roomIdx .. "OutSourceLabels"
end

function sourceLabelCtlIndex(avSlot)
  if avSlot == nil then return nil end
  if slotIsGlobal(avSlot) then
    return slotGlobalIndex(avSlot)
  end
  return slotLocalIndex(avSlot)
end

function sourceLabelLayoutKey(avSlot)
  name = sourceLabelCtlName(avSlot)
  idx = sourceLabelCtlIndex(avSlot)
  if name == nil or idx == nil then return nil end
  if slotIsGlobal(avSlot) then
    gCount = ACTIVE_GLOBAL_COUNT
    if gCount < 1 then gCount = 1 end
    return indexedLayoutKey(name, idx, gCount)
  end
  return indexedLayoutKey(name, idx, ACTIVE_SOURCES_PER_ROOM)
end

function numberedCtlFrom(controls, stem, idx)
  if controls == nil or stem == nil or idx == nil then return nil end
  compact = stem .. idx
  compactCtl = safeIndex(controls, compact)
  if compactCtl ~= nil then return compactCtl end
  return indexedControl(safeIndex(controls, stem), idx)
end

function bindNumberedBank(stem, count)
  bank = {}
  n = count
  if n == nil or n < 1 then n = 1 end
  for i = 1, n do
    bank[i] = numberedCtlFrom(Controls, stem, i)
  end
  return bank
end

function sourceLabelCtlFrom(controls, avSlot)
  if controls == nil then return nil end
  name = sourceLabelCtlName(avSlot)
  idx = sourceLabelCtlIndex(avSlot)
  if name == nil or idx == nil then return nil end
  return numberedCtlFrom(controls, name, idx)
end

-- Per-output Select index (1 .. AV). Each bank is one column.
function selectIndex(outIdx, slot)
  return denseSlotIndex(slot)
end

function selectFlatIndex(roomIdx, outIdx, avSlot)
  if roomIdx < 1 or roomIdx > MAX_ROOMS then return nil end
  if outIdx < 1 or outIdx > ACTIVE_OUTPUTS_PER_ROOM then return nil end
  return selectIndex(outIdx, avSlot)
end

function slotFlatIndex(roomIdx, outIdx, avSlot)
  return selectFlatIndex(roomIdx, outIdx, avSlot)
end

function selectLayoutKey(roomIdx, outIdx, avSlot)
  bank = selectBankName(roomIdx, outIdx, avSlot)
  idx = selectCtlIndex(avSlot)
  if bank == nil or idx == nil then return nil end
  if slotIsGlobal(avSlot) then
    return indexedLayoutKey(bank, idx, ACTIVE_GLOBAL_COUNT)
  end
  return indexedLayoutKey(bank, idx, ACTIVE_SOURCES_PER_ROOM)
end

function selectCtl(roomIdx, outIdx, avSlot)
  if Controls == nil then return nil end
  idx = selectCtlIndex(avSlot)
  bankName = selectBankName(roomIdx, outIdx, avSlot)
  if bankName == nil or idx == nil then return nil end
  compact = selectCtlName(roomIdx, outIdx, avSlot)
  compactCtl = compact and safeIndex(Controls, compact)
  if compactCtl ~= nil then return compactCtl end
  return indexedControl(safeIndex(Controls, bankName), idx)
end

function setupSrcSelCtl(sharedIdx)
  if Controls == nil or sharedIdx == nil then return nil end
  return numberedCtlFrom(Controls, "setupSrcSel", sharedIdx)
end

-- Count=1 is a scalar (userdata in Designer); Count>1 is an array.
-- Never index a scalar: Designer throws and greys every plugin control.
function safeIndex(tbl, key)
  if tbl == nil or key == nil then return nil end
  okIdx, val = pcall(function()
    return tbl[key]
  end)
  if okIdx then return val end
  return nil
end

function indexedControl(bank, idx)
  if bank == nil or idx == nil then return nil end
  item = safeIndex(bank, idx)
  if item ~= nil then return item end
  if idx == 1 then return bank end
  return nil
end

function indexedLayoutKey(name, idx, count)
  if name == nil or idx == nil then return name end
  if count == nil or count <= 1 then return name end
  return name .. " " .. idx
end

-- Pretty names -------------------------------------------------------------
-- Designer nests schematic pins on '~' in PrettyName (same as Power Controls).

function ucPropertyName(suffix)
  return "Properties~" .. suffix
end

function ucRoomOutName(roomIdx, outIdx, suffix)
  return "Room " .. roomIdx .. " Output " .. outIdx .. " " .. suffix
end

function ucComboPrettyName(roomIdx, outIdx)
  return "Room " .. roomIdx .. " Output " .. outIdx .. " Source Combo"
end

function ucOutputPrettyName(roomIdx, outIdx)
  return ucRoomOutName(roomIdx, outIdx, "Output")
end

function ucSelectPinName(roomIdx, outIdx, avSlot)
  return "Room " .. roomIdx .. " Output " .. outIdx .. " " .. defaultLabelForSlot(avSlot)
end

function ucRoomOptionName(roomIdx, suffix)
  return "Room " .. roomIdx .. " " .. suffix
end

function ucRoomOutputMirrorName(roomIdx, outIdx)
  return "Room " .. roomIdx .. " Output " .. outIdx .. " Mirror"
end

function ucSetupOutputMirrorName(outIdx)
  return "setupMirrorOut" .. outIdx
end

function ucRoomOutputGlobalName(roomIdx, outIdx)
  return "Room " .. roomIdx .. " Output " .. outIdx .. " Show Globals"
end

function ucSetupOutputGlobalName(outIdx)
  return "setupGlobalOut" .. outIdx
end

-- Unpinned Global tab controls: plain PrettyNames (no Global Sources~ pin folder).
function ucGlobalOutputName(globalIdx)
  return "globalOutput" .. globalIdx
end

function ucGlobalSelectName(globalIdx)
  return "globalSourceControls" .. globalIdx
end

function ucSourceLabelPrettyName(avSlot)
  return defaultLabelForSlot(avSlot) .. " Label"
end

-- Properties ---------------------------------------------------------------

function propertyRoomCount(props)
  if props and props["Room Count"] then
    return clampInt(props["Room Count"].Value, 2, MAX_ROOMS)
  end
  return DEFAULT_ROOM_COUNT
end

function propertySourcesPerRoom(props)
  if props and props["Sources Per Room"] then
    return clampInt(props["Sources Per Room"].Value, 1, MAX_LOCAL_SOURCES)
  end
  return DEFAULT_SOURCES_PER_ROOM
end

function propertyOutputsPerRoom(props)
  if props and props["Outputs Per Room"] then
    return clampInt(props["Outputs Per Room"].Value, 1, MAX_OUTPUTS_PER_ROOM)
  end
  return DEFAULT_OUTPUTS_PER_ROOM
end

function propertyGlobalSourceCount(props)
  if props and props["Global Source Count"] then
    return clampInt(props["Global Source Count"].Value, 0, MAX_GLOBAL_SOURCES)
  end
  return DEFAULT_GLOBAL_SOURCE_COUNT
end

function GetProperties()
  props = {}
  table.insert(props, {
    Name = "Room Count",
    Type = "integer",
    Min = 2,
    Max = MAX_ROOMS,
    Value = DEFAULT_ROOM_COUNT,
  })
  table.insert(props, {
    Name = "Sources Per Room",
    Type = "integer",
    Min = 1,
    Max = MAX_LOCAL_SOURCES,
    Value = DEFAULT_SOURCES_PER_ROOM,
  })
  table.insert(props, {
    Name = "Outputs Per Room",
    Type = "integer",
    Min = 1,
    Max = MAX_OUTPUTS_PER_ROOM,
    Value = DEFAULT_OUTPUTS_PER_ROOM,
  })
  table.insert(props, {
    Name = "Global Source Count",
    Type = "integer",
    Min = 0,
    Max = MAX_GLOBAL_SOURCES,
    Value = DEFAULT_GLOBAL_SOURCE_COUNT,
  })
  return props
end

function RectifyProperties(props)
  props["Room Count"].Value = clampInt(props["Room Count"].Value, 2, MAX_ROOMS)
  props["Sources Per Room"].Value = clampInt(props["Sources Per Room"].Value, 1, MAX_LOCAL_SOURCES)
  props["Outputs Per Room"].Value = clampInt(props["Outputs Per Room"].Value, 1, MAX_OUTPUTS_PER_ROOM)
  props["Global Source Count"].Value = clampInt(props["Global Source Count"].Value, 0, MAX_GLOBAL_SOURCES)
  return props
end

-- Pages --------------------------------------------------------------------
-- Shared list for GetPages / GetControlLayout / runtime page helpers.
-- page_index is 1-based: 1=Setup, 2=Global Sources, 3=Room 1, ...

function buildPageNameList(roomCount)
  names = { PAGE_SETUP, PAGE_GLOBAL }
  for roomIdx = 1, roomCount do
    table.insert(names, "Room " .. roomIdx)
  end
  return names
end

function GetPages(props)
  pages = {}
  for _, name in ipairs(buildPageNameList(propertyRoomCount(props))) do
    table.insert(pages, { name = name })
  end
  return pages
end

function pageNameFromIndex(props)
  names = buildPageNameList(propertyRoomCount(props))
  pageIdx = tonumber(props["page_index"] and props["page_index"].Value)
  if pageIdx == nil then return PAGE_SETUP end
  pageIdx = math.floor(pageIdx + 0.5)
  -- Out of range → Setup (do not clamp to last room; preserves prior behavior).
  if pageIdx < 1 or pageIdx > #names then return PAGE_SETUP end
  return names[pageIdx] or PAGE_SETUP
end

-- Returns nil when page_index is missing, 0, or otherwise unusable.
function resolvedPageIndex(pageIdx)
  pageIdx = tonumber(pageIdx)
  if pageIdx == nil then return nil end
  pageIdx = math.floor(pageIdx + 0.5)
  if pageIdx < 1 then return nil end
  return pageIdx
end

-- roomIdx for Room tabs, else nil (Setup / Global / unresolved).
function roomIndexFromPageIndex(pageIdx, roomCount)
  pageIdx = resolvedPageIndex(pageIdx)
  if pageIdx == nil then return nil end
  roomIdx = pageIdx - 2
  if roomIdx >= 1 and roomIdx <= roomCount then
    return roomIdx
  end
  return nil
end

-- Controls -----------------------------------------------------------------

-- Dense Counts follow properties (unused indices are omitted, not Style=None).
-- Selects: rm#Out#Rm#Src Count = Sources Per Room; rm#Out#Global Count =
-- Global Source Count (bank omitted at 0). Labels match those Counts.
-- OutputStrings: one shared copy per dense AV. Combos/Output pins: rooms x outs.
-- Every Count ≤ 256; total UserPin Count ≤ 256.
function GetControls(props)
  applyActiveDimensions(props)
  ctrls = {}
  outputSlots = activeOutputPinCount()
  globalPinCount = ACTIVE_GLOBAL_COUNT
  roomSlots = ACTIVE_ROOM_COUNT
  sharedSlots = activeSharedSlotCount()
  if sharedSlots < 1 then sharedSlots = 1 end

  table.insert(ctrls, { Name = "status", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })

  table.insert(ctrls, { Name = "propertiesRoomCount", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })
  table.insert(ctrls, { Name = "propertiesSourcesPerRoom", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })
  table.insert(ctrls, { Name = "propertiesOutputsPerRoom", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })
  table.insert(ctrls, { Name = "propertiesGlobalSourceCount", ControlType = "Text", Count = 1, UserPin = true, PinStyle = "Output" })

  table.insert(ctrls, {
    Name = "setupRoomCombiner",
    ControlType = "Text",
    TextBoxType = "ComboBox",
    Count = 1,
    UserPin = false,
  })
  table.insert(ctrls, { Name = "setupDefaultRC", ControlType = "Text", Count = 1, UserPin = false })
  table.insert(ctrls, {
    Name = "setupGlobal",
    ControlType = "Button",
    ButtonType = "Toggle",
    Count = 1,
    UserPin = false,
  })
  table.insert(ctrls, {
    Name = "setupVisibility",
    ControlType = "Button",
    ButtonType = "Toggle",
    Count = 1,
    UserPin = false,
  })
  table.insert(ctrls, {
    Name = "setupMirror",
    ControlType = "Button",
    ButtonType = "Toggle",
    Count = 1,
    UserPin = false,
  })
  -- OutputString auto-format: true=Name ("AV N"), false=Number ("N").
  -- Faceplate-only (UserPin false). Legend tracks state at runtime.
  table.insert(ctrls, {
    Name = "setupOutputStringFormat",
    ControlType = "Button",
    ButtonType = "Toggle",
    Count = 1,
    UserPin = false,
  })
  -- Setup Mirror 1–N / Global 1–N masters. Count follows Outputs Per Room
  -- (same as combo/output pins). Count=1 is a scalar; unused N are omitted.
  setupOutCount = ACTIVE_OUTPUTS_PER_ROOM
  if setupOutCount < 1 then setupOutCount = 1 end
  table.insert(ctrls, {
    Name = "setupMirrorOut",
    ControlType = "Button",
    ButtonType = "Toggle",
    Count = setupOutCount,
    UserPin = false,
  })
  table.insert(ctrls, {
    Name = "setupGlobalOut",
    ControlType = "Button",
    ButtonType = "Toggle",
    Count = setupOutCount,
    UserPin = false,
  })

  table.insert(ctrls, {
    Name = "globalSourceComboBox",
    ControlType = "Text",
    TextBoxType = "ComboBox",
    Count = 1,
    UserPin = false,
  })
  gCtlCount = globalPinCount
  if gCtlCount < 1 then gCtlCount = 1 end
  table.insert(ctrls, {
    Name = "globalOutput",
    ControlType = "Text",
    Count = gCtlCount,
    UserPin = false,
  })
  table.insert(ctrls, {
    Name = "globalSourceControls",
    ControlType = "Button",
    ButtonType = "Toggle",
    Count = gCtlCount,
    UserPin = false,
  })

  table.insert(ctrls, {
    Name = "roomOptionGlobal",
    ControlType = "Button",
    ButtonType = "Toggle",
    Count = roomSlots,
    UserPin = false,
  })
  table.insert(ctrls, {
    Name = "roomOptionVisibility",
    ControlType = "Button",
    ButtonType = "Toggle",
    Count = roomSlots,
    UserPin = false,
  })
  table.insert(ctrls, {
    Name = "roomOptionMirror",
    ControlType = "Button",
    ButtonType = "Toggle",
    Count = roomSlots,
    UserPin = false,
  })
  for roomIdx = 1, ACTIVE_ROOM_COUNT do
    for outIdx = 1, ACTIVE_OUTPUTS_PER_ROOM do
      table.insert(ctrls, {
        Name = roomOutputMirrorCtlName(roomIdx, outIdx),
        ControlType = "Button",
        ButtonType = "Toggle",
        Count = 1,
        UserPin = false,
      })
    end
  end
  table.insert(ctrls, {
    Name = "roomOptionGlobalOut",
    ControlType = "Button",
    ButtonType = "Toggle",
    Count = outputSlots,
    UserPin = false,
  })

  -- comboBoxRm#Out# = routing (Both); outputRm#Out# = AV string (Output).
  for roomIdx = 1, ACTIVE_ROOM_COUNT do
    for outIdx = 1, ACTIVE_OUTPUTS_PER_ROOM do
      table.insert(ctrls, {
        Name = comboCtlName(roomIdx, outIdx),
        ControlType = "Text",
        TextBoxType = "ComboBox",
        Count = 1,
        UserPin = true,
        PinStyle = "Both",
      })
      table.insert(ctrls, {
        Name = outputCtlName(roomIdx, outIdx),
        ControlType = "Text",
        Count = 1,
        UserPin = true,
        PinStyle = "Output",
      })
    end
  end

  srcCount = ACTIVE_SOURCES_PER_ROOM
  if srcCount < 1 then srcCount = 1 end
  gCount = ACTIVE_GLOBAL_COUNT
  selInstances = ACTIVE_ROOM_COUNT * ACTIVE_OUTPUTS_PER_ROOM
    * (ACTIVE_ROOM_COUNT * srcCount + gCount)
  otherPins = 5 + (2 * ACTIVE_ROOM_COUNT * ACTIVE_OUTPUTS_PER_ROOM)
  pinSelects = (otherPins + selInstances) <= 256
  for roomIdx = 1, ACTIVE_ROOM_COUNT do
    for outIdx = 1, ACTIVE_OUTPUTS_PER_ROOM do
      for srcRoom = 1, ACTIVE_ROOM_COUNT do
        table.insert(ctrls, {
          Name = selectBankName(roomIdx, outIdx, localSlotIndex(srcRoom, 1)),
          ControlType = "Button",
          ButtonType = "Toggle",
          Count = srcCount,
          UserPin = pinSelects,
          PinStyle = pinSelects and "Input" or nil,
        })
      end
      if gCount > 0 then
        table.insert(ctrls, {
          Name = selectBankName(roomIdx, outIdx, globalSlotIndex(1)),
          ControlType = "Button",
          ButtonType = "Toggle",
          Count = gCount,
          UserPin = pinSelects,
          PinStyle = pinSelects and "Input" or nil,
        })
      end
    end
  end
  for roomIdx = 1, ACTIVE_ROOM_COUNT do
    table.insert(ctrls, {
      Name = "rm" .. roomIdx .. "OutSourceLabels",
      ControlType = "Text",
      Count = srcCount,
      UserPin = false,
    })
  end
  gLabelCount = gCount
  if gLabelCount < 1 then gLabelCount = 1 end
  table.insert(ctrls, {
    Name = "globalOutSourceLabels",
    ControlType = "Text",
    Count = gLabelCount,
    UserPin = false,
  })
  table.insert(ctrls, {
    Name = "roomOutputOutputStrings",
    ControlType = "Text",
    Count = sharedSlots,
    UserPin = false,
  })
  table.insert(ctrls, {
    Name = "setupSrcSel",
    ControlType = "Button",
    ButtonType = "Toggle",
    Count = sharedSlots,
    UserPin = false,
  })

  return ctrls
end


-- Layout -------------------------------------------------------------------
-- Default every control Style=None, then assign Style/Position/Size only for
-- controls on the current page (pageNameFromIndex / props.page_index).

function GetControlLayout(props)
  applyActiveDimensions(props)
  layout = {}
  graphics = {}
  currentPage = pageNameFromIndex(props)
  roomCount = ACTIVE_ROOM_COUNT
  sourcesPerRoom = ACTIVE_SOURCES_PER_ROOM
  outputsPerRoom = ACTIVE_OUTPUTS_PER_ROOM
  globalSourceCount = ACTIVE_GLOBAL_COUNT

  -- Shared spacing: all page drawers derive positions from these + control sizes.
  -- FONT_SIZE 9 is the faceplate type; CTRL_H / ROW_H / widths are sized to it.
  FONT_SIZE = 9
  RADIUS = 5
  MARGIN = 16
  COL_PAD = 12
  INNER_GAP = 8
  COL_GAP = 12
  ROW_H = 22
  ROW_PITCH = 26
  BTN_H = 22
  COMBO_H = 22
  CTRL_H = 22
  OPT_PITCH = 40
  DESC_H = 26
  TITLE_H = 30
  RULE_Y = 50
  HDR_H = 14
  CAPTION_H = 14
  CARD_TOP = 10
  SUMMARY_TO_GRID = 8
  GRID_HDR_TO_ROWS = 4
  GLOBAL_HDR_H = 14
  GLOBAL_HDR_TO_ROWS = 6
  CARD_BOTTOM_PAD = 12
  SEL_COL_W = 208
  META_COL_W = 220
  OUT_FIELD_W = 72
  STRIP_PAD = 6
  STRIP_GAP = 4
  STRIP_BTN = 28
  STRIP_LABEL_W = 26
  STRIP_COMBO_W = 96
  STRIP_OUT_W = 52

  function gLabel(text, x, y, w, h, bold, whiteText, fontSize, align)
    table.insert(graphics, {
      Type = "Label",
      Text = text,
      Position = { x, y },
      Size = { w, h or 14 },
      Color = UI.headerLabel,
      TextColor = UI.headerLabel,
      Font = bold and "Montserrat" or "Roboto",
      FontStyle = bold and "Bold" or "Regular",
      FontSize = fontSize or FONT_SIZE,
      HTextAlign = align or "Left",
    })
  end

  function gFill(x, y, w, h, fill, strokeWidth, strokeColor, cornerRadius)
    boxW = math.floor(w + 0.5)
    boxH = math.floor(h + 0.5)
    if boxW < 1 then boxW = 1 end
    if boxH < 1 then boxH = 1 end
    radius = cornerRadius or 0
    maxRadius = math.floor(math.min(boxW, boxH) / 2)
    if radius > maxRadius then radius = maxRadius end
    sw = strokeWidth or 0
    edge = strokeColor or fill
    table.insert(graphics, {
      Type = "GroupBox",
      Text = "",
      Font = "Roboto",
      FontStyle = "Regular",
      FontSize = FONT_SIZE,
      Fill = fill,
      Color = edge,
      StrokeWidth = sw,
      StrokeColor = edge,
      CornerRadius = radius,
      Position = { x, y },
      Size = { boxW, boxH },
    })
  end

  function gCard(x, y, w, h, fill, cornerRadius)
    gFill(x, y, w, h, fill, 1, UI.stroke, cornerRadius or RADIUS)
  end

  function gPanelBg(w, h)
    gFill(0, 0, w, h, UI.bg, 0, nil, RADIUS)
  end

  function gPageTitle(text, panelWidth, fontSize)
    gLabel(text, 20, 12, panelWidth - 40, 30, true, true, fontSize or 28)
  end

  function toggleLayout(x, y, w, h, legend)
    return {
      Style = "Button",
      ButtonStyle = "Toggle",
      ButtonVisualStyle = "Flat",
      Position = { x, y },
      Size = { w, h },
      CornerRadius = RADIUS,
      Color = UI.btnSelOn,
      OffColor = UI.btnOff,
      UnlinkOffColor = true,
      StrokeWidth = 1,
      StrokeColor = UI.controlStroke,
      Legend = legend,
      FontSize = FONT_SIZE,
      Font = "Roboto",
      FontStyle = "Regular",
    }
  end

  function comboLayout(x, y, w, h)
    return {
      Style = "ComboBox",
      Position = { x, y },
      Size = { w, h },
      CornerRadius = RADIUS,
      Color = UI.fieldSummary,
      StrokeWidth = 1,
      StrokeColor = UI.controlStroke,
      TextColor = UI.textDark,
      FontSize = FONT_SIZE,
      Font = "Roboto",
      FontStyle = "Regular",
    }
  end

  function fieldLayout(x, y, w, h, fill, readOnly)
    return {
      Style = "Text",
      IsReadOnly = readOnly and true or false,
      Position = { x, y },
      Size = { w, h },
      CornerRadius = RADIUS,
      Color = fill,
      StrokeWidth = 1,
      StrokeColor = UI.controlStroke,
      TextColor = UI.textDark,
      FontSize = FONT_SIZE,
      HTextAlign = "Left",
    }
  end

  -- Fit summary combo + output field inside a card's padded width.
  function splitSummaryOutput(blockX, colW, outW)
    pad = COL_PAD
    gap = INNER_GAP
    innerW = colW - (pad * 2)
    if outW > innerW - 64 - gap then
      outW = math.max(56, innerW - 64 - gap)
    end
    summaryW = innerW - outW - gap
    if summaryW < 64 then
      summaryW = 64
      outW = math.max(48, innerW - summaryW - gap)
      summaryW = innerW - outW - gap
    end
    selX = blockX + pad
    outX = selX + summaryW + gap
    return {
      pad = pad,
      gap = gap,
      innerW = innerW,
      selX = selX,
      summaryX = selX,
      summaryW = summaryW,
      outputX = outX,
      outputW = outW,
    }
  end

  -- Global tab: Select | Labels | Output across the full panel width.
  function metaColumnPositions(blockX, colW)
    pad = COL_PAD
    gap = INNER_GAP
    innerW = colW - (pad * 2)
    selW = 78
    outW = OUT_FIELD_W
    lblW = innerW - selW - outW - (gap * 2)
    if lblW < 72 then
      lblW = 72
      outW = math.max(56, innerW - selW - lblW - (gap * 2))
      lblW = innerW - selW - outW - (gap * 2)
    end
    selX = blockX + pad
    lblX = selX + selW + gap
    outX = lblX + lblW + gap
    return {
      pad = pad,
      innerW = innerW,
      selX = selX,
      selW = selW,
      labelX = lblX,
      labelW = lblW,
      outputX = outX,
      outputW = outW,
      summaryX = selX,
      summaryW = selW + gap + lblW,
    }
  end

  -- Room output card: Select toggles full-width; summary combo + Output pin on top.
  function selectColumnPositions(blockX, colW)
    pos = splitSummaryOutput(blockX, colW, OUT_FIELD_W)
    pos.selW = pos.innerW
    return pos
  end

  -- Shared Labels / OutputStrings column (one per AV slot, all Room tabs).
  function sharedMetaPositions(blockX, colW)
    pad = COL_PAD
    gap = INNER_GAP
    innerW = colW - (pad * 2)
    outW = OUT_FIELD_W
    lblW = innerW - outW - gap
    if lblW < 72 then
      lblW = 72
      outW = math.max(56, innerW - lblW - gap)
      lblW = innerW - outW - gap
    end
    lblX = blockX + pad
    outX = lblX + lblW + gap
    return {
      pad = pad,
      innerW = innerW,
      labelX = lblX,
      labelW = lblW,
      outputX = outX,
      outputW = outW,
    }
  end

  function columnGridHeaders(y, pos)
    if pos.selX then
      gLabel("Select", pos.selX, y, pos.selW, HDR_H, true, false)
    end
    if pos.labelX then
      gLabel("Labels", pos.labelX, y, pos.labelW, HDR_H, true, false)
    end
    if pos.outputX and pos.labelX then
      gLabel("Output", pos.outputX, y, pos.outputW, HDR_H, true, false)
    end
  end

  -- Vertical bands inside a room output / meta card (shared so rows stay aligned).
  function roomCardBandY(blockY, localCount, globalCount)
    titleY = blockY + CARD_TOP
    summaryLblY = titleY + HDR_H + 4
    summaryFldY = summaryLblY + CAPTION_H
    gridHeaderY = summaryFldY + COMBO_H + SUMMARY_TO_GRID
    firstRowY = gridHeaderY + HDR_H + GRID_HDR_TO_ROWS
    localBandH = localCount * ROW_PITCH
    globalHeaderY = firstRowY + localBandH
    globalRowsY = globalHeaderY
    globalBandH = 0
    if globalCount > 0 then
      globalRowsY = globalHeaderY + GLOBAL_HDR_H + GLOBAL_HDR_TO_ROWS
      globalBandH = GLOBAL_HDR_H + GLOBAL_HDR_TO_ROWS + (globalCount * ROW_PITCH)
    end
    contentBottom = firstRowY + localBandH + globalBandH
    blockH = (contentBottom - blockY) + CARD_BOTTOM_PAD
    return {
      titleY = titleY,
      summaryLblY = summaryLblY,
      summaryFldY = summaryFldY,
      gridHeaderY = gridHeaderY,
      firstRowY = firstRowY,
      globalHeaderY = globalHeaderY,
      globalRowsY = globalRowsY,
      blockH = blockH,
    }
  end

  -- Everything starts hidden; the active page re-declares what it shows.
  layout["status"] = { PrettyName = "Status~Debug", Style = "None" }
  layout["propertiesRoomCount"] = { PrettyName = ucPropertyName("Room Count"), Style = "None" }
  layout["propertiesSourcesPerRoom"] = { PrettyName = ucPropertyName("Sources Per Room"), Style = "None" }
  layout["propertiesOutputsPerRoom"] = { PrettyName = ucPropertyName("Outputs Per Room"), Style = "None" }
  layout["propertiesGlobalSourceCount"] = { PrettyName = ucPropertyName("Global Source Count"), Style = "None" }
  layout["setupRoomCombiner"] = { PrettyName = "setupRoomCombiner", Style = "None" }
  layout["setupDefaultRC"] = { PrettyName = "setupDefaultRC", Style = "None" }
  layout["setupGlobal"] = { PrettyName = "setupGlobal", Style = "None" }
  layout["setupVisibility"] = { PrettyName = "setupVisibility", Style = "None" }
  layout["setupMirror"] = { PrettyName = "setupMirror", Style = "None" }
  layout["setupOutputStringFormat"] = { PrettyName = "setupOutputStringFormat", Style = "None" }
  for outIdx = 1, outputsPerRoom do
    layout[indexedLayoutKey("setupMirrorOut", outIdx, outputsPerRoom)] =
      { PrettyName = ucSetupOutputMirrorName(outIdx), Style = "None" }
    layout[indexedLayoutKey("setupGlobalOut", outIdx, outputsPerRoom)] =
      { PrettyName = ucSetupOutputGlobalName(outIdx), Style = "None" }
  end
  layout["globalSourceComboBox"] = { PrettyName = "globalSourceComboBox", Style = "None" }

  -- Stub only active Counts (per-room Selects + shared Labels/OutputStrings).
  globalUiCount = globalSourceCount
  if globalUiCount < 1 then globalUiCount = 1 end
  sharedLayoutCount = activeSharedSlotCount()
  if sharedLayoutCount < 1 then sharedLayoutCount = 1 end
  optionOutCount = roomCount * outputsPerRoom
  if optionOutCount < 1 then optionOutCount = 1 end
  for globalIdx = 1, globalUiCount do
    if globalSourceCount > 0 then
      layout[indexedLayoutKey("globalSourceControls", globalIdx, globalUiCount)] =
        { PrettyName = ucGlobalSelectName(globalIdx), Style = "None" }
    else
      layout[indexedLayoutKey("globalSourceControls", globalIdx, globalUiCount)] =
        { PrettyName = "globalSourceControls", Style = "None" }
    end
  end

  if globalSourceCount > 0 then
    for globalIdx = 1, globalSourceCount do
      layout[indexedLayoutKey("globalOutput", globalIdx, globalUiCount)] = { PrettyName = ucGlobalOutputName(globalIdx), Style = "None" }
    end
  else
    layout[indexedLayoutKey("globalOutput", 1, 1)] = { PrettyName = "globalOutput1", Style = "None" }
  end

  for roomIdx = 1, roomCount do
    for localIdx = 1, sourcesPerRoom do
      avSlot = localSlotIndex(roomIdx, localIdx)
      layout[sourceLabelLayoutKey(avSlot)] =
        { PrettyName = ucSourceLabelPrettyName(avSlot), Style = "None" }
    end
  end
  gLabelCount = globalSourceCount
  if gLabelCount < 1 then gLabelCount = 1 end
  for globalIdx = 1, gLabelCount do
    avSlot = globalSlotIndex(globalIdx)
    layout[sourceLabelLayoutKey(avSlot)] =
      { PrettyName = ucSourceLabelPrettyName(avSlot), Style = "None" }
  end
  for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
    sharedIdx = sharedSlotIndex(avSlot)
    layout[indexedLayoutKey("roomOutputOutputStrings", sharedIdx, sharedLayoutCount)] = { PrettyName = "sourceOutputStrings", Style = "None" }
    layout[indexedLayoutKey("setupSrcSel", sharedIdx, sharedLayoutCount)] = { PrettyName = "setupSrcSel", Style = "None" }
  end
  if #ACTIVE_SLOT_LIST < 1 then
    layout[indexedLayoutKey("roomOutputOutputStrings", 1, 1)] = { PrettyName = "sourceOutputStrings", Style = "None" }
    layout[indexedLayoutKey("setupSrcSel", 1, 1)] = { PrettyName = "setupSrcSel", Style = "None" }
  end

  for roomIdx = 1, roomCount do
    layout[indexedLayoutKey("roomOptionGlobal", roomIdx, roomCount)] = { PrettyName = ucRoomOptionName(roomIdx, "Global All"), Style = "None" }
    layout[indexedLayoutKey("roomOptionVisibility", roomIdx, roomCount)] = { PrettyName = ucRoomOptionName(roomIdx, "Visibility"), Style = "None" }
    layout[indexedLayoutKey("roomOptionMirror", roomIdx, roomCount)] = { PrettyName = ucRoomOptionName(roomIdx, "Mirror All"), Style = "None" }
    for outIdx = 1, outputsPerRoom do
      flatOut = outputFlatIndex(roomIdx, outIdx)
      pinOut = outputPinFlatIndex(roomIdx, outIdx)
      layout[roomOutputMirrorCtlName(roomIdx, outIdx)] =
        { PrettyName = ucRoomOutputMirrorName(roomIdx, outIdx), Style = "None" }
      layout[indexedLayoutKey("roomOptionGlobalOut", flatOut, optionOutCount)] =
        { PrettyName = ucRoomOutputGlobalName(roomIdx, outIdx), Style = "None" }
      layout[comboCtlName(roomIdx, outIdx)] =
        { PrettyName = ucComboPrettyName(roomIdx, outIdx), Style = "None" }
      layout[outputCtlName(roomIdx, outIdx)] =
        { PrettyName = ucOutputPrettyName(roomIdx, outIdx), Style = "None" }
    end
  end
  -- Every output owns Select arrays (Sources Per Room locals + Global Count).
  for roomIdx = 1, roomCount do
    for outIdx = 1, outputsPerRoom do
      for srcRoom = 1, roomCount do
        for localIdx = 1, sourcesPerRoom do
          avSlot = localSlotIndex(srcRoom, localIdx)
          layKey = selectLayoutKey(roomIdx, outIdx, avSlot)
          if layKey then
            layout[layKey] = {
              PrettyName = ucSelectPinName(roomIdx, outIdx, avSlot),
              Style = "None",
            }
          end
        end
      end
      for gIdx = 1, globalSourceCount do
        avSlot = globalSlotIndex(gIdx)
        layKey = selectLayoutKey(roomIdx, outIdx, avSlot)
        if layKey then
          layout[layKey] = {
            PrettyName = ucSelectPinName(roomIdx, outIdx, avSlot),
            Style = "None",
          }
        end
      end
    end
  end


  function stripLeadW()
    return STRIP_PAD + STRIP_LABEL_W + STRIP_GAP + (3 * (STRIP_BTN + STRIP_GAP))
  end

  function stripPerOutW()
    return (2 * (STRIP_BTN + STRIP_GAP)) + STRIP_COMBO_W + STRIP_GAP + STRIP_OUT_W + STRIP_GAP
  end

  function stripCardW()
    return stripLeadW() + (outputsPerRoom * stripPerOutW()) + STRIP_PAD
  end

  function stripRowHeight()
    return CTRL_H + (STRIP_PAD * 2)
  end

  -- Live routing strip: every room's Combo / Output / Mirror / Global / Vis.
  -- Drawn on Setup and every Room tab so Designer never Style=None those
  -- writes (parking them off-canvas hid on-page controls and still dropped
  -- rooms 6–8). The current Room tab then overwrites that room's Combo /
  -- Output into the Select cards.

  function routingStripWidth()
    return MARGIN + stripCardW() + MARGIN
  end

  function routingStripHeight()
    return (CAPTION_H + 6) + (roomCount * stripRowHeight()) + 8
  end

  function drawRoutingStrip(startY, highlightRoom)
    rowH = stripRowHeight()
    cardW = stripCardW()
    ctlYOff = STRIP_PAD
    x0 = MARGIN
    gLabel("All rooms", x0, startY, 80, CAPTION_H, true, false)
    gLabel(
      "G V M and every Combo stay on this page so Mirror can write rooms 1–8",
      x0 + 80,
      startY,
      math.max(240, cardW - 80),
      CAPTION_H,
      false,
      false
    )
    y0 = startY + CAPTION_H + 6
    for roomIdx = 1, roomCount do
      y = y0 + ((roomIdx - 1) * rowH)
      fill = UI.card
      gCard(x0, y, cardW, rowH, fill, RADIUS)
      ctlY = y + ctlYOff
      gLabel("R" .. roomIdx, x0 + STRIP_PAD, ctlY + 4, STRIP_LABEL_W, 14, true, false)
      x = x0 + STRIP_PAD + STRIP_LABEL_W + STRIP_GAP
      layout[indexedLayoutKey("roomOptionGlobal", roomIdx, roomCount)] = toggleLayout(x, ctlY, STRIP_BTN, CTRL_H, "G")
      layout[indexedLayoutKey("roomOptionGlobal", roomIdx, roomCount)].PrettyName = ucRoomOptionName(roomIdx, "Global All")
      x = x + STRIP_BTN + STRIP_GAP
      layout[indexedLayoutKey("roomOptionVisibility", roomIdx, roomCount)] = toggleLayout(x, ctlY, STRIP_BTN, CTRL_H, "V")
      layout[indexedLayoutKey("roomOptionVisibility", roomIdx, roomCount)].PrettyName = ucRoomOptionName(roomIdx, "Visibility")
      x = x + STRIP_BTN + STRIP_GAP
      layout[indexedLayoutKey("roomOptionMirror", roomIdx, roomCount)] = toggleLayout(x, ctlY, STRIP_BTN, CTRL_H, "M")
      layout[indexedLayoutKey("roomOptionMirror", roomIdx, roomCount)].PrettyName = ucRoomOptionName(roomIdx, "Mirror All")
      x = x + STRIP_BTN + STRIP_GAP
      for outIdx = 1, outputsPerRoom do
        flatOut = outputFlatIndex(roomIdx, outIdx)
        layout[indexedLayoutKey("roomOptionGlobalOut", flatOut, optionOutCount)] = toggleLayout(x, ctlY, STRIP_BTN, CTRL_H, "G" .. outIdx)
        layout[indexedLayoutKey("roomOptionGlobalOut", flatOut, optionOutCount)].PrettyName = ucRoomOutputGlobalName(roomIdx, outIdx)
        x = x + STRIP_BTN + STRIP_GAP
        layout[roomOutputMirrorCtlName(roomIdx, outIdx)] = toggleLayout(x, ctlY, STRIP_BTN, CTRL_H, "M" .. outIdx)
        layout[roomOutputMirrorCtlName(roomIdx, outIdx)].PrettyName = ucRoomOutputMirrorName(roomIdx, outIdx)
        x = x + STRIP_BTN + STRIP_GAP
        layout[comboCtlName(roomIdx, outIdx)] = comboLayout(x, ctlY, STRIP_COMBO_W, CTRL_H)
        layout[comboCtlName(roomIdx, outIdx)].PrettyName =
          ucComboPrettyName(roomIdx, outIdx)
        layout[comboCtlName(roomIdx, outIdx)].Choices =
          designTimeRoomChoices(roomIdx, sourcesPerRoom)
        x = x + STRIP_COMBO_W + STRIP_GAP
        layout[outputCtlName(roomIdx, outIdx)] =
          fieldLayout(x, ctlY, STRIP_OUT_W, CTRL_H, UI.fieldSummary, true)
        layout[outputCtlName(roomIdx, outIdx)].PrettyName =
          ucOutputPrettyName(roomIdx, outIdx)
        x = x + STRIP_OUT_W + STRIP_GAP
      end
    end
    return y0 + (roomCount * rowH) + 8
  end

  -- Other rooms' (and unused) Select banks stay Style=Button (parked
  -- off-canvas). Style=None drops Boolean writes, which is why Mirror All
  -- updated combos (live on the strip) but not the other rooms' Selects.
  -- keepRoomIdx is the Room tab being drawn; nil parks every bank (Setup/Global).
  -- Per-output now: Room N's four banks sit on the cards; every other bank
  -- is parked as Button, including other rooms' columns.
  function parkOffTabSelectBanks(keepRoomIdx)
    parkY = 0
    for roomIdx = 1, roomCount do
      if roomIdx ~= keepRoomIdx then
        for outIdx = 1, outputsPerRoom do
          for srcRoom = 1, roomCount do
            for localIdx = 1, sourcesPerRoom do
              avSlot = localSlotIndex(srcRoom, localIdx)
              layKey = selectLayoutKey(roomIdx, outIdx, avSlot)
              if layKey then
                layout[layKey] = toggleLayout(-2000, parkY, 8, 8, defaultLabelForSlot(avSlot))
                layout[layKey].PrettyName = ucSelectPinName(roomIdx, outIdx, avSlot)
                layout[layKey].Color = UI.btnSelOn
                layout[layKey].OffColor = UI.btnSelOff
                layout[layKey].CornerRadius = RADIUS
                parkY = parkY + 1
              end
            end
          end
          for gIdx = 1, globalSourceCount do
            avSlot = globalSlotIndex(gIdx)
            layKey = selectLayoutKey(roomIdx, outIdx, avSlot)
            if layKey then
              layout[layKey] = toggleLayout(-2000, parkY, 8, 8, defaultLabelForSlot(avSlot))
              layout[layKey].PrettyName = ucSelectPinName(roomIdx, outIdx, avSlot)
              layout[layKey].Color = UI.btnSelOn
              layout[layKey].OffColor = UI.btnSelOff
              layout[layKey].CornerRadius = RADIUS
              parkY = parkY + 1
            end
          end
        end
      end
    end
  end


  -- Setup page --------------------------------------------------------------
  -- Band 1: Room Combiner master. Band 2: system option toggles + legends.

  function drawSetupPage()
    panelWidth = math.max(560, routingStripWidth())
    lblColX = 24
    lblColW = 130
    ctrlX = 168
    comboW = 140
    btnW = 90
    descGap = 12
    combinerY = RULE_Y + 12
    combinerDescX = ctrlX + comboW + descGap
    combinerDescW = panelWidth - combinerDescX - MARGIN
    combinerDescH = DESC_H
    descX = ctrlX + btnW + descGap
    descW = panelWidth - descX - MARGIN
    bandRuleY = combinerY + math.max(BTN_H, 4 + combinerDescH) + 14
    gBtnW = 80
    gGap = 8
    cardInset = 8
    innerPad = 8
    descGapY = 4
    rowGap = 8
    sysX = MARGIN
    sysW = panelWidth - (MARGIN * 2)
    innerX = sysX + cardInset
    innerW = sysW - (cardInset * 2)
    optionLblX = innerX + innerPad
    optionLblW = ctrlX - optionLblX - 8
    sysHeadPad = 8
    sysHeaderY = bandRuleY + 16
    innerStartY = sysHeaderY + CAPTION_H + 8
    stackH = innerPad + BTN_H + descGapY + DESC_H + innerPad
    singleH = innerPad + math.max(BTN_H, DESC_H) + innerPad
    globalCardY = innerStartY
    visCardY = globalCardY + stackH + rowGap
    mirrorCardY = visCardY + singleH + rowGap
    nameOptCardY = mirrorCardY + stackH + rowGap
    sysBottom = nameOptCardY + singleH + sysHeadPad
    sysTop = sysHeaderY - sysHeadPad
    nameRows = math.max(#ACTIVE_SLOT_LIST, 1)
    globalHdrH = 0
    if globalSourceCount > 0 then
      globalHdrH = GLOBAL_HDR_H + GLOBAL_HDR_TO_ROWS
    end
    stripTop = sysBottom + 14
    namesRuleY = stripTop + routingStripHeight()
    namesHeaderY = namesRuleY + 30 + COL_PAD
    namesFirstY = namesHeaderY + HDR_H + 6
    bodyH = namesFirstY + (nameRows * ROW_PITCH) + globalHdrH + COL_PAD + 16

    gPanelBg(panelWidth, bodyH)
    gPageTitle(PAGE_SETUP, panelWidth)

    combinerCardH = innerPad + BTN_H + innerPad
    gCard(sysX, combinerY - innerPad, sysW, combinerCardH, UI.card, RADIUS)
    gLabel(
      "Room Combiner",
      lblColX,
      combinerY + math.floor((BTN_H - CAPTION_H) / 2),
      lblColW,
      CAPTION_H,
      false,
      false
    )
    layout["setupRoomCombiner"] = comboLayout(ctrlX, combinerY, comboW, BTN_H)
    layout["setupRoomCombiner"].PrettyName = "setupRoomCombiner"
    gLabel(
      "choose which room combiner",
      combinerDescX,
      combinerY + math.floor((BTN_H - CAPTION_H) / 2),
      combinerDescW,
      CAPTION_H,
      false,
      false
    )

    gCard(sysX, sysTop, sysW, sysBottom - sysTop, UI.card, RADIUS)
    gLabel("System Options", lblColX, sysHeaderY, lblColW + 40, CAPTION_H, true, false)

    gCard(innerX, globalCardY, innerW, stackH, UI.card, RADIUS)
    globalBtnY = globalCardY + innerPad
    gLabel(
      "Global settings",
      optionLblX,
      globalBtnY + math.floor((BTN_H - CAPTION_H) / 2),
      optionLblW,
      CAPTION_H,
      false,
      false
    )
    layout["setupGlobal"] = toggleLayout(ctrlX, globalBtnY, btnW, BTN_H, "Global All")
    layout["setupGlobal"].PrettyName = "setupGlobal"
    for outIdx = 1, outputsPerRoom do
      gX = ctrlX + btnW + gGap + ((outIdx - 1) * (gBtnW + gGap))
      gKey = indexedLayoutKey("setupGlobalOut", outIdx, outputsPerRoom)
      layout[gKey] =
        toggleLayout(gX, globalBtnY, gBtnW, BTN_H, "Global " .. outIdx)
      layout[gKey].PrettyName = ucSetupOutputGlobalName(outIdx)
    end
    gLabel(
      "Global All sets all rooms Global All (and Global 1–4) to match; Global N shows global sources on that output",
      ctrlX, globalBtnY + BTN_H + descGapY, innerX + innerW - innerPad - ctrlX, DESC_H, false, false
    )

    gCard(innerX, visCardY, innerW, singleH, UI.card, RADIUS)
    visBtnY = visCardY + innerPad + math.floor((math.max(BTN_H, DESC_H) - BTN_H) / 2)
    gLabel(
      "Visibility settings",
      optionLblX,
      visBtnY + math.floor((BTN_H - CAPTION_H) / 2),
      optionLblW,
      CAPTION_H,
      false,
      false
    )
    layout["setupVisibility"] = toggleLayout(ctrlX, visBtnY, btnW, BTN_H, "Visibility")
    layout["setupVisibility"].PrettyName = "setupVisibility"
    gLabel(
      "Visibility sets all rooms Visibility to match (off also clears Mirror); on adds combined room sources to every room output",
      descX, visBtnY + math.floor((BTN_H - DESC_H) / 2), descW, DESC_H, false, false
    )

    gCard(innerX, mirrorCardY, innerW, stackH, UI.card, RADIUS)
    mirrorBtnY = mirrorCardY + innerPad
    gLabel(
      "Mirror settings",
      optionLblX,
      mirrorBtnY + math.floor((BTN_H - CAPTION_H) / 2),
      optionLblW,
      CAPTION_H,
      false,
      false
    )
    layout["setupMirror"] = toggleLayout(ctrlX, mirrorBtnY, btnW, BTN_H, "Mirror All")
    layout["setupMirror"].PrettyName = "setupMirror"
    for outIdx = 1, outputsPerRoom do
      mX = ctrlX + btnW + gGap + ((outIdx - 1) * (gBtnW + gGap))
      mKey = indexedLayoutKey("setupMirrorOut", outIdx, outputsPerRoom)
      layout[mKey] =
        toggleLayout(mX, mirrorBtnY, gBtnW, BTN_H, "Mirror " .. outIdx)
      layout[mKey].PrettyName = ucSetupOutputMirrorName(outIdx)
    end
    gLabel(
      "Mirror sets all rooms Mirror All to match (on also forces Visibility on and turns Mirror 1–4 off); All-on rooms share every output only with rooms they are combined with",
      ctrlX, mirrorBtnY + BTN_H + descGapY, innerX + innerW - innerPad - ctrlX, DESC_H, false, false
    )

    gCard(innerX, nameOptCardY, innerW, singleH, UI.card, RADIUS)
    nameBtnY = nameOptCardY + innerPad + math.floor((math.max(BTN_H, DESC_H) - BTN_H) / 2)
    gLabel(
      "Output naming",
      optionLblX,
      nameBtnY + math.floor((BTN_H - CAPTION_H) / 2),
      optionLblW,
      CAPTION_H,
      false,
      false
    )
    layout["setupOutputStringFormat"] = toggleLayout(ctrlX, nameBtnY, btnW, BTN_H, "Name")
    layout["setupOutputStringFormat"].PrettyName = "setupOutputStringFormat"
    gLabel(
      "Name fills OutputStrings as AV 1, AV 2, …; Number fills as 1, 2, … (custom strings stay)",
      descX, nameBtnY + math.floor((BTN_H - DESC_H) / 2), descW, DESC_H, false, false
    )

    namesRuleY = drawRoutingStrip(stripTop, nil)
    gLabel("Source names", lblColX, namesRuleY + 12, lblColW + 40, CAPTION_H, true, false)
    gLabel(
      "Button legends and Output strings. Room and Global tabs show the legend only.",
      ctrlX, namesRuleY + 12, panelWidth - ctrlX - MARGIN, CAPTION_H, false, false
    )
    pos = metaColumnPositions(MARGIN, panelWidth - (MARGIN * 2))
    pos.selW = 110
    pos.labelX = pos.selX + pos.selW + INNER_GAP
    pos.labelW = pos.outputX - pos.labelX - INNER_GAP
    namesCardY = namesRuleY + 30
    namesHeaderY = namesCardY + COL_PAD
    namesFirstY = namesHeaderY + HDR_H + 6
    localNameCount = 0
    for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
      if not slotIsGlobal(avSlot) then
        localNameCount = localNameCount + 1
      end
    end
    lastRowY = namesFirstY
    if localNameCount > 0 then
      lastRowY = namesFirstY + ((localNameCount - 1) * ROW_PITCH)
    end
    if globalSourceCount > 0 then
      lastRowY = namesFirstY + (localNameCount * ROW_PITCH) + GLOBAL_HDR_H + GLOBAL_HDR_TO_ROWS
      if globalSourceCount > 1 then
        lastRowY = lastRowY + ((globalSourceCount - 1) * ROW_PITCH)
      end
    end
    namesCardH = (lastRowY + ROW_H + COL_PAD) - namesCardY
    gCard(MARGIN, namesCardY, panelWidth - (MARGIN * 2), namesCardH, UI.card, RADIUS)
    columnGridHeaders(namesHeaderY, pos)
    namesFirstY = namesHeaderY + HDR_H + 6
    nameRow = 0
    for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
      if not slotIsGlobal(avSlot) then
        sharedIdx = sharedSlotIndex(avSlot)
        if sharedIdx then
          nameRow = nameRow + 1
          rowY = namesFirstY + ((nameRow - 1) * ROW_PITCH)
          layout[indexedLayoutKey("setupSrcSel", sharedIdx, sharedLayoutCount)] =
            toggleLayout(pos.selX, rowY, pos.selW, ROW_H, defaultLabelForSlot(avSlot))
          layout[indexedLayoutKey("setupSrcSel", sharedIdx, sharedLayoutCount)].Color = UI.btnSelOn
          layout[indexedLayoutKey("setupSrcSel", sharedIdx, sharedLayoutCount)].OffColor = UI.btnSelOff
          layout[indexedLayoutKey("setupSrcSel", sharedIdx, sharedLayoutCount)].CornerRadius = RADIUS
          layout[indexedLayoutKey("setupSrcSel", sharedIdx, sharedLayoutCount)].PrettyName = "setupSrcSel"
          layout[sourceLabelLayoutKey(avSlot)] =
            fieldLayout(pos.labelX, rowY, pos.labelW, ROW_H, UI.fieldGrid, false)
          layout[sourceLabelLayoutKey(avSlot)].PrettyName = ucSourceLabelPrettyName(avSlot)
          layout[indexedLayoutKey("roomOutputOutputStrings", sharedIdx, sharedLayoutCount)] =
            fieldLayout(pos.outputX, rowY, pos.outputW, ROW_H, UI.fieldOut, false)
          layout[indexedLayoutKey("roomOutputOutputStrings", sharedIdx, sharedLayoutCount)].PrettyName = "sourceOutputStrings"
        end
      end
    end
    if globalSourceCount > 0 then
      globalHeaderY = namesFirstY + (nameRow * ROW_PITCH)
      gLabel("Global Sources", pos.selX, globalHeaderY, pos.innerW, GLOBAL_HDR_H, true, false)
      globalRow = 0
      for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
        if slotIsGlobal(avSlot) then
          sharedIdx = sharedSlotIndex(avSlot)
          if sharedIdx then
            globalRow = globalRow + 1
            rowY = globalHeaderY + GLOBAL_HDR_H + GLOBAL_HDR_TO_ROWS + ((globalRow - 1) * ROW_PITCH)
            layout[indexedLayoutKey("setupSrcSel", sharedIdx, sharedLayoutCount)] =
              toggleLayout(pos.selX, rowY, pos.selW, ROW_H, defaultLabelForSlot(avSlot))
            layout[indexedLayoutKey("setupSrcSel", sharedIdx, sharedLayoutCount)].Color = UI.btnSelOn
            layout[indexedLayoutKey("setupSrcSel", sharedIdx, sharedLayoutCount)].OffColor = UI.btnSelOff
            layout[indexedLayoutKey("setupSrcSel", sharedIdx, sharedLayoutCount)].CornerRadius = RADIUS
            layout[indexedLayoutKey("setupSrcSel", sharedIdx, sharedLayoutCount)].PrettyName = "setupSrcSel"
            layout[sourceLabelLayoutKey(avSlot)] =
              fieldLayout(pos.labelX, rowY, pos.labelW, ROW_H, UI.fieldGrid, false)
            layout[sourceLabelLayoutKey(avSlot)].PrettyName = ucSourceLabelPrettyName(avSlot)
            layout[indexedLayoutKey("roomOutputOutputStrings", sharedIdx, sharedLayoutCount)] =
              fieldLayout(pos.outputX, rowY, pos.outputW, ROW_H, UI.fieldOut, false)
            layout[indexedLayoutKey("roomOutputOutputStrings", sharedIdx, sharedLayoutCount)].PrettyName = "sourceOutputStrings"
          end
        end
      end
    end
    parkOffTabSelectBanks(nil)
  end

  -- Global Sources page -----------------------------------------------------
  -- Summary band (combo + output pin), then packed global Select rows.
  -- Source Labels / OutputStrings live on Setup.

  function drawGlobalSourcesPage()
    panelWidth = MARGIN + SEL_COL_W + MARGIN
    colW = SEL_COL_W
    pos = selectColumnPositions(MARGIN, colW)
    blockY = RULE_Y + 8
    rowCount = math.max(globalSourceCount, 1)
    bands = roomCardBandY(blockY, rowCount, 0)
    blockH = bands.blockH
    bodyH = blockY + blockH + 12

    gPanelBg(panelWidth, bodyH)
    gPageTitle(PAGE_GLOBAL, panelWidth, 16)
    gCard(MARGIN, blockY, colW, blockH, UI.card, RADIUS)

    gLabel("Select Source", pos.summaryX, bands.summaryLblY, pos.summaryW, CAPTION_H, false, false)
    layout["globalSourceComboBox"] = comboLayout(pos.summaryX, bands.summaryFldY, pos.summaryW, COMBO_H)
    layout["globalSourceComboBox"].PrettyName = "globalSourceComboBox"
    layout["globalSourceComboBox"].Choices = designTimeGlobalChoices(globalSourceCount)

    gLabel("Output", pos.outputX, bands.summaryLblY, pos.outputW, CAPTION_H, false, false)
    if globalSourceCount > 0 then
      for globalIdx = 1, globalSourceCount do
        layout[indexedLayoutKey("globalOutput", globalIdx, globalUiCount)] =
          fieldLayout(pos.outputX, bands.summaryFldY, pos.outputW, COMBO_H, UI.fieldSummary, true)
        layout[indexedLayoutKey("globalOutput", globalIdx, globalUiCount)].PrettyName = ucGlobalOutputName(globalIdx)
      end
    else
      layout[indexedLayoutKey("globalOutput", 1, 1)] = fieldLayout(pos.outputX, bands.summaryFldY, pos.outputW, COMBO_H, UI.fieldSummary, true)
      layout[indexedLayoutKey("globalOutput", 1, 1)].PrettyName = "globalOutput1"
    end

    gLabel("Select", pos.selX, bands.gridHeaderY, pos.selW, HDR_H, true, false)

    for globalIdx = 1, globalSourceCount do
      rowY = bands.firstRowY + ((globalIdx - 1) * ROW_PITCH)
      gSlot = globalSlotIndex(globalIdx)
      legend = defaultLabelForSlot(gSlot)
      layout[indexedLayoutKey("globalSourceControls", globalIdx, globalUiCount)] =
        toggleLayout(pos.selX, rowY, pos.selW, ROW_H, legend)
      layout[indexedLayoutKey("globalSourceControls", globalIdx, globalUiCount)].Color = UI.btnSelOn
      layout[indexedLayoutKey("globalSourceControls", globalIdx, globalUiCount)].OffColor = UI.btnSelOff
      layout[indexedLayoutKey("globalSourceControls", globalIdx, globalUiCount)].CornerRadius = RADIUS
      layout[indexedLayoutKey("globalSourceControls", globalIdx, globalUiCount)].PrettyName = ucGlobalSelectName(globalIdx)
    end
    parkOffTabSelectBanks(nil)
  end


  -- Room page ---------------------------------------------------------------
  -- Options band, then per-output Select cards.

  function drawRoomOptions(roomIdx, panelWidth)
    lblColX = 24
    lblColW = 130
    optBtnX = 168
    optBtnW = 90
    optDescX = optBtnX + optBtnW + 12
    optDescW = panelWidth - optDescX - MARGIN
    optRow1Y = RULE_Y + 12
    optRow2Y = optRow1Y + OPT_PITCH
    optRow3Y = optRow2Y + OPT_PITCH
    optRow4Y = optRow3Y + OPT_PITCH
    optRow5Y = optRow4Y + OPT_PITCH

    gPageTitle("Room " .. roomIdx, panelWidth)
    gLabel("Room Options", lblColX, optRow1Y + 4, lblColW, CAPTION_H, true, false)

    layout[indexedLayoutKey("roomOptionGlobal", roomIdx, roomCount)] = toggleLayout(optBtnX, optRow1Y, optBtnW, BTN_H, "Global All")
    layout[indexedLayoutKey("roomOptionGlobal", roomIdx, roomCount)].PrettyName = ucRoomOptionName(roomIdx, "Global All")
    gLabel(
      "Global All adds global sources to this room (also sets Global 1–4); use Global 1–4 to show or hide them per output",
      optDescX, optRow1Y + 2, optDescW, DESC_H, false, false
    )

    gLabel("Per output", lblColX, optRow2Y + 4, lblColW, CAPTION_H, false, false)
    gBtnW = 80
    gGap = 8
    for outIdx = 1, outputsPerRoom do
      gX = optBtnX + ((outIdx - 1) * (gBtnW + gGap))
      flatOut = outputFlatIndex(roomIdx, outIdx)
      layout[indexedLayoutKey("roomOptionGlobalOut", flatOut, optionOutCount)] =
        toggleLayout(gX, optRow2Y, gBtnW, BTN_H, "Global " .. outIdx)
      layout[indexedLayoutKey("roomOptionGlobalOut", flatOut, optionOutCount)].PrettyName = ucRoomOutputGlobalName(roomIdx, outIdx)
    end

    layout[indexedLayoutKey("roomOptionVisibility", roomIdx, roomCount)] = toggleLayout(optBtnX, optRow3Y, optBtnW, BTN_H, "Visibility")
    layout[indexedLayoutKey("roomOptionVisibility", roomIdx, roomCount)].PrettyName = ucRoomOptionName(roomIdx, "Visibility")
    gLabel(
      "Adds the sources of any room combined with this one (off also clears all Mirror), per the room combiner configuration",
      optDescX, optRow3Y + 2, optDescW, DESC_H, false, false
    )

    layout[indexedLayoutKey("roomOptionMirror", roomIdx, roomCount)] = toggleLayout(optBtnX, optRow4Y, optBtnW, BTN_H, "Mirror")
    layout[indexedLayoutKey("roomOptionMirror", roomIdx, roomCount)].PrettyName = ucRoomOptionName(roomIdx, "Mirror All")
    gLabel(
      "Mirror All: routes any selected source to every output of this room, and to combined rooms that also have Mirror All on (turns Mirror 1–4 off)",
      optDescX, optRow4Y + 2, optDescW, DESC_H, false, false
    )

    gLabel("Per output", lblColX, optRow5Y + 4, lblColW, CAPTION_H, false, false)
    mBtnW = 80
    mGap = 8
    for outIdx = 1, outputsPerRoom do
      mX = optBtnX + ((outIdx - 1) * (mBtnW + mGap))
      flatOut = outputFlatIndex(roomIdx, outIdx)
      layout[roomOutputMirrorCtlName(roomIdx, outIdx)] =
        toggleLayout(mX, optRow5Y, mBtnW, BTN_H, "Mirror " .. outIdx)
      layout[roomOutputMirrorCtlName(roomIdx, outIdx)].PrettyName = ucRoomOutputMirrorName(roomIdx, outIdx)
    end

    return optRow5Y + BTN_H + 12
  end

  function drawRoomOutputColumn(viewRoomIdx, outIdx, blockX, blockY, colW, blockH, localSlots, bands)
    pos = selectColumnPositions(blockX, colW)
    flatOut = outputFlatIndex(viewRoomIdx, outIdx)
    pinOut = outputPinFlatIndex(viewRoomIdx, outIdx)
    gCard(blockX, blockY, colW, blockH, UI.card, RADIUS)

    gLabel(
      "Room " .. viewRoomIdx .. " Output " .. outIdx,
      pos.selX, bands.titleY, pos.innerW, HDR_H, true, false
    )

    gLabel("Select Source", pos.summaryX, bands.summaryLblY, pos.summaryW, CAPTION_H, false, false)
    layout[comboCtlName(viewRoomIdx, outIdx)] =
      comboLayout(pos.summaryX, bands.summaryFldY, pos.summaryW, COMBO_H)
    layout[comboCtlName(viewRoomIdx, outIdx)].PrettyName =
      ucComboPrettyName(viewRoomIdx, outIdx)
    layout[comboCtlName(viewRoomIdx, outIdx)].Choices = designTimeRoomChoices(viewRoomIdx, sourcesPerRoom)

    gLabel("Output", pos.outputX, bands.summaryLblY, pos.outputW, CAPTION_H, false, false)
    layout[outputCtlName(viewRoomIdx, outIdx)] =
      fieldLayout(pos.outputX, bands.summaryFldY, pos.outputW, COMBO_H, UI.fieldSummary, true)
    layout[outputCtlName(viewRoomIdx, outIdx)].PrettyName = ucOutputPrettyName(viewRoomIdx, outIdx)

    gLabel("Select", pos.selX, bands.gridHeaderY, pos.selW, HDR_H, true, false)

    for row = 1, #localSlots do
      slot = localSlots[row]
      layKey = selectLayoutKey(viewRoomIdx, outIdx, slot)
      legend = defaultLabelForSlot(slot)
      layout[layKey] =
        toggleLayout(pos.selX, bands.firstRowY + ((row - 1) * ROW_PITCH), pos.selW, ROW_H, legend)
      layout[layKey].Color = UI.btnSelOn
      layout[layKey].OffColor = UI.btnSelOff
      layout[layKey].CornerRadius = RADIUS
      layout[layKey].PrettyName =
        ucSelectPinName(viewRoomIdx, outIdx, slot)
    end

    if globalSourceCount > 0 then
      gLabel("Global Sources", pos.selX, bands.globalHeaderY, pos.innerW, GLOBAL_HDR_H, true, false)
      for globalIdx = 1, globalSourceCount do
        slot = globalSlotIndex(globalIdx)
        layKey = selectLayoutKey(viewRoomIdx, outIdx, slot)
        legend = defaultLabelForSlot(slot)
        layout[layKey] = toggleLayout(
          pos.selX,
          bands.globalRowsY + ((globalIdx - 1) * ROW_PITCH),
          pos.selW,
          ROW_H,
          legend
        )
        layout[layKey].Color = UI.btnSelOn
        layout[layKey].OffColor = UI.btnSelOff
        layout[layKey].CornerRadius = RADIUS
        layout[layKey].PrettyName =
          ucSelectPinName(viewRoomIdx, outIdx, slot)
      end
    end
  end

  -- Room page: options + per-output Select cards. Labels/OutputStrings are on Setup.

  function drawRoomPage(viewRoomIdx)
    panelWidth = math.max(
      MARGIN
        + (outputsPerRoom * SEL_COL_W)
        + ((outputsPerRoom - 1) * COL_GAP)
        + MARGIN,
      routingStripWidth()
    )
    localSlots = orderedLocalSlots(viewRoomIdx, roomCount, sourcesPerRoom)
    stripTop = RULE_Y + 8
    optionsBottomY = stripTop + routingStripHeight()
    blockY = optionsBottomY + 12
    bands = roomCardBandY(blockY, #localSlots, globalSourceCount)
    blockH = bands.blockH
    bodyH = blockY + blockH + 12

    gPanelBg(panelWidth, bodyH)
    gPageTitle("Room " .. viewRoomIdx, panelWidth)
    optionsBottomY = drawRoutingStrip(stripTop, viewRoomIdx)

    for outIdx = 1, outputsPerRoom do
      drawRoomOutputColumn(
        viewRoomIdx,
        outIdx,
        MARGIN + ((outIdx - 1) * (SEL_COL_W + COL_GAP)),
        blockY,
        SEL_COL_W,
        blockH,
        localSlots,
        bands
      )
    end
    parkOffTabSelectBanks(viewRoomIdx)
  end

  if currentPage == PAGE_SETUP then
    drawSetupPage()
  elseif currentPage == PAGE_GLOBAL then
    drawGlobalSourcesPage()
  else
    roomNum = tonumber(string.match(currentPage, "Room (%d+)"))
    if roomNum and roomNum >= 1 and roomNum <= roomCount then
      drawRoomPage(roomNum)
    else
      drawSetupPage()
    end
  end

  return layout, graphics
end


---------------------------------------------------------------------------
-- Runtime control code (emulation / Core compile — only when Controls exists)
---------------------------------------------------------------------------

if Controls then
  print("Room Combine Video Routing " .. PluginInfo.Version)

  json = nil
  okJson, jsonMod = pcall(require, "rapidjson")
  if okJson and jsonMod then
    json = jsonMod
  else
    okJson, jsonMod = pcall(require, "json")
    if okJson and jsonMod then
      json = jsonMod
    end
  end

  applyActiveDimensions(Properties)

  status = Controls.status
  setupRoomCombiner = Controls.setupRoomCombiner
  setupDefaultRC = Controls.setupDefaultRC
  setupGlobal = Controls.setupGlobal
  setupVisibility = Controls.setupVisibility
  setupMirror = Controls.setupMirror
  okBanks, errBanks = pcall(function()
    setupMirrorOut = bindNumberedBank("setupMirrorOut", ACTIVE_OUTPUTS_PER_ROOM)
    setupGlobalOut = bindNumberedBank("setupGlobalOut", ACTIVE_OUTPUTS_PER_ROOM)
    roomOptionGlobal = bindNumberedBank("roomOptionGlobal", ACTIVE_ROOM_COUNT)
    roomOptionVisibility = bindNumberedBank("roomOptionVisibility", ACTIVE_ROOM_COUNT)
    roomOptionMirror = bindNumberedBank("roomOptionMirror", ACTIVE_ROOM_COUNT)
    roomOptionGlobalOut = bindNumberedBank("roomOptionGlobalOut", activeOutputPinCount())
    gBankCount = ACTIVE_GLOBAL_COUNT
    if gBankCount < 1 then gBankCount = 1 end
    globalSourceControls = bindNumberedBank("globalSourceControls", gBankCount)
    globalOutputPins = bindNumberedBank("globalOutput", gBankCount)
    roomOutputOutputStrings = bindNumberedBank("roomOutputOutputStrings", activeSharedSlotCount())
  end)
  if not okBanks then
    print("Room Combine Video Routing Bind banks: " .. tostring(errBanks))
    if status then
      status.String = "Bind banks: " .. tostring(errBanks)
    end
  end
  setupOutputStringFormat = Controls.setupOutputStringFormat

  function setupMirrorOutCtl(outIdx)
    return indexedControl(setupMirrorOut, outIdx)
  end

  function setupGlobalOutCtl(outIdx)
    return indexedControl(setupGlobalOut, outIdx)
  end

  roomCombiners = {}
  configControl = nil
  wallOpenControls = {}
  wallConfigControls = {}
  lastGroupSource = "default"
  lastCombinerFingerprint = ""
  combinerDirty = false
  isUpdating = false
  updateDepth = 0
  handlerMuteDepth = 0
  bootComplete = false
  activePageIdx = Properties["page_index"].Value
  lastPageIdx = activePageIdx
  configPollTimer = Timer.New()
  pagePollTimer = Timer.New()
  selectPressTimer = Timer.New()

  -- Event suppression. Must be throw-safe: a raw begin/end pair that throws
  -- between the two leaves isUpdating true forever and the whole plugin dies
  -- (empty combo lists, dead selects, ignored toggles).
  --
  -- IMPORTANT: Designer often drops String / Legend / Choices / IsInvisible
  -- commits while isUpdating is true. Use suppressing() only to block
  -- re-entrant handlers around Boolean/mirror work. Seed Label/OutputString/
  -- Select Legend with muteHandlers() AFTER resetUpdateGate() so writes stick.
  function resetUpdateGate()
    updateDepth = 0
    isUpdating = false
  end

  function suppressing(fn)
    updateDepth = updateDepth + 1
    isUpdating = true
    okSup, errSup = pcall(fn)
    updateDepth = updateDepth - 1
    if updateDepth <= 0 then
      resetUpdateGate()
    else
      isUpdating = true
    end
    if not okSup then
      error(errSup)
    end
  end

  -- Block EventHandlers without setting isUpdating, so Designer still commits
  -- String/Legend writes made inside the callback. Watchdog clears stuck depth.
  function muteHandlers(fn)
    handlerMuteDepth = handlerMuteDepth + 1
    okMute, errMute = pcall(fn)
    handlerMuteDepth = handlerMuteDepth - 1
    if handlerMuteDepth < 0 then handlerMuteDepth = 0 end
    if not okMute then
      error(errMute)
    end
  end

  -- Nuclear unlock: never gate user EventHandlers on mute/boot/update flags.
  -- muteHandlers still blocks re-entrant fan-out; watchdog resets stuck depth.
  function runHandler(label, fn)
    if fn == nil then return end
    okH, errH = pcall(fn)
    resetUpdateGate()
    if not okH then
      reportScriptError(label, errH)
    end
  end

  handlerGateWatchdog = Timer.New()
  handlerGateWatchdog.EventHandler = function()
    if handlerMuteDepth ~= 0 then handlerMuteDepth = 0 end
    if isUpdating then
      updateDepth = 0
      isUpdating = false
    end
    if bootComplete and not mirroringNow then
      if mirrorCacheDisagrees() then
        reassertMirrorFromCache()
      end
      applyPressedSelects()
    end
  end
  handlerGateWatchdog:Start(1.0)

  mirroringNow = false

  -- A full sync touches every slot of every column, so the combine groups,
  -- slot strings and per-room source lists are memoised for the duration of
  -- one pass and dropped whenever anything that feeds them changes.
  cacheGroupSetMap = nil
  cacheVisibilityRooms = {}
  cacheVisibleSlots = {}
  cachePool = {}
  cacheSlotLabel = {}
  cacheSlotOutput = {}

  function invalidateCaches()
    cacheGroupSetMap = nil
    cacheVisibilityRooms = {}
    cacheVisibleSlots = {}
    cachePool = {}
    cacheSlotLabel = {}
    cacheSlotOutput = {}
  end

  function invalidateSlotStringCaches()
    cacheSlotLabel = {}
    cacheSlotOutput = {}
    cachePool = {}
  end

  function reportScriptError(prefix, err)
    msg = prefix .. ": " .. tostring(err)
    print("Room Combine Video Routing " .. msg)
    if status then
      status.String = msg
    end
  end

  -- Once per room/output: a short Output pin array means the plugin instance in
  -- the design predates the current property values and needs a re-drag.
  function warnMissingOutputPin(roomIdx, outIdx)
    warnKey = tostring(roomIdx) .. ":" .. tostring(outIdx)
    if warnedOutputPins == nil then warnedOutputPins = {} end
    if warnedOutputPins[warnKey] then return end
    warnedOutputPins[warnKey] = true
    print(
      "Room Combine Video Routing: Room " .. tostring(roomIdx)
        .. " Output " .. tostring(outIdx)
        .. " has no Output pin ("
        .. tostring(outputCtlName(roomIdx, outIdx))
        .. "). Re-drag the plugin."
    )
  end

  function noteFanoutMiss(missedList, roomIdx, outIdx, fanWant)
    fanFlat = outputFlatIndex(roomIdx, outIdx)
    fanCtl = comboCtl(roomIdx, outIdx)
    if fanCtl == nil then
      table.insert(missedList, "R" .. roomIdx .. "O" .. outIdx .. "=<no control>")
    elseif trimString(fanCtl.String) ~= trimString(fanWant) then
      table.insert(missedList, "R" .. roomIdx .. "O" .. outIdx .. "='" .. trimString(fanCtl.String) .. "'")
    end
  end

  function noteSelectMiss(missedList, roomIdx, outIdx, slot)
    selCtl = selectCtl(roomIdx, outIdx, slot)
    if selCtl == nil then
      table.insert(missedList, "R" .. roomIdx .. "O" .. outIdx .. "=<no select>")
    elseif selCtl.Boolean ~= true then
      table.insert(missedList, "R" .. roomIdx .. "O" .. outIdx .. "=off")
    end
  end

  -- Read the whole fan-out back once it has finished and name any target that
  -- did not take the route. Silent on a healthy system; the one thing that can
  -- tell us what Designer actually did when a mirror does not arrive.
  function verifyMirrorFanout(fromRoomIdx, fromOutIdx, slot, includeSelects)
    if slot == nil then return end
    fanWant = getSlotLabel(slot)
    fanMissed = {}
    selMissed = {}
    if isRoomMirrorEnabled(fromRoomIdx) then
      for outIdx = 1, getOutputsPerRoom() do
        noteFanoutMiss(fanMissed, fromRoomIdx, outIdx, fanWant)
        if includeSelects then noteSelectMiss(selMissed, fromRoomIdx, outIdx, slot) end
      end
      for _, linkedRoom in ipairs(copyRoomList(getMirrorLinkedRooms(fromRoomIdx))) do
        for outIdx = 1, getOutputsPerRoom() do
          noteFanoutMiss(fanMissed, linkedRoom, outIdx, fanWant)
          if includeSelects then noteSelectMiss(selMissed, linkedRoom, outIdx, slot) end
        end
      end
    end
    if isRoomOutputMirrorEnabled(fromRoomIdx, fromOutIdx) then
      noteFanoutMiss(fanMissed, fromRoomIdx, fromOutIdx, fanWant)
      if includeSelects then noteSelectMiss(selMissed, fromRoomIdx, fromOutIdx, slot) end
      for _, linkedRoom in ipairs(copyRoomList(getOutputMirrorLinkedRooms(fromRoomIdx, fromOutIdx))) do
        noteFanoutMiss(fanMissed, linkedRoom, fromOutIdx, fanWant)
        if includeSelects then noteSelectMiss(selMissed, linkedRoom, fromOutIdx, slot) end
      end
    end
    if #fanMissed > 0 then
      print(
        "Room Combine Video Routing: mirror '" .. tostring(fanWant)
          .. "' from R" .. tostring(fromRoomIdx) .. "O" .. tostring(fromOutIdx)
          .. " missed combo " .. table.concat(fanMissed, " ")
      )
    end
    if #selMissed > 0 then
      print(
        "Room Combine Video Routing: mirror '" .. tostring(fanWant)
          .. "' from R" .. tostring(fromRoomIdx) .. "O" .. tostring(fromOutIdx)
          .. " missed select " .. table.concat(selMissed, " ")
      )
    end
  end

  function trimString(text)
    if text == nil then return "" end
    return (string.match(text, "^%s*(.-)%s*$"))
  end

  function clampInt(value, minVal, maxVal)
    n = math.floor((tonumber(value) or minVal) + 0.5)
    if n < minVal then n = minVal end
    if n > maxVal then n = maxVal end
    return n
  end

  -- The control arrays were sized from these same properties at design time,
  -- so the runtime reads them through the shared derivation path and then
  -- serves every query from the cached dimensions. Refreshed on each full
  -- sync, which is the only point at which a property change can reach us.
  function refreshActiveDimensions()
    return applyActiveDimensions(Properties)
  end

  function getRoomCount()
    return ACTIVE_ROOM_COUNT
  end

  function getSourcesPerRoom()
    return ACTIVE_SOURCES_PER_ROOM
  end

  function getOutputsPerRoom()
    return ACTIVE_OUTPUTS_PER_ROOM
  end

  function getGlobalSourceCount()
    return ACTIVE_GLOBAL_COUNT
  end

  -- Skip the write when the control is already in the requested state. Full
  -- layout syncs used to re-assign IsInvisible thousands of times per pass.
  function setControlInvisible(ctl, hide)
    if not ctl then return end
    want = hide and true or false
    if ctl.IsInvisible == want then return end
    ctl.IsInvisible = want
  end

  function setControlStringIfChanged(ctl, text)
    if not ctl then return end
    if ctl.String == text then return end
    ctl.String = text
  end

  -- Shared slot values ------------------------------------------------------
  -- One Labels / OutputStrings control per AV slot (not per room/out).
  -- Select buttons are rm#Out#Rm#Src / rm#Out#Global arrays. page_index is
  -- for Designer tabs / preferRoom only — never for mass IsInvisible.

  -- Read live page_index (Power Controls pattern) with activePageIdx fallback.
  function currentPageIndex()
    pageIdx = nil
    if Properties and Properties["page_index"] then
      pageIdx = Properties["page_index"].Value
    end
    if pageIdx == nil then
      pageIdx = activePageIdx
    end
    return resolvedPageIndex(pageIdx)
  end

  function viewedRoomIdx()
    return roomIndexFromPageIndex(currentPageIndex(), getRoomCount())
  end

  -- Each output owns its srcSel bank, so a latch never stamps another column
  -- or tab. page_index still does not follow the control-panel tab: remember
  -- which room the user just operated so Setup / stuck page_index can latch it.
  lastInteractedRoom = nil

  function noteRoomInteraction(roomIdx)
    if roomIdx == nil then return end
    if roomIdx < 1 or roomIdx > getRoomCount() then return end
    lastInteractedRoom = roomIdx
  end

  function paintRoomIdx()
    viewRoom = viewedRoomIdx()
    if viewRoom then return viewRoom end
    if lastInteractedRoom == nil then return nil end
    if lastInteractedRoom > getRoomCount() then return nil end
    return lastInteractedRoom
  end

  function canonicalLabelControl(slot)
    if sharedSlotIndex(slot) == nil then return nil end
    return sourceLabelCtlFrom(Controls, slot)
  end

  function canonicalOutputControl(slot)
    sharedIdx = sharedSlotIndex(slot)
    if sharedIdx == nil then return nil end
    return roomOutputOutputStrings[sharedIdx]
  end

  function getSlotLabel(slot)
    if cacheSlotLabel[slot] == nil then
      ctl = canonicalLabelControl(slot)
      label = ctl and trimString(ctl.String) or ""
      if label == "" then label = defaultLabelForSlot(slot) end
      cacheSlotLabel[slot] = label
    end
    return cacheSlotLabel[slot]
  end

  function getSlotOutput(slot)
    if cacheSlotOutput[slot] == nil then
      ctl = canonicalOutputControl(slot)
      out = ctl and trimString(ctl.String) or ""
      if out == "" then out = avStringForSlot(slot) end
      cacheSlotOutput[slot] = out
    end
    return cacheSlotOutput[slot]
  end

  function setSlotLabel(slot, text)
    ctl = canonicalLabelControl(slot)
    if ctl then ctl.String = text end
    invalidateSlotStringCaches()
  end

  function setSlotOutput(slot, text)
    ctl = canonicalOutputControl(slot)
    if ctl then ctl.String = text end
    invalidateSlotStringCaches()
  end

  -- No-op stubs: Labels/OutputStrings are shared (nothing to fan out).
  function fanOutSlot(slot)
  end

  function fanOutAllSlots()
  end

  function fanOutAllSlotsMax()
  end

  function fanOutSlotToRoom(slot, roomIdx)
  end

  function dimensionFingerprint()
    return string.format(
      "%d|%d|%d|%d",
      ACTIVE_ROOM_COUNT,
      ACTIVE_SOURCES_PER_ROOM,
      ACTIVE_OUTPUTS_PER_ROOM,
      ACTIVE_GLOBAL_COUNT
    )
  end

  -- Seed auto labels and dense OutputStrings on the shared controls.
  -- Format follows setupOutputStringFormat (Name "AV N" / Number "N").
  -- Must run outside suppressing()/isUpdating.
  function applyCanonicalSlotDefaults()
    for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
      labelCtl = canonicalLabelControl(avSlot)
      outputCtl = canonicalOutputControl(avSlot)
      if labelCtl and isAutoLabelString(labelCtl.String) then
        labelCtl.String = defaultLabelForSlot(avSlot)
      end
      if outputCtl and isAutoAvOutputString(outputCtl.String) then
        outputCtl.String = defaultOutputStringForSlot(avSlot)
      end
    end
    invalidateSlotStringCaches()
  end

  -- setupOutputStringFormat Legend: true→"Name", false→"Number".
  -- Fresh controls start Boolean=false with blank Legend; seed Name (true)
  -- once so dense "AV N" remains the product default.
  function syncOutputStringFormatLegend(seedDefault)
    if not setupOutputStringFormat then return end
    legendNow = tostring(setupOutputStringFormat.Legend or "")
    legendNow = string.match(legendNow, "^%s*(.-)%s*$") or ""
    if seedDefault and legendNow == "" then
      setupOutputStringFormat.Boolean = true
    end
    if setupOutputStringFormat.Boolean then
      setupOutputStringFormat.Legend = "Name"
    else
      setupOutputStringFormat.Legend = "Number"
    end
  end

  -- Re-seed auto OutputStrings for the current format and fan into pins.
  -- Custom (non AV-N / non plain-N) strings are left alone.
  function applyOutputStringFormatMode()
    syncOutputStringFormatLegend(false)
    muteHandlers(function()
      applyCanonicalSlotDefaults()
    end)
    invalidateCaches()
    muteHandlers(function()
      refreshAllOutputColumns()
      syncGlobalOutputPins(nil)
    end)
  end

  -- Always assign Legend: Designer may keep a stale faceplate value after
  -- Style=None -> Button page transitions even when Lua already matches.
  -- Unconditional on purpose. Designer re-applies the design-time Legend when a
  -- tab becomes visible without telling the script, so selCtl.Legend can read
  -- back as already correct while the faceplate shows the old text. Skipping the
  -- write on a match leaves those legends stale forever.
  function writeSelectLegend(selCtl, text)
    if not selCtl then return false end
    selCtl.Legend = text
    return true
  end

  -- Select Legends for every per-room Select (+ Global tab Selects).
  -- Must run outside suppressing()/isUpdating so Designer keeps the writes.
  function syncAllSelectLegends()
    legendCount = 0
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, getOutputsPerRoom() do
        for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
          selCtl = selectCtl(roomIdx, outIdx, avSlot)
          if writeSelectLegend(selCtl, getSlotLabel(avSlot)) then
            legendCount = legendCount + 1
          end
        end
      end
    end
    for globalIdx = 1, getGlobalSourceCount() do
      selCtl = globalSourceControls[globalIdx]
      if writeSelectLegend(selCtl, getSlotLabel(globalSlotIndex(globalIdx))) then
        legendCount = legendCount + 1
      end
    end
    for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
      sharedIdx = sharedSlotIndex(avSlot)
      if writeSelectLegend(setupSrcSelCtl(sharedIdx), getSlotLabel(avSlot)) then
        legendCount = legendCount + 1
      end
    end
    return legendCount
  end

  function syncViewedSelectLegends()
    return syncAllSelectLegends()
  end

  function syncRoomSelectLegends(roomIdx)
    if roomIdx == nil then
      return syncAllSelectLegends()
    end
    legendCount = 0
    for outIdx = 1, getOutputsPerRoom() do
      for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
        selCtl = selectCtl(roomIdx, outIdx, avSlot)
        if writeSelectLegend(selCtl, getSlotLabel(avSlot)) then
          legendCount = legendCount + 1
        end
      end
    end
    return legendCount
  end

  -- One AV slot's shared Label changed: push Legend to every room/out Select.
  function syncSelectLegendsForSlot(avSlot)
    if avSlot == nil then return 0 end
    label = getSlotLabel(avSlot)
    wrote = 0
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, getOutputsPerRoom() do
        selCtl = selectCtl(roomIdx, outIdx, avSlot)
        if writeSelectLegend(selCtl, label) then
          wrote = wrote + 1
        end
      end
    end
    if slotIsGlobal(avSlot) then
      globalIdx = slotGlobalIndex(avSlot)
      selCtl = globalIdx and globalSourceControls[globalIdx]
      if writeSelectLegend(selCtl, label) then
        wrote = wrote + 1
      end
    end
    sharedIdx = sharedSlotIndex(avSlot)
    if writeSelectLegend(setupSrcSelCtl(sharedIdx), label) then
      wrote = wrote + 1
    end
    return wrote
  end

  lastNameSyncSlot = nil
  lastNameSyncLegends = 0

  function flashNameSyncStatus(avSlot, legendsWritten)
    lastNameSyncSlot = avSlot
    lastNameSyncLegends = legendsWritten or 0
    if not status then return end
    status.String = string.format(
      "name sync legends=%d | v%s | rooms %d",
      lastNameSyncLegends,
      PluginInfo.Version,
      getRoomCount()
    )
  end

  -- Designer may re-apply design-time Legend when a Room tab becomes visible
  -- (Style=None -> Button). Re-push live Label Strings after page changes.
  function scheduleFaceplateNameRefresh(preferRoomIdx)
    Timer.CallAfter(function()
      if not bootComplete then return end
      resetUpdateGate()
      invalidateSlotStringCaches()
      wrote = 0
      muteHandlers(function()
        if preferRoomIdx then
          syncRoomSelectLegends(preferRoomIdx)
        end
        wrote = syncAllSelectLegends()
      end)
      if lastNameSyncSlot ~= nil then
        flashNameSyncStatus(lastNameSyncSlot, lastNameSyncLegends)
      elseif status then
        status.String = string.format(
          "name sync legends=%d | v%s",
          wrote,
          PluginInfo.Version
        )
      end
    end, 0)
    Timer.CallAfter(function()
      if not bootComplete then return end
      resetUpdateGate()
      invalidateSlotStringCaches()
      wrote = 0
      muteHandlers(function()
        if preferRoomIdx then
          syncRoomSelectLegends(preferRoomIdx)
        end
        wrote = syncAllSelectLegends()
      end)
      if lastNameSyncSlot ~= nil then
        flashNameSyncStatus(lastNameSyncSlot, lastNameSyncLegends)
      elseif status then
        status.String = string.format(
          "name sync legends=%d | v%s",
          wrote,
          PluginInfo.Version
        )
      end
    end, 0.05)
  end

  -- Immediate Label -> Select Legend + combo Choices (shared Labels only).
  -- Do not wait on scheduleDeferredLayout (blocked when isUpdating is stuck).
  function propagateSlotNameChange(avSlot, text)
    if text ~= nil then
      text = trimString(text)
      if text == "" then text = defaultLabelForSlot(avSlot) end
      setSlotLabel(avSlot, text)
    else
      invalidateSlotStringCaches()
    end
    legendsWritten = 0
    muteHandlers(function()
      legendsWritten = syncSelectLegendsForSlot(avSlot)
    end)
    buildAllComboLists()
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, getOutputsPerRoom() do
        if getRoutedSlot(roomIdx, outIdx) == avSlot then
          refreshOutputColumn(roomIdx, outIdx)
        end
      end
    end
    flashNameSyncStatus(avSlot, legendsWritten)
    scheduleFaceplateNameRefresh(viewedRoomIdx())
    return legendsWritten
  end

  -- Force Select Legends from shared Labels (page switch / Style=None quirk).
  function refreshSelectLegendsForPage()
    resetUpdateGate()
    invalidateSlotStringCaches()
    viewRoom = viewedRoomIdx()
    wrote = 0
    muteHandlers(function()
      if viewRoom then
        syncRoomSelectLegends(viewRoom)
      end
      wrote = syncAllSelectLegends()
    end)
    if status then
      status.String = string.format(
        "name sync legends=%d | v%s",
        wrote,
        PluginInfo.Version
      )
    end
    scheduleFaceplateNameRefresh(viewRoom)
    return wrote
  end

  -- Shared Label / OutputString seed + per-room Select Legends.
  lastLabelsSeeded = 0
  pendingSlotStringRooms = {}
  function populateSlotStrings(toMaxExtents, preferRoomIdx)
    if isUpdating then
      return
    end
    muteHandlers(function()
      applyCanonicalSlotDefaults()
      syncAllSelectLegends()
      pendingSlotStringRooms = {}
      invalidateCaches()
    end)
    seeded = 0
    for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
      labelCtl = canonicalLabelControl(avSlot)
      if labelCtl and trimString(labelCtl.String) ~= "" then
        seeded = seeded + 1
      end
    end
    lastLabelsSeeded = seeded
  end

  function flushPendingRoomSlotStrings(roomIdx)
    if isUpdating then return end
    muteHandlers(function()
      if roomIdx then
        syncRoomSelectLegends(roomIdx)
      else
        syncAllSelectLegends()
      end
      invalidateCaches()
    end)
    if roomIdx then pendingSlotStringRooms[roomIdx] = nil end
  end

  -- globalOutput is Count=GlobalSourceCount (array) or a Count=1 placeholder.
  function globalOutputControl(globalIdx)
    return indexedControl(globalOutputPins, globalIdx)
  end

  -- Mirror each configured global's OutputString onto its pin. Faceplate
  -- stacks every pin at the summary position; only the selected one is shown.
  function syncGlobalOutputPins(selectedSlot)
    globalCount = getGlobalSourceCount()
    if globalCount <= 0 then
      ctl = globalOutputControl(1)
      if ctl then
        ctl.String = ""
        setControlInvisible(ctl, true)
      end
      return
    end
    showIdx = 1
    if selectedSlot and slotIsGlobal(selectedSlot) then
      showIdx = slotGlobalIndex(selectedSlot)
    end
    for globalIdx = 1, globalCount do
      ctl = globalOutputControl(globalIdx)
      if ctl then
        ctl.String = getSlotOutput(globalSlotIndex(globalIdx))
        setControlInvisible(ctl, globalIdx ~= showIdx)
      end
    end
  end

  function syncPropertyPins()
    if Controls.propertiesRoomCount then
      Controls.propertiesRoomCount.String = tostring(getRoomCount())
    end
    if Controls.propertiesSourcesPerRoom then
      Controls.propertiesSourcesPerRoom.String = tostring(getSourcesPerRoom())
    end
    if Controls.propertiesOutputsPerRoom then
      Controls.propertiesOutputsPerRoom.String = tostring(getOutputsPerRoom())
    end
    if Controls.propertiesGlobalSourceCount then
      Controls.propertiesGlobalSourceCount.String = tostring(getGlobalSourceCount())
    end
  end

  -- Room combiner -----------------------------------------------------------

  function tryGetNamedControl(comp, name)
    if not comp or not name then return nil end
    success, control = pcall(function() return comp[name] end)
    if success and control ~= nil then return control end
    return nil
  end

  function scanRoomCombiners()
    roomCombiners = {}
    comps = Component.GetComponents() or {}
    for _, comp in ipairs(comps) do
      if comp.Type == "room_combiner" and comp.Name and comp.Name ~= "" then
        table.insert(roomCombiners, comp.Name)
      end
    end
    if setupRoomCombiner then
      setupRoomCombiner.Choices = roomCombiners
    end
  end

  function findConfigurationControl(comp)
    names = {
      "room.combiner.output.configuration",
      "rooms.output.configuration",
      "output.configuration",
      "configuration",
      "Configuration",
    }
    for _, name in ipairs(names) do
      control = tryGetNamedControl(comp, name)
      if control then return control end
    end
    return nil
  end

  -- Room combiner firmware has shipped both dotted and spaced control names,
  -- so probe each generation before giving up on a wall index.
  function findWallOpenControl(comp, wallIdx)
    return tryGetNamedControl(comp, "wall." .. wallIdx .. ".open")
      or tryGetNamedControl(comp, "Wall " .. wallIdx .. " Open")
  end

  function findWallConfigControl(comp, wallIdx)
    return tryGetNamedControl(comp, "wall." .. wallIdx .. ".rooms")
      or tryGetNamedControl(comp, "wall." .. wallIdx .. ".configure")
      or tryGetNamedControl(comp, "Wall " .. wallIdx .. " Configure")
      or tryGetNamedControl(comp, "Wall " .. wallIdx .. " Rooms")
  end

  -- Snapshot of the Room Combiner's live combine state. Any change here must
  -- rebuild every room combo list and re-apply Select/Label/Output show/hide.
  function combinerFingerprint()
    fpParts = {}
    if configControl then
      table.insert(fpParts, "c:" .. tostring(configControl.String or ""))
    else
      table.insert(fpParts, "c:")
    end
    for idx, openCtl in ipairs(wallOpenControls) do
      openBit = "0"
      if openCtl and openCtl.Boolean then openBit = "1" end
      cfgStr = ""
      if wallConfigControls[idx] then
        cfgStr = tostring(wallConfigControls[idx].String or "")
      end
      table.insert(fpParts, "w" .. idx .. ":" .. openBit .. ":" .. cfgStr)
    end
    return table.concat(fpParts, "|")
  end

  function markCombinerDirty()
    combinerDirty = true
  end

  -- Forced rebuild on wall open / wall configure / output.configuration.
  function onRoomCombinationChanged()
    markCombinerDirty()
    if not bootComplete then return end
    onSourceVisibilityChanged()
    applyCurrentMirrorAllRooms()
    for outIdx = 1, getOutputsPerRoom() do
      applyCurrentOutputMirrorAllRooms(outIdx)
    end
    lastCombinerFingerprint = combinerFingerprint()
    combinerDirty = false
  end

  -- Poll path: catch combine updates that did not fire an EventHandler.
  function pollCombinerChanges()
    if not bootComplete then return end
    fp = combinerFingerprint()
    if combinerDirty or fp ~= lastCombinerFingerprint then
      onRoomCombinationChanged()
    end
  end

  function discoverCombinerControls(comp)
    wallOpenControls = {}
    wallConfigControls = {}
    if not comp then return end
    for wallIdx = 1, 64 do
      openCtl = findWallOpenControl(comp, wallIdx)
      cfgCtl = findWallConfigControl(comp, wallIdx)
      if openCtl or cfgCtl then
        table.insert(wallOpenControls, openCtl)
        table.insert(wallConfigControls, cfgCtl)
      elseif wallIdx > 1 then
        break
      end
    end
    for idx, openCtl in ipairs(wallOpenControls) do
      if openCtl then
        openCtl.EventHandler = onRoomCombinationChanged
      end
      if wallConfigControls[idx] then
        wallConfigControls[idx].EventHandler = onRoomCombinationChanged
      end
    end
  end

  function combinerIsValid(compName)
    if not compName or compName == "" or compName == "None Selected" then return false end
    for idx = 1, #roomCombiners do
      if compName == roomCombiners[idx] then return true end
    end
    return false
  end

  function setRoomCombiner(compName)
    scanRoomCombiners()
    configControl = nil
    wallOpenControls = {}
    wallConfigControls = {}
    lastCombinerFingerprint = ""
    combinerDirty = true
    if combinerIsValid(compName) then
      success, comp = pcall(Component.New, compName)
      if success and comp then
        configControl = findConfigurationControl(comp)
        if configControl then
          configControl.EventHandler = onRoomCombinationChanged
        end
        discoverCombinerControls(comp)
        setupDefaultRC.String = compName
        setupRoomCombiner.String = compName
      end
    else
      setupDefaultRC.String = "None Selected"
    end
    -- During boot, handleLayoutChange runs once bootComplete is set. After
    -- boot, rebinding the combiner must immediately rebuild combo lists and
    -- re-apply show/hide from the live configuration.
    if bootComplete then
      onRoomCombinationChanged()
    end
  end

  -- Combine groups ----------------------------------------------------------

  function buildDefaultGroups()
    groups = {}
    for roomIdx = 1, getRoomCount() do
      table.insert(groups, { roomIdx })
    end
    return groups
  end

  function parseRoomsExpression(expr)
    result = {}
    exclude = {}
    includeAll = false
    activeRooms = getRoomCount()
    expr = string.gsub(tostring(expr or ""), "[+,]", " ")
    for token in string.gmatch(expr, "%S+") do
      if token == "*" then
        includeAll = true
      elseif string.sub(token, 1, 1) == "!" or string.sub(token, 1, 1) == "~" then
        num = tonumber(string.sub(token, 2))
        if num then exclude[num] = true end
      else
        a, b = string.match(token, "^(%d+)[%>%-](%d+)$")
        if a then
          for i = tonumber(a), tonumber(b) do table.insert(result, i) end
        else
          num = tonumber(token)
          if num then table.insert(result, num) end
        end
      end
    end
    filtered = {}
    if includeAll then
      for i = 1, activeRooms do
        if not exclude[i] then table.insert(filtered, i) end
      end
    else
      for _, r in ipairs(result) do
        if not exclude[r] and r >= 1 and r <= activeRooms then table.insert(filtered, r) end
      end
    end
    return filtered
  end

  function normalizeDecodedGroups(decoded)
    if type(decoded) ~= "table" then return nil end
    activeRooms = getRoomCount()
    groups = {}
    for _, group in ipairs(decoded) do
      if type(group) == "table" then
        normalized = {}
        for _, roomIdx in ipairs(group) do
          rIdx = tonumber(roomIdx)
          if rIdx and rIdx >= 1 and rIdx <= activeRooms then
            table.insert(normalized, math.floor(rIdx))
          end
        end
        if #normalized > 0 then table.insert(groups, normalized) end
      end
    end
    if #groups == 0 then return nil end
    return groups
  end

  function decodeJsonGroups(rawJsonString)
    if not json or not json.decode then return nil end
    rawJsonString = trimString(rawJsonString)
    if rawJsonString == "" then return nil end
    success, decoded = pcall(json.decode, rawJsonString)
    if not success then return nil end
    return normalizeDecodedGroups(decoded)
  end

  function buildGroupsFromOpenWalls()
    activeRooms = getRoomCount()
    parent = {}
    for i = 1, activeRooms do parent[i] = i end
    function rcvrFindRoot(x)
      while parent[x] ~= x do
        parent[x] = parent[parent[x]]
        x = parent[x]
      end
      return x
    end
    function rcvrUnite(a, b)
      ra = rcvrFindRoot(a)
      rb = rcvrFindRoot(b)
      if ra ~= rb then parent[rb] = ra end
    end
    for idx, openCtl in ipairs(wallOpenControls) do
      if openCtl and openCtl.Boolean then
        cfg = wallConfigControls[idx]
        wallRoomList = parseRoomsExpression(cfg and cfg.String or "")
        for i = 2, #wallRoomList do rcvrUnite(wallRoomList[1], wallRoomList[i]) end
      end
    end
    buckets = {}
    order = {}
    for i = 1, activeRooms do
      root = rcvrFindRoot(i)
      if not buckets[root] then
        buckets[root] = {}
        table.insert(order, root)
      end
      table.insert(buckets[root], i)
    end
    groups = {}
    for _, root in ipairs(order) do table.insert(groups, buckets[root]) end
    return groups
  end

  -- Prefer the combiner's resolved configuration string. Wall controls are
  -- often present even when every wall is closed, and treating "walls exist"
  -- as authoritative left Visibility stuck on the default singleton groups
  -- while the JSON already described the real combine state.
  function getActiveGroups()
    if configControl then
      groups = decodeJsonGroups(configControl.String)
      if groups then
        lastGroupSource = "json"
        return groups
      end
    end
    if #wallOpenControls > 0 then
      lastGroupSource = "walls"
      return buildGroupsFromOpenWalls()
    end
    lastGroupSource = "default"
    return buildDefaultGroups()
  end

  function groupsToSetMap(activeGroups)
    setMap = {}
    for _, group in ipairs(activeGroups) do
      if type(group) == "table" then
        groupSet = {}
        for _, roomIdx in ipairs(group) do
          rIdx = tonumber(roomIdx)
          if rIdx then groupSet[rIdx] = true end
        end
        for _, roomIdx in ipairs(group) do
          rIdx = tonumber(roomIdx)
          if rIdx then setMap[rIdx] = groupSet end
        end
      end
    end
    for roomIdx = 1, getRoomCount() do
      if not setMap[roomIdx] then setMap[roomIdx] = { [roomIdx] = true } end
    end
    return setMap
  end

  function getGroupSetMap()
    if cacheGroupSetMap == nil then
      cacheGroupSetMap = groupsToSetMap(getActiveGroups())
    end
    return cacheGroupSetMap
  end

  function getCombineGroupRooms(roomIdx)
    setMap = getGroupSetMap()
    group = setMap[roomIdx] or { [roomIdx] = true }
    -- Distinct from numeric loop bounds named `rooms` / `roomCount`.
    combineRooms = { roomIdx }
    for srcRoom = 1, getRoomCount() do
      if group[srcRoom] and srcRoom ~= roomIdx then
        table.insert(combineRooms, srcRoom)
      end
    end
    return combineRooms
  end


  -- Room options ------------------------------------------------------------

  function isRoomGlobalEnabled(roomIdx)
    ctl = roomOptionGlobal[roomIdx]
    return ctl ~= nil and ctl.Boolean == true
  end

  function isRoomVisibilityEnabled(roomIdx)
    ctl = roomOptionVisibility[roomIdx]
    return ctl ~= nil and ctl.Boolean == true
  end

  function isRoomMirrorEnabled(roomIdx)
    ctl = roomOptionMirror[roomIdx]
    return ctl ~= nil and ctl.Boolean == true
  end

  function roomOutputMirrorCtl(roomIdx, outIdx)
    name = roomOutputMirrorCtlName(roomIdx, outIdx)
    if Controls == nil or name == nil then return nil end
    return safeIndex(Controls, name)
  end

  function isRoomOutputMirrorEnabled(roomIdx, outIdx)
    ctl = roomOutputMirrorCtl(roomIdx, outIdx)
    return ctl ~= nil and ctl.Boolean == true
  end

  function anyRoomMirrorOn(roomIdx)
    if isRoomMirrorEnabled(roomIdx) then return true end
    for outIdx = 1, getOutputsPerRoom() do
      if isRoomOutputMirrorEnabled(roomIdx, outIdx) then return true end
    end
    return false
  end

  -- Mirror All true => Mirror 1–N false. Turning Mirror N on clears All.
  function setRoomPerOutputMirrors(roomIdx, wantOn)
    for outIdx = 1, getOutputsPerRoom() do
      mOutCtl = roomOutputMirrorCtl(roomIdx, outIdx)
      if mOutCtl then
        mOutCtl.Boolean = wantOn
      end
    end
  end

  function setAllPerOutputMirrors(wantOn)
    for roomIdx = 1, getRoomCount() do
      setRoomPerOutputMirrors(roomIdx, wantOn)
    end
    if setupMirrorOut then
      for outIdx = 1, getOutputsPerRoom() do
        mSetup = setupMirrorOutCtl(outIdx)
        if mSetup then
          mSetup.Boolean = wantOn
        end
      end
    end
  end

  function roomOutputGlobalCtl(roomIdx, outIdx)
    flatOut = outputFlatIndex(roomIdx, outIdx)
    if not flatOut or not roomOptionGlobalOut then return nil end
    return roomOptionGlobalOut[flatOut]
  end

  function isRoomOutputGlobalEnabled(roomIdx, outIdx)
    ctl = roomOutputGlobalCtl(roomIdx, outIdx)
    if ctl == nil then
      return isRoomGlobalEnabled(roomIdx)
    end
    return ctl.Boolean == true
  end

  -- Global All drives Global 1–N to the same Boolean (on or off).
  function setRoomPerOutputGlobals(roomIdx, wantOn)
    for outIdx = 1, getOutputsPerRoom() do
      gOutCtl = roomOutputGlobalCtl(roomIdx, outIdx)
      if gOutCtl then
        gOutCtl.Boolean = wantOn
      end
    end
  end

  function setAllPerOutputGlobals(wantOn)
    for roomIdx = 1, getRoomCount() do
      setRoomPerOutputGlobals(roomIdx, wantOn)
    end
    if setupGlobalOut then
      for outIdx = 1, getOutputsPerRoom() do
        gSetup = setupGlobalOutCtl(outIdx)
        if gSetup then
          gSetup.Boolean = wantOn
        end
      end
    end
  end

  function getVisibilitySourceRooms(roomIdx)
    if cacheVisibilityRooms[roomIdx] == nil then
      visAcc = {}
      visSeen = {}
      if isRoomVisibilityEnabled(roomIdx) then
        for _, srcRoom in ipairs(getCombineGroupRooms(roomIdx)) do
          if not visSeen[srcRoom] then
            visSeen[srcRoom] = true
            table.insert(visAcc, srcRoom)
          end
        end
      else
        visSeen[roomIdx] = true
        table.insert(visAcc, roomIdx)
      end
      -- Combined rooms already sit in visAcc when Visibility is on (Mirror
      -- All forces Vis). Only add extra peers from this room's combine group.
      if isRoomMirrorEnabled(roomIdx) then
        for _, srcRoom in ipairs(getMirrorLinkedRooms(roomIdx)) do
          if not visSeen[srcRoom] then
            visSeen[srcRoom] = true
            table.insert(visAcc, srcRoom)
          end
        end
      end
      for outIdx = 1, getOutputsPerRoom() do
        if isRoomOutputMirrorEnabled(roomIdx, outIdx) then
          for _, srcRoom in ipairs(getOutputMirrorLinkedRooms(roomIdx, outIdx)) do
            if not visSeen[srcRoom] then
              visSeen[srcRoom] = true
              table.insert(visAcc, srcRoom)
            end
          end
        end
      end
      cacheVisibilityRooms[roomIdx] = visAcc
    end
    return cacheVisibilityRooms[roomIdx]
  end

  -- True when every configured room has Mirror All on.
  function allRoomsMirrorEnabled()
    for roomIdx = 1, getRoomCount() do
      if not isRoomMirrorEnabled(roomIdx) then
        return false
      end
    end
    return true
  end

  -- Mirror All peers: other rooms in this room's combination that also have
  -- Mirror All on. An uncombined room has no peers, so All only copies
  -- across that room's own outputs.
  function getMirrorLinkedRooms(roomIdx)
    mirrorRooms = {}
    if not isRoomMirrorEnabled(roomIdx) then
      return mirrorRooms
    end
    for _, srcRoom in ipairs(getCombineGroupRooms(roomIdx)) do
      if srcRoom ~= roomIdx and isRoomMirrorEnabled(srcRoom) then
        table.insert(mirrorRooms, srcRoom)
      end
    end
    return mirrorRooms
  end

  function getOutputMirrorLinkedRooms(roomIdx, outIdx)
    linkedOutRooms = {}
    if not isRoomOutputMirrorEnabled(roomIdx, outIdx) then
      return linkedOutRooms
    end
    for _, srcRoom in ipairs(getCombineGroupRooms(roomIdx)) do
      if srcRoom ~= roomIdx and isRoomOutputMirrorEnabled(srcRoom, outIdx) then
        table.insert(linkedOutRooms, srcRoom)
      end
    end
    return linkedOutRooms
  end

  -- Source pool -------------------------------------------------------------

  function outputCacheKey(roomIdx, outIdx)
    return (roomIdx * 10) + outIdx
  end

  function isSlotVisible(viewRoomIdx, slot, outIdx)
    if slotIsGlobal(slot) then
      if slotGlobalIndex(slot) > getGlobalSourceCount() then
        return false
      end
      if outIdx ~= nil then
        return isRoomOutputGlobalEnabled(viewRoomIdx, outIdx)
      end
      for anyOut = 1, getOutputsPerRoom() do
        if isRoomOutputGlobalEnabled(viewRoomIdx, anyOut) then
          return true
        end
      end
      return false
    end
    if slotLocalIndex(slot) > getSourcesPerRoom() then
      return false
    end
    srcRoom = slotRoomIndex(slot)
    if srcRoom > getRoomCount() then
      return false
    end
    if srcRoom == viewRoomIdx then
      return true
    end
    for _, room in ipairs(getVisibilitySourceRooms(viewRoomIdx)) do
      if room == srcRoom then return true end
    end
    return false
  end

  -- Slots one output column can currently offer, in row order: this room,
  -- then the other rooms, then the globals (when Global N is on).
  function visibleSlotsForOutput(viewRoomIdx, outIdx)
    cacheKey = outputCacheKey(viewRoomIdx, outIdx)
    if cacheVisibleSlots[cacheKey] == nil then
      visSlots = {}
      orderedSlots = orderedLocalSlots(viewRoomIdx, getRoomCount(), getSourcesPerRoom())
      for _, orderedSlot in ipairs(orderedSlots) do
        if isSlotVisible(viewRoomIdx, orderedSlot, outIdx) then
          table.insert(visSlots, orderedSlot)
        end
      end
      for globalIdx = 1, getGlobalSourceCount() do
        if isSlotVisible(viewRoomIdx, globalSlotIndex(globalIdx), outIdx) then
          table.insert(visSlots, globalSlotIndex(globalIdx))
        end
      end
      cacheVisibleSlots[cacheKey] = visSlots
    end
    return cacheVisibleSlots[cacheKey]
  end

  function visibleSlotsForRoom(viewRoomIdx)
    return visibleSlotsForOutput(viewRoomIdx, 1)
  end

  function buildSourcePool(viewRoomIdx, outIdx)
    if outIdx == nil then outIdx = 1 end
    cacheKey = outputCacheKey(viewRoomIdx, outIdx)
    if cachePool[cacheKey] == nil then
      pool = {}
      for _, slot in ipairs(visibleSlotsForOutput(viewRoomIdx, outIdx)) do
        table.insert(pool, { slot = slot, label = getSlotLabel(slot), output = getSlotOutput(slot) })
      end
      cachePool[cacheKey] = pool
    end
    return cachePool[cacheKey]
  end

  function poolChoices(pool)
    choices = {}
    for _, entry in ipairs(pool) do
      table.insert(choices, entry.label)
    end
    return choices
  end

  -- Fresh table per control: Designer sometimes ignores Choices when the
  -- assigned table identity is unchanged between refreshes.
  function copyChoiceList(choices)
    copied = {}
    for idx = 1, #choices do
      copied[idx] = choices[idx]
    end
    return copied
  end

  function controlIsShown(ctl)
    if ctl == nil then return false end
    if ctl.IsInvisible == true then return false end
    return true
  end

  -- Combo Choices must match the Select rows currently shown for that room.
  function choicesFromVisibleSourceRows(roomIdx, outIdx)
    choiceList = {}
    orderedSlots = orderedLocalSlots(roomIdx, getRoomCount(), getSourcesPerRoom())
    for _, slot in ipairs(orderedSlots) do
      rowShown = isSlotVisible(roomIdx, slot, outIdx)
      selCtl = selectCtl(roomIdx, outIdx, slot)
      if selCtl and selCtl.IsInvisible == true then
        rowShown = false
      end
      if rowShown then
        table.insert(choiceList, getSlotLabel(slot))
      end
    end
    for globalIdx = 1, getGlobalSourceCount() do
      slot = globalSlotIndex(globalIdx)
      rowShown = isSlotVisible(roomIdx, slot, outIdx)
      selCtl = selectCtl(roomIdx, outIdx, slot)
      if selCtl and selCtl.IsInvisible == true then
        rowShown = false
      end
      if rowShown then
        table.insert(choiceList, getSlotLabel(slot))
      end
    end
    return choiceList
  end

  function choiceListsEqual(a, b)
    if a == nil or b == nil then return false end
    if #a ~= #b then return false end
    for idx = 1, #a do
      if a[idx] ~= b[idx] then return false end
    end
    return true
  end

  -- Q-SYS keeps the old dropdown items when Choices is replaced but String is
  -- unchanged. Blank String, clear Choices, assign the new list, then restore.
  -- Skip entirely when the list and selection are already correct.
  -- Never write String/Choices while isUpdating — Designer drops those commits.
  function forceSetChoices(ctl, choices, preferLabel)
    if not ctl then return end
    keep = trimString(ctl.String)
    if keep == "" and preferLabel then
      keep = trimString(preferLabel)
    end
    resolved = ""
    inList = false
    for idx = 1, #choices do
      if choices[idx] == keep then
        inList = true
        break
      end
    end
    if inList then
      resolved = keep
    elseif preferLabel and trimString(preferLabel) ~= "" then
      resolved = trimString(preferLabel)
      table.insert(choices, resolved)
    elseif #choices > 0 then
      resolved = choices[1]
    end
    if choiceListsEqual(ctl.Choices, choices) and trimString(ctl.String) == resolved then
      return
    end
    muteHandlers(function()
      ctl.String = ""
    end)
    ctl.Choices = {}
    ctl.Choices = copyChoiceList(choices)
    muteHandlers(function()
      ctl.String = resolved
    end)
  end

  -- Sole writer for room/global combo lists. Uses the same visibility pool as
  -- the Select rows (isSlotVisible), so Choices track every show/hide change.
  function buildAllComboLists()
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, getOutputsPerRoom() do
        routePool = buildSourcePool(roomIdx, outIdx)
        cachedSlot = cachedRoutedSlot(roomIdx, outIdx)
        preferLabel = nil
        -- Mirror N was excluded here: when a peer room left this output's
        -- visible pool the mirrored source vanished from Choices and
        -- forceSetChoices snapped the column to choices[1] (that room's Src 1).
        if anyRoomMirrorOn(roomIdx) and cachedSlot then
          routePool = ensurePoolHasSlot(routePool, cachedSlot)
          preferLabel = getSlotLabel(cachedSlot)
        end
        routeCtl = comboCtl(roomIdx, outIdx)
        forceSetChoices(routeCtl, poolChoices(routePool), preferLabel)
      end
    end
    if Controls.globalSourceComboBox then
      forceSetChoices(Controls.globalSourceComboBox, poolChoices(buildGlobalPool()))
    end
  end

  -- Light combo/route refresh (no fan-out of every label). Used after the
  -- main layout pass and once deferred so Designer commits Choices.
  function reapplyCachedMirrorRoutes()
    -- An in-flight chunked mirror already owns the faceplate; stomping it
    -- here would start another 32-column burst and drop the tail again.
    if mirroringNow then return end
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, getOutputsPerRoom() do
        if isRoomMirrorEnabled(roomIdx) or isRoomOutputMirrorEnabled(roomIdx, outIdx) then
          cachedSlot = cachedRoutedSlot(roomIdx, outIdx)
          if cachedSlot then
            applyRouteSlot(roomIdx, outIdx, cachedSlot)
          end
        end
      end
    end
  end

  function syncComboListsNow()
    if not bootComplete then return end
    resetUpdateGate()
    invalidateCaches()
    buildAllComboLists()
    refreshAllOutputColumns()
    reapplyCachedMirrorRoutes()
    refreshGlobalTab()
    resetUpdateGate()
  end

  function scheduleComboListRebuild()
    -- One deferred pass is enough; the previous triple rebuild (now + 0 + 0.1)
    -- multiplied work by ~3 on every Visibility/Global/combine change.
    Timer.CallAfter(function()
      pcall(syncComboListsNow)
    end, 0.05)
  end

  -- Visibility / Global / combine changes: skip label fan-out (unchanged) and
  -- only re-run show/hide + combos.
  function onSourceVisibilityChanged()
    if not bootComplete then return end
    resetUpdateGate()
    okVis, errVis = pcall(function()
      invalidateCaches()
      handleLayoutChange(false)
    end)
    resetUpdateGate()
    if not okVis then
      reportScriptError("Visibility change", errVis)
    end
    scheduleComboListRebuild()
  end

  function findSlotByLabel(pool, label)
    label = trimString(label)
    for _, entry in ipairs(pool) do
      if entry.label == label then return entry.slot end
    end
    return nil
  end

  function findActiveSlotByLabel(label)
    label = trimString(label)
    if label == "" then return nil end
    for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
      if getSlotLabel(avSlot) == label then return avSlot end
    end
    return nil
  end

  -- Routing -----------------------------------------------------------------

  -- Routing state that survives Designer dropping off-page String commits
  -- (Room 7–8 tabs are Style=None until opened). Keyed by outputFlatIndex.
  routedSlotByFlat = {}

  function rememberRoutedSlot(roomIdx, outIdx, slot)
    flatOut = outputFlatIndex(roomIdx, outIdx)
    if flatOut then
      routedSlotByFlat[flatOut] = slot
    end
  end

  function clearRoutedSlotCache()
    routedSlotByFlat = {}
  end

  function cachedRoutedSlot(roomIdx, outIdx)
    flatOut = outputFlatIndex(roomIdx, outIdx)
    if not flatOut then return nil end
    return routedSlotByFlat[flatOut]
  end

  -- Returns a copy. buildSourcePool hands back the cachePool table itself, so
  -- appending in place left a mirrored foreign source in that room's pool and
  -- made Choices depend on call order.
  function ensurePoolHasSlot(pool, slot)
    extended = {}
    for idx = 1, #pool do
      extended[idx] = pool[idx]
    end
    if slot == nil then return extended end
    for _, entry in ipairs(extended) do
      if entry.slot == slot then
        return extended
      end
    end
    table.insert(extended, {
      slot = slot,
      label = getSlotLabel(slot),
      output = getSlotOutput(slot),
    })
    return extended
  end

  function getRoutedSlot(roomIdx, outIdx)
    flatOut = outputFlatIndex(roomIdx, outIdx)
    routeCtl = comboCtl(roomIdx, outIdx)
    cached = flatOut and routedSlotByFlat[flatOut]
    comboStr = routeCtl and trimString(routeCtl.String) or ""
    if cached ~= nil then
      -- Mirror All / Mirror N, or a blank combo after Designer dropped a
      -- Style=None write (Room 7–8): keep the cached slot so a later Choices
      -- rebuild cannot snap the column back to that room's Src 1. A mirrored
      -- combo can hold a stale value from a dropped write, so the cache wins
      -- there even when that stale label still resolves.
      holdingMirror = isRoomMirrorEnabled(roomIdx)
        or isRoomOutputMirrorEnabled(roomIdx, outIdx)
      if holdingMirror or comboStr == "" then
        return cached
      end
      if getSlotLabel(cached) == comboStr then
        return cached
      end
    end
    if not routeCtl then return nil end
    return findSlotByLabel(buildSourcePool(roomIdx, outIdx), routeCtl.String)
      or findActiveSlotByLabel(routeCtl.String)
  end

  -- Interlock per-output Selects for one output column.
  -- Boolean writes use muteHandlers (NOT suppressing/isUpdating — Designer
  -- drops faceplate commits while isUpdating). muteHandlers blocks sync
  -- re-entry; bindSelectHandler rising-edge ignores deferred false EHs that
  -- Designer may deliver after mute clears.
  --
  -- Each Select is rm#Out#Rm#Src#. Column exclusivity is written here. Always
  -- write Boolean=true on the routed slot (even if
  -- already true or not visible). Write false only on slots that are currently
  -- true and are not the routed slot. No skip, no paint-room gate, no off-tab
  -- skip — cache is the authority.

  applyingPressedSelect = false

  function setColumnSelects(roomIdx, outIdx, chosenSlot)
    muteHandlers(function()
      for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
        selCtl = selectCtl(roomIdx, outIdx, avSlot)
        if selCtl then
          want = (avSlot == chosenSlot)
          if want then
            selCtl.Boolean = true
          elseif selCtl.Boolean then
            selCtl.Boolean = false
          end
        end
      end
    end)
  end

  -- Lit state only. Legends track source names and counts, never routing, so a
  -- route change must not re-push them: at 8x4 that was 160 writes per mirror
  -- fan-out, which is what overran Designer's budget. Page changes and renames
  -- still re-push unconditionally via scheduleFaceplateNameRefresh.
  function syncRoomSelects(roomIdx)
    if roomIdx == nil then return end
    for outIdx = 1, getOutputsPerRoom() do
      setColumnSelects(roomIdx, outIdx, getRoutedSlot(roomIdx, outIdx))
    end
  end

  function syncRoomSelectsAndLegends(roomIdx)
    if roomIdx == nil then return end
    syncRoomSelects(roomIdx)
    for outIdx = 1, getOutputsPerRoom() do
      updateColumnLegends(roomIdx, outIdx)
    end
  end

  function syncAllRoomSelects()
    for roomIdx = 1, getRoomCount() do
      syncRoomSelectsAndLegends(roomIdx)
    end
  end

  -- Compatibility alias (page switch / older call sites).
  -- Re-write this tab from the routed-slot cache first: Designer often
  -- drops combo String on Room 7–8 while those pages are Style=None.
  function flushViewedRoomRoutes()
    viewRoom = paintRoomIdx()
    if not viewRoom then return end
    for outIdx = 1, getOutputsPerRoom() do
      slot = getRoutedSlot(viewRoom, outIdx)
      if slot then
        applyRouteSlot(viewRoom, outIdx, slot)
      end
    end
  end

  function syncViewedRoomSelects()
    flushViewedRoomRoutes()
    viewRoom = paintRoomIdx()
    if viewRoom then
      syncRoomSelectsAndLegends(viewRoom)
    end
  end

  -- Legend must never run under suppressing()/isUpdating.
  function updateColumnLegends(roomIdx, outIdx)
    for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
      selCtl = selectCtl(roomIdx, outIdx, avSlot)
      writeSelectLegend(selCtl, getSlotLabel(avSlot))
    end
  end

  -- Write a route into one output column without triggering mirroring, so
  -- mirror fan-out can reuse it without recursing. Cache is updated first:
  -- combo String is a display of routedSlotByFlat, not the authority.
  -- Combo + Output strings are written unconditionally (do not skip because
  -- String already matches). setColumnSelects always runs for this column.
  function applyRouteSlot(roomIdx, outIdx, slot)
    rememberRoutedSlot(roomIdx, outIdx, slot)
    flatOut = outputFlatIndex(roomIdx, outIdx)
    pinOut = outputPinFlatIndex(roomIdx, outIdx)
    routeCtl = comboCtl(roomIdx, outIdx)
    outputCtl = outputPinCtl(roomIdx, outIdx)
    if not routeCtl then return end
    -- A dragged instance built before a property change can hold fewer Output
    -- pins than Combos. Bailing out here killed the whole column silently, so
    -- route the Combo anyway and say which output is short.
    if not outputCtl then
      warnMissingOutputPin(roomIdx, outIdx)
    end
    -- Dropdown tracks the visible source pool, plus the explicit slot when
    -- mirroring hands this output a source the room does not offer on its own.
    -- Falling back to pool[1] is what made combined rooms snap to each room's
    -- first local source, so pass the target as preferLabel too.
    -- routeEntry, not resolved: forceSetChoices assigns a global named resolved.
    pool = ensurePoolHasSlot(buildSourcePool(roomIdx, outIdx), slot)
    routeEntry = nil
    for _, entry in ipairs(pool) do
      if entry.slot == slot then
        routeEntry = entry
        break
      end
    end
    if routeEntry == nil and #pool > 0 then
      routeEntry = pool[1]
    end
    forceSetChoices(routeCtl, poolChoices(pool), routeEntry and routeEntry.label or nil)
    -- Unconditional String writes: Designer faceplate can disagree with Lua.
    muteHandlers(function()
      if routeEntry then
        rememberRoutedSlot(roomIdx, outIdx, routeEntry.slot)
        routeCtl.String = routeEntry.label
        if outputCtl then outputCtl.String = routeEntry.output end
      else
        rememberRoutedSlot(roomIdx, outIdx, nil)
        routeCtl.String = ""
        if outputCtl then outputCtl.String = "" end
      end
    end)
    setColumnSelects(roomIdx, outIdx, routeEntry and routeEntry.slot or nil)
  end

  function refreshOutputColumn(roomIdx, outIdx)
    slot = getRoutedSlot(roomIdx, outIdx)
    holdingMirror = isRoomMirrorEnabled(roomIdx) or isRoomOutputMirrorEnabled(roomIdx, outIdx)
    if slot ~= nil and not holdingMirror and not isSlotVisible(roomIdx, slot, outIdx) then
      vis = visibleSlotsForOutput(roomIdx, outIdx)
      if #vis > 0 then
        slot = vis[1]
      else
        slot = nil
      end
    end
    applyRouteSlot(roomIdx, outIdx, slot)
  end

  function refreshAllOutputColumns()
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, getOutputsPerRoom() do
        refreshOutputColumn(roomIdx, outIdx)
      end
    end
    -- Each output owns its Select bank, so every column needs its own legends.
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, getOutputsPerRoom() do
        updateColumnLegends(roomIdx, outIdx)
      end
    end
  end

  -- Mirror ------------------------------------------------------------------
  -- Spec:
  --   Setup Mirror ON  -> every room Mirror All = true (and Visibility = true)
  --   Room Mirror All ON -> that room's Visibility stays true
  --   Room Mirror All ON -> selected source goes to every output of this room
  --   Room Mirror All ON -> same source also goes to every output of every
  --                         other combined room that has Mirror All ON
  --                         (an uncombined room stays in-room)
  --   The all-rooms routing strip keeps every Combo / Output / Mirror styled on
  --     Setup and Room tabs, so Designer cannot drop writes on rooms 6–8
  --   A room with any Mirror on keeps its routed source in Choices, so a
  --     Choices rebuild cannot snap the column to that room's Src 1
  --   Mirror All ON -> Mirror 1–4 OFF (All and 1–4 are not on together)
  --   Mirror N ON -> Mirror All OFF; Visibility ON; Output N copies to
  --                  Output N of every other combined room that also has Mirror N ON

  function copyRoomList(rooms)
    copiedRooms = {}
    for _, roomIdx in ipairs(rooms) do
      table.insert(copiedRooms, roomIdx)
    end
    return copiedRooms
  end

  function firstRoutedSlot(roomIdx)
    for outIdx = 1, getOutputsPerRoom() do
      slot = getRoutedSlot(roomIdx, outIdx)
      if slot then
        return slot, outIdx
      end
    end
    return nil, nil
  end

  -- Mirroring a global onto an output whose Global N is off used to drop
  -- the route onto pool[1] (that room's Src 1). Turn Global N on so the
  -- destination can keep the same AV source.
  -- Only write Show Globals when it is actually off. Designer delivers an
  -- EventHandler for every Boolean write, changed or not, and each one rebuilds
  -- all 32 combo lists once the mute clears. Re-asserting true on 32 outputs
  -- queued 32 of those rebuilds, which is why mirroring a Global truncated the
  -- fan-out while mirroring a local source never did.
  function prepareMirrorSlotOnOutput(roomIdx, outIdx, slot)
    if slot == nil then return end
    if slotIsGlobal(slot) then
      gOutCtl = roomOutputGlobalCtl(roomIdx, outIdx)
      if gOutCtl and gOutCtl.Boolean ~= true then
        gOutCtl.Boolean = true
      end
    end
  end

  function prepareMirrorTargets(fromRoomIdx, fromOutIdx, slot)
    muteHandlers(function()
      if isRoomMirrorEnabled(fromRoomIdx) then
        for outIdx = 1, getOutputsPerRoom() do
          prepareMirrorSlotOnOutput(fromRoomIdx, outIdx, slot)
        end
        for _, linkedRoom in ipairs(copyRoomList(getMirrorLinkedRooms(fromRoomIdx))) do
          for outIdx = 1, getOutputsPerRoom() do
            prepareMirrorSlotOnOutput(linkedRoom, outIdx, slot)
          end
        end
      end
      if isRoomOutputMirrorEnabled(fromRoomIdx, fromOutIdx) then
        for _, linkedRoom in ipairs(copyRoomList(getOutputMirrorLinkedRooms(fromRoomIdx, fromOutIdx))) do
          prepareMirrorSlotOnOutput(linkedRoom, fromOutIdx, slot)
        end
      end
    end)
    invalidateCaches()
  end

  function visitMirrorTarget(seenTargets, roomIdx, outIdx, fn)
    targetKey = (roomIdx * 10) + outIdx
    if seenTargets[targetKey] then return end
    seenTargets[targetKey] = true
    fn(roomIdx, outIdx)
  end

  -- Origin first, then every other Mirror All column, then Mirror N peers.
  function eachMirrorTarget(fromRoomIdx, fromOutIdx, fn)
    seenTargets = {}
    visitMirrorTarget(seenTargets, fromRoomIdx, fromOutIdx, fn)
    if isRoomMirrorEnabled(fromRoomIdx) then
      for outIdx = 1, getOutputsPerRoom() do
        visitMirrorTarget(seenTargets, fromRoomIdx, outIdx, fn)
      end
      for _, linkedRoom in ipairs(copyRoomList(getMirrorLinkedRooms(fromRoomIdx))) do
        for outIdx = 1, getOutputsPerRoom() do
          visitMirrorTarget(seenTargets, linkedRoom, outIdx, fn)
        end
      end
    end
    if isRoomOutputMirrorEnabled(fromRoomIdx, fromOutIdx) then
      for _, linkedRoom in ipairs(copyRoomList(getOutputMirrorLinkedRooms(fromRoomIdx, fromOutIdx))) do
        visitMirrorTarget(seenTargets, linkedRoom, fromOutIdx, fn)
      end
    end
  end

  function mirrorCacheDisagrees()
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, getOutputsPerRoom() do
        if isRoomMirrorEnabled(roomIdx) or isRoomOutputMirrorEnabled(roomIdx, outIdx) then
          cachedSlot = cachedRoutedSlot(roomIdx, outIdx)
          if cachedSlot then
            fanCtl = comboCtl(roomIdx, outIdx)
            if fanCtl and trimString(fanCtl.String) ~= getSlotLabel(cachedSlot) then
              return true
            end
            selCtl = selectCtl(roomIdx, outIdx, cachedSlot)
            if selCtl and selCtl.Boolean ~= true then
              return true
            end
          end
        end
      end
    end
    return false
  end

  -- Designer drops Combo / Output / Select writes after ~18 columns in one
  -- EventHandler. Cache every flat first; write the faceplate 8 columns at a
  -- time (origin room plus the next room at 4 outs). CallAfter(0) continues.
  MIRROR_FACEPLATE_CHUNK = 8
  mirrorWriteGen = 0
  mirrorWriteJob = nil

  function writeReassertColumn(roomIdx, outIdx, cachedSlot)
    fanFlat = outputFlatIndex(roomIdx, outIdx)
    pinOut = outputPinFlatIndex(roomIdx, outIdx)
    fanCtl = comboCtl(roomIdx, outIdx)
    outputCtl = outputPinCtl(roomIdx, outIdx)
    wantLabel = getSlotLabel(cachedSlot)
    wantOutput = getSlotOutput(cachedSlot)
    muteHandlers(function()
      if fanCtl then fanCtl.String = wantLabel end
      if outputCtl then outputCtl.String = wantOutput end
    end)
    setColumnSelects(roomIdx, outIdx, cachedSlot)
  end

  function writeMirrorJobChunk()
    job = mirrorWriteJob
    if job == nil then return end
    mirroringNow = true
    written = 0
    while job.index <= #job.targets and written < MIRROR_FACEPLATE_CHUNK do
      t = job.targets[job.index]
      if job.mode == "reassert" then
        writeReassertColumn(t.room, t.out, t.slot)
      else
        applyRouteSlot(t.room, t.out, t.slot)
      end
      job.index = job.index + 1
      written = written + 1
    end
    if job.index > #job.targets then
      if job.verify then
        verifyMirrorFanout(job.fromRoom, job.fromOut, job.slot, true)
      end
      mirrorWriteJob = nil
      mirroringNow = false
    else
      scheduledGen = job.gen
      Timer.CallAfter(function()
        if mirrorWriteJob == nil or mirrorWriteJob.gen ~= scheduledGen then
          return
        end
        okCont, errCont = pcall(writeMirrorJobChunk)
        if not okCont then
          mirrorWriteJob = nil
          mirroringNow = false
          print("Room Combine Video Routing mirror continue: " .. tostring(errCont))
        end
      end, 0)
    end
  end

  function startMirrorWriteJob(job)
    mirrorWriteGen = mirrorWriteGen + 1
    job.gen = mirrorWriteGen
    job.index = 1
    mirrorWriteJob = job
    mirroringNow = true
    writeMirrorJobChunk()
  end

  -- Cheap repair: cache → combo String + Output String + Selects. No legends,
  -- no Show Globals, no Choices rebuild. Chunked: a 32-column burst here
  -- drops the same R5O3–R8O4 tail as mirrorRoute used to.
  function reassertMirrorFromCache()
    if mirroringNow then return end
    targets = {}
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, getOutputsPerRoom() do
        if isRoomMirrorEnabled(roomIdx) or isRoomOutputMirrorEnabled(roomIdx, outIdx) then
          cachedSlot = cachedRoutedSlot(roomIdx, outIdx)
          if cachedSlot then
            table.insert(targets, { room = roomIdx, out = outIdx, slot = cachedSlot })
          end
        end
      end
    end
    if #targets == 0 then return end
    startMirrorWriteJob({
      mode = "reassert",
      targets = targets,
      verify = false,
    })
  end

  -- Cache every mirrored flat in this handler, then write origin + as many
  -- columns as fit in the first chunk. Remaining columns continue on 0-delay
  -- ticks. Combo EventHandlers from our own writes see mirroringNow and do
  -- not start a new mirror; a later user pick supersedes via a new gen.
  function mirrorRoute(fromRoomIdx, fromOutIdx, slot)
    if slot == nil then
      return
    end
    okMir, errMir = pcall(function()
      prepareMirrorTargets(fromRoomIdx, fromOutIdx, slot)
      targets = {}
      eachMirrorTarget(fromRoomIdx, fromOutIdx, function(roomIdx, outIdx)
        rememberRoutedSlot(roomIdx, outIdx, slot)
        table.insert(targets, { room = roomIdx, out = outIdx, slot = slot })
      end)
      startMirrorWriteJob({
        mode = "route",
        slot = slot,
        targets = targets,
        fromRoom = fromRoomIdx,
        fromOut = fromOutIdx,
        verify = true,
      })
    end)
    if not okMir then
      mirrorWriteJob = nil
      mirroringNow = false
      error(errMir)
    end
  end

  -- adoptFromGroup: a room turning Mirror on joins combined rooms that are
  -- already mirrored — take their route instead of broadcasting Src 1.
  function applyCurrentMirror(roomIdx, adoptFromGroup)
    if not isRoomMirrorEnabled(roomIdx) then
      return
    end
    invalidateCaches()
    slot = nil
    fromOut = 1
    if adoptFromGroup then
      for _, linkedRoom in ipairs(copyRoomList(getMirrorLinkedRooms(roomIdx))) do
        slot, fromOut = firstRoutedSlot(linkedRoom)
        if slot then break end
      end
    end
    if slot == nil then
      slot, fromOut = firstRoutedSlot(roomIdx)
    end
    if slot then
      mirrorRoute(roomIdx, fromOut or 1, slot)
    end
  end

  function applyCurrentMirrorAllRooms()
    consumed = {}
    for roomIdx = 1, getRoomCount() do
      if isRoomMirrorEnabled(roomIdx) and consumed[roomIdx] == nil then
        linkedCopy = copyRoomList(getMirrorLinkedRooms(roomIdx))
        applyCurrentMirror(roomIdx, false)
        consumed[roomIdx] = true
        for _, linkedRoom in ipairs(linkedCopy) do
          consumed[linkedRoom] = true
        end
      end
    end
  end

  function applyCurrentOutputMirror(roomIdx, outIdx, adoptFromGroup)
    if not isRoomOutputMirrorEnabled(roomIdx, outIdx) then
      return
    end
    invalidateCaches()
    slot = nil
    if adoptFromGroup then
      for _, linkedRoom in ipairs(copyRoomList(getOutputMirrorLinkedRooms(roomIdx, outIdx))) do
        slot = getRoutedSlot(linkedRoom, outIdx)
        if slot then break end
      end
    end
    if slot == nil then
      slot = getRoutedSlot(roomIdx, outIdx)
    end
    if slot then
      mirrorRoute(roomIdx, outIdx, slot)
    end
  end

  function applyCurrentOutputMirrorAllRooms(outIdx)
    consumed = {}
    for roomIdx = 1, getRoomCount() do
      if isRoomOutputMirrorEnabled(roomIdx, outIdx) and consumed[roomIdx] == nil then
        linkedCopy = copyRoomList(getOutputMirrorLinkedRooms(roomIdx, outIdx))
        applyCurrentOutputMirror(roomIdx, outIdx, false)
        consumed[roomIdx] = true
        for _, linkedRoom in ipairs(linkedCopy) do
          consumed[linkedRoom] = true
        end
      end
    end
  end

  function selectSlot(roomIdx, outIdx, slot)
    if slotIsGlobal(slot) then
      gOutCtl = roomOutputGlobalCtl(roomIdx, outIdx)
      if gOutCtl and gOutCtl.Boolean ~= true then
        muteHandlers(function()
          gOutCtl.Boolean = true
          sOut = setupGlobalOutCtl(outIdx)
          if sOut then
            sOut.Boolean = true
          end
        end)
        invalidateCaches()
      end
    end
    if not isSlotVisible(roomIdx, slot, outIdx) then
      refreshOutputColumn(roomIdx, outIdx)
      return
    end
    if isRoomMirrorEnabled(roomIdx) or isRoomOutputMirrorEnabled(roomIdx, outIdx) then
      mirrorRoute(roomIdx, outIdx, slot)
    else
      applyRouteSlot(roomIdx, outIdx, slot)
    end
  end

  -- Component.New from a UCI/control script often writes Boolean without
  -- firing this plugin's EventHandler. Treat a true Select as a press.
  function applyPressedSelects()
    if not bootComplete or mirroringNow or applyingPressedSelect then return end
    applyingPressedSelect = true
    okPress, errPress = pcall(function()
      for roomIdx = 1, getRoomCount() do
        for outIdx = 1, getOutputsPerRoom() do
          routed = getRoutedSlot(roomIdx, outIdx)
          pressed = nil
          for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
            ctl = selectCtl(roomIdx, outIdx, avSlot)
            if ctl and ctl.Boolean == true and avSlot ~= routed then
              pressed = avSlot
            end
          end
          if pressed and pressed ~= routed then
            noteRoomInteraction(roomIdx)
            selectSlot(roomIdx, outIdx, pressed)
          end
        end
      end
    end)
    applyingPressedSelect = false
    if not okPress then
      reportScriptError("Script select", errPress)
    end
  end

  pendingPressApply = false
  function scheduleApplyPressedSelects()
    if pendingPressApply then return end
    pendingPressApply = true
    Timer.CallAfter(function()
      pendingPressApply = false
      applyPressedSelects()
    end, 0)
  end

  -- Visibility --------------------------------------------------------------
  -- Style=None in GetControlLayout keeps off-page controls out of the layout.
  -- Runtime must NOT page-scope IsInvisible (6.6.5/6.6.6 blanked Designer).
  -- Product rules only: Global on/off, Visibility+combine, unused beyond counts.
  -- Never wrap IsInvisible in suppressing() — Designer drops those commits.

  -- Per-room Select show/hide. Do not clear Boolean here — setColumnSelects
  -- owns the latch. A true Boolean must not keep an illegal row on the UCI
  -- (split rooms were leaving Wireless Rm 1 visible on Room 2).
  function hideSelectRow(roomIdx, outIdx, avSlot, hideSlot)
    selCtl = selectCtl(roomIdx, outIdx, avSlot)
    setControlInvisible(selCtl, hideSlot)
  end

  function hideSharedSlot(avSlot, hideSlot)
    labelCtl = sourceLabelCtlFrom(Controls, avSlot)
    if labelCtl then
      setControlInvisible(labelCtl, hideSlot == true)
    end
    sharedIdx = sharedSlotIndex(avSlot)
    if not sharedIdx then return end
    -- OutputStrings / Setup preview live on Setup; active AV rows stay visible
    -- there regardless of room Global / Visibility.
    setControlInvisible(roomOutputOutputStrings[sharedIdx], false)
    setControlInvisible(setupSrcSelCtl(sharedIdx), false)
  end

  -- Every active room gets the same Global/Vis treatment (no page_index branch).
  -- Every output owns its Select bank, so each room's rows follow that room's
  -- own visibility. This used to run for the viewed room only, which meant every
  -- tab showed one room's rows whenever page_index could not name the tab.
  function syncRoomSourceVisibility()
    outCount = getOutputsPerRoom()
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, outCount do
        for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
          hideSlot = not isSlotVisible(roomIdx, avSlot, outIdx)
          hideSelectRow(roomIdx, outIdx, avSlot, hideSlot)
        end
      end
    end
    -- Source Labels exist only for active Counts; keep them visible on Setup.
    -- OutputStrings / Setup preview stay visible for every active AV slot.
    for roomIdx = 1, getRoomCount() do
      for localIdx = 1, getSourcesPerRoom() do
        hideSharedSlot(localSlotIndex(roomIdx, localIdx), false)
      end
    end
    if getGlobalSourceCount() < 1 then
      hideSharedSlot(globalSlotIndex(1), true)
    else
      for globalIdx = 1, getGlobalSourceCount() do
        hideSharedSlot(globalSlotIndex(globalIdx), false)
      end
    end
  end

  -- No-op retained for call sites: dense Counts mean inactive columns do not exist.
  function syncInactiveColumnsIfNeeded()
  end

  -- Global rows per output (Global N on/off). Shared Labels stay visible.
  function applyGlobalRowVisibility()
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, getOutputsPerRoom() do
        outGlobalOn = isRoomOutputGlobalEnabled(roomIdx, outIdx)
        for globalIdx = 1, getGlobalSourceCount() do
          hideSelectRow(roomIdx, outIdx, globalSlotIndex(globalIdx), not outGlobalOn)
        end
      end
    end
  end

  function syncRoomOptionVisibility()
    -- Setup masters stay visible; Designer Style=None handles page layout.
    setControlInvisible(setupRoomCombiner, false)
    setControlInvisible(setupGlobal, false)
    setControlInvisible(setupVisibility, false)
    setControlInvisible(setupMirror, false)
    setControlInvisible(setupOutputStringFormat, false)
    for outIdx = 1, getOutputsPerRoom() do
      setControlInvisible(setupMirrorOutCtl(outIdx), false)
      setControlInvisible(setupGlobalOutCtl(outIdx), false)
    end
    -- Hidden utility / pin-only fields
    setControlInvisible(setupDefaultRC, true)
    setControlInvisible(status, true)
    setControlInvisible(Controls.propertiesRoomCount, true)
    setControlInvisible(Controls.propertiesSourcesPerRoom, true)
    setControlInvisible(Controls.propertiesOutputsPerRoom, true)
    setControlInvisible(Controls.propertiesGlobalSourceCount, true)

    for roomIdx = 1, getRoomCount() do
      if roomOptionGlobal and roomOptionGlobal[roomIdx] then
        setControlInvisible(roomOptionGlobal[roomIdx], false)
      end
      if roomOptionVisibility and roomOptionVisibility[roomIdx] then
        setControlInvisible(roomOptionVisibility[roomIdx], false)
      end
      if roomOptionMirror and roomOptionMirror[roomIdx] then
        setControlInvisible(roomOptionMirror[roomIdx], false)
      end
      for outIdx = 1, getOutputsPerRoom() do
        mOutCtl = roomOutputMirrorCtl(roomIdx, outIdx)
        if mOutCtl then
          setControlInvisible(mOutCtl, false)
        end
        gOutCtl = roomOutputGlobalCtl(roomIdx, outIdx)
        if gOutCtl then
          setControlInvisible(gOutCtl, false)
        end
        flatOut = outputFlatIndex(roomIdx, outIdx)
        setControlInvisible(comboCtl(roomIdx, outIdx), false)
        if outputPinCtl(roomIdx, outIdx) then
          setControlInvisible(outputPinCtl(roomIdx, outIdx), false)
        end
      end
    end
  end

  function syncGlobalTabVisibility()
    setControlInvisible(Controls.globalSourceComboBox, false)
    for globalIdx = 1, getGlobalSourceCount() do
      if globalSourceControls and globalSourceControls[globalIdx] then
        setControlInvisible(globalSourceControls[globalIdx], false)
      end
      if globalOutputPins and globalOutputPins[globalIdx] then
        setControlInvisible(globalOutputPins[globalIdx], false)
      end
      hideSharedSlot(globalSlotIndex(globalIdx), false)
    end
    if getGlobalSourceCount() < 1 then
      if globalSourceControls and globalSourceControls[1] then
        setControlInvisible(globalSourceControls[1], true)
      end
      if globalOutputPins and globalOutputPins[1] then
        setControlInvisible(globalOutputPins[1], true)
      end
    end
  end

  -- Global Sources tab ------------------------------------------------------

  function buildGlobalPool()
    pool = {}
    for globalIdx = 1, getGlobalSourceCount() do
      slot = globalSlotIndex(globalIdx)
      table.insert(pool, { slot = slot, label = getSlotLabel(slot), output = getSlotOutput(slot) })
    end
    return pool
  end

  function refreshGlobalTab()
    pool = buildGlobalPool()
    globalComboCtl = Controls.globalSourceComboBox
    if not globalComboCtl then return end
    forceSetChoices(globalComboCtl, poolChoices(pool))
    resolved = nil
    for _, entry in ipairs(pool) do
      if entry.label == trimString(globalComboCtl.String) then
        resolved = entry
        break
      end
    end
    if resolved == nil and #pool > 0 then
      resolved = pool[1]
    end
    -- Boolean interlock muted; String/Legend never under isUpdating.
    muteHandlers(function()
      if resolved then
        globalComboCtl.String = resolved.label
        for globalIdx = 1, getGlobalSourceCount() do
          selCtl = globalSourceControls[globalIdx]
          if selCtl then
            selCtl.Boolean = (globalSlotIndex(globalIdx) == resolved.slot)
          end
        end
      else
        globalComboCtl.String = ""
      end
    end)
    for globalIdx = 1, getGlobalSourceCount() do
      selCtl = globalSourceControls[globalIdx]
      if selCtl then
        selCtl.Legend = getSlotLabel(globalSlotIndex(globalIdx))
      end
    end
    syncGlobalOutputPins(resolved and resolved.slot or nil)
  end

  function selectGlobalSlot(globalIdx)
    slot = globalSlotIndex(globalIdx)
    if globalIdx > getGlobalSourceCount() then
      refreshGlobalTab()
      return
    end
    muteHandlers(function()
      Controls.globalSourceComboBox.String = getSlotLabel(slot)
    end)
    refreshGlobalTab()
  end


  -- Mirror / Visibility interlock -------------------------------------------
  -- Any Mirror (All or 1–4) ON => Visibility ON.
  -- Visibility OFF => Mirror All and Mirror 1–4 OFF.
  -- When clearing Visibility, turn Mirrors off first (or with it), then call
  -- enforceMirrorRequiresVisibility so Visibility is not snapped back on.

  function clearMirrorIfVisibilityOff(roomIdx)
    if roomOptionVisibility[roomIdx] and roomOptionVisibility[roomIdx].Boolean ~= true then
      if roomOptionMirror[roomIdx] then
        roomOptionMirror[roomIdx].Boolean = false
      end
      for outIdx = 1, getOutputsPerRoom() do
        mOutCtl = roomOutputMirrorCtl(roomIdx, outIdx)
        if mOutCtl then
          mOutCtl.Boolean = false
        end
      end
    end
  end

  function enforceMirrorRequiresVisibility(roomIdx)
    if anyRoomMirrorOn(roomIdx) and roomOptionVisibility[roomIdx] then
      roomOptionVisibility[roomIdx].Boolean = true
    end
  end

  function enforceAllMirrorRequiresVisibility()
    -- muteHandlers: Designer drops faceplate Boolean commits while isUpdating.
    muteHandlers(function()
      for roomIdx = 1, getRoomCount() do
        clearMirrorIfVisibilityOff(roomIdx)
        enforceMirrorRequiresVisibility(roomIdx)
      end
    end)
  end

  -- If Mirror is holding a global source, keep Global N on so a later
  -- layout pass cannot hide it and replace the route with Src 1.
  function enforceMirrorKeepsRoutedSourceVisible()
    muteHandlers(function()
      for roomIdx = 1, getRoomCount() do
        if isRoomMirrorEnabled(roomIdx) then
          for outIdx = 1, getOutputsPerRoom() do
            slot = getRoutedSlot(roomIdx, outIdx)
            if slot and slotIsGlobal(slot) then
              for out2 = 1, getOutputsPerRoom() do
                prepareMirrorSlotOnOutput(roomIdx, out2, slot)
              end
              for _, linkedRoom in ipairs(copyRoomList(getMirrorLinkedRooms(roomIdx))) do
                for out2 = 1, getOutputsPerRoom() do
                  prepareMirrorSlotOnOutput(linkedRoom, out2, slot)
                end
              end
              break
            end
          end
        end
        for outIdx = 1, getOutputsPerRoom() do
          if isRoomOutputMirrorEnabled(roomIdx, outIdx) then
            slot = getRoutedSlot(roomIdx, outIdx)
            if slot and slotIsGlobal(slot) then
              prepareMirrorSlotOnOutput(roomIdx, outIdx, slot)
              for _, linkedRoom in ipairs(copyRoomList(getOutputMirrorLinkedRooms(roomIdx, outIdx))) do
                prepareMirrorSlotOnOutput(linkedRoom, outIdx, slot)
              end
            end
          end
        end
      end
    end)
    invalidateCaches()
  end

  -- Setup masters propagate their Boolean to every active room's matching
  -- option (on and off). Mirror ON also forces Visibility ON (rooms + Setup
  -- Visibility). Mirror OFF clears room Mirror only — Visibility stays, matching
  -- room-level Mirror handlers. Visibility master OFF also clears every room
  -- Mirror and Setup Mirror (alsoClearMirrorWhenOff).
  -- Boolean writes MUST use muteHandlers, not suppressing/isUpdating.
  function applySetupMasterToRooms(masterCtl, roomCtls, alsoForceVisibility, alsoClearMirrorWhenOff)
    if not masterCtl then return end
    wantOn = masterCtl.Boolean == true
    muteHandlers(function()
      for roomIdx = 1, getRoomCount() do
        if roomCtls and roomCtls[roomIdx] then
          roomCtls[roomIdx].Boolean = wantOn
        end
        if alsoForceVisibility and wantOn then
          if roomOptionVisibility[roomIdx] then
            roomOptionVisibility[roomIdx].Boolean = true
          end
        end
        if alsoClearMirrorWhenOff and not wantOn then
          if roomOptionMirror[roomIdx] then
            roomOptionMirror[roomIdx].Boolean = false
          end
          for outIdx = 1, getOutputsPerRoom() do
            mOutCtl = roomOutputMirrorCtl(roomIdx, outIdx)
            if mOutCtl then
              mOutCtl.Boolean = false
            end
          end
        end
      end
      if alsoForceVisibility and wantOn and setupVisibility then
        setupVisibility.Boolean = true
      end
      if alsoClearMirrorWhenOff and not wantOn and setupMirror then
        setupMirror.Boolean = false
      end
      if alsoClearMirrorWhenOff and not wantOn and setupMirrorOut then
        for outIdx = 1, getOutputsPerRoom() do
          mSetup = setupMirrorOutCtl(outIdx)
          if mSetup then
            mSetup.Boolean = false
          end
        end
      end
    end)
  end

  -- Full sync ---------------------------------------------------------------
  -- doFanOut (default true): seed/fan labels and AV strings. Visibility-only
  -- callers pass false to avoid rewriting every label copy on each toggle.

  lastDimensionFingerprint = ""

  function handleLayoutChange(doFanOut)
    if doFanOut == nil then doFanOut = true end
    dimsChanged = false
    -- suppressing() blocks re-entrant handlers while caches/dimensions refresh.
    -- Do NOT write String / Legend / Choices / IsInvisible / Boolean inside it —
    -- Designer often drops those faceplate commits while isUpdating is true.
    suppressing(function()
      refreshActiveDimensions()
      dimsChanged = (dimensionFingerprint() ~= lastDimensionFingerprint)
      lastDimensionFingerprint = dimensionFingerprint()
      invalidateCaches()
      if dimsChanged then
        clearRoutedSlotCache()
      end
      lastCombinerFingerprint = combinerFingerprint()
      combinerDirty = false
    end)
    resetUpdateGate()
    applyPressedSelects()

    -- Mirror/Vis Boolean interlock with gate clear (muteHandlers inside).
    enforceAllMirrorRequiresVisibility()
    enforceMirrorKeepsRoutedSourceVisible()
    invalidateCaches()

    -- preferRoom for label fan-out only (not IsInvisible).
    refreshActivePage()
    preferRoom = viewedRoomIdx()

    -- IsInvisible commits with the gate clear (product rules only).
    syncInactiveColumnsIfNeeded()
    syncRoomOptionVisibility()
    syncRoomSourceVisibility()
    applyGlobalRowVisibility()
    -- After shared-slot hide: keep Global tab Label/Output fields visible.
    syncGlobalTabVisibility()

    if doFanOut then
      syncPropertyPins()
      -- Shared Labels/OutputStrings + per-room Select Legends.
      populateSlotStrings(dimsChanged, preferRoom)
    else
      flushPendingRoomSlotStrings(preferRoom)
    end

    -- Combo String/Choices, Select Legend, pin Strings — all outside suppress.
    buildAllComboLists()
    refreshAllOutputColumns()
    reapplyCachedMirrorRoutes()
    syncAllRoomSelects()
    -- Hide again after Selects/Booleans catch up so a just-invalidated
    -- other-room latch cannot remain on the UCI.
    syncRoomSourceVisibility()
    applyGlobalRowVisibility()
    syncGlobalTabVisibility()
    refreshGlobalTab()

    if status then
      statusRoom = preferRoom
      groupText = "-"
      if statusRoom and statusRoom >= 1 and statusRoom <= getRoomCount() then
        groupParts = {}
        for _, groupRoom in ipairs(getVisibilitySourceRooms(statusRoom)) do
          table.insert(groupParts, tostring(groupRoom))
        end
        groupText = table.concat(groupParts, "+")
      end
      selBound, optBound = countBoundHandlers()
      invisSel = 0
      for roomIdx = 1, getRoomCount() do
        for outIdx = 1, getOutputsPerRoom() do
          for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
            selCtl = selectCtl(roomIdx, outIdx, avSlot)
            if selCtl and selCtl.IsInvisible == true then
              invisSel = invisSel + 1
            end
          end
        end
      end
      mirrorParts = {}
      for roomIdx = 1, getRoomCount() do
        if isRoomMirrorEnabled(roomIdx) then
          table.insert(mirrorParts, tostring(roomIdx))
        end
      end
      mirrorText = table.concat(mirrorParts, "+")
      if mirrorText == "" then mirrorText = "-" end
      status.String = string.format(
        "sel=%d opt=%d | labels %d | v%s | %s | via %s | group %s | mirror %s | rooms %d | src %d | out %d | global %d | page %s | view %s | paint %s | invis %d",
        selBound,
        optBound,
        lastLabelsSeeded or 0,
        PluginInfo.Version,
        trimString(setupDefaultRC.String),
        lastGroupSource,
        groupText,
        mirrorText,
        getRoomCount(),
        getSourcesPerRoom(),
        getOutputsPerRoom(),
        getGlobalSourceCount(),
        tostring(activePageIdx or "-"),
        tostring(viewedRoomIdx() or "-"),
        tostring(paintRoomIdx() or "-"),
        invisSel
      )
    end
    scheduleApplyPressedSelects()
  end

  function safeHandleLayoutChange()
    if not bootComplete or isUpdating then
      return
    end
    ok, err = pcall(handleLayoutChange)
    resetUpdateGate()
    if not ok then
      reportScriptError("Layout error", err)
    end
  end

  function refreshActivePage()
    pageIdx = nil
    if Properties and Properties["page_index"] then
      pageIdx = Properties["page_index"].Value
    end
    activePageIdx = resolvedPageIndex(pageIdx)
  end

  -- Handlers ----------------------------------------------------------------

  -- Boot/status diagnostics: how many Select / option binders attached.
  function countBoundHandlers()
    selBound = 0
    optBound = 0
    if roomOptionGlobal then
      for roomIdx = 1, getRoomCount() do
        if roomOptionGlobal[roomIdx]
          and type(roomOptionGlobal[roomIdx].EventHandler) == "function" then
          optBound = optBound + 1
        end
        if roomOptionVisibility[roomIdx]
          and type(roomOptionVisibility[roomIdx].EventHandler) == "function" then
          optBound = optBound + 1
        end
        if roomOptionMirror[roomIdx]
          and type(roomOptionMirror[roomIdx].EventHandler) == "function" then
          optBound = optBound + 1
        end
        for outIdx = 1, getOutputsPerRoom() do
          mOutCtl = roomOutputMirrorCtl(roomIdx, outIdx)
          if mOutCtl and type(mOutCtl.EventHandler) == "function" then
            optBound = optBound + 1
          end
          gOutCtl = roomOutputGlobalCtl(roomIdx, outIdx)
          if gOutCtl and type(gOutCtl.EventHandler) == "function" then
            optBound = optBound + 1
          end
        end
      end
    end
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, getOutputsPerRoom() do
        for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
          selCtl = selectCtl(roomIdx, outIdx, avSlot)
          if selCtl and type(selCtl.EventHandler) == "function" then
            selBound = selBound + 1
          end
        end
      end
    end
    return selBound, optBound
  end

  function bindSetupHandlers()
    if setupRoomCombiner then
      setupRoomCombiner.EventHandler = function(ctl)
        runHandler("Room Combiner", function()
          setRoomCombiner(ctl.String)
        end)
      end
    end
    if setupGlobal then
      setupGlobal.EventHandler = function()
        runHandler("Setup Global", function()
          applySetupMasterToRooms(setupGlobal, roomOptionGlobal, false)
          muteHandlers(function()
            setAllPerOutputGlobals(setupGlobal.Boolean == true)
          end)
          onSourceVisibilityChanged()
        end)
      end
    end
    if setupVisibility then
      setupVisibility.EventHandler = function()
        runHandler("Setup Visibility", function()
          applySetupMasterToRooms(setupVisibility, roomOptionVisibility, false, true)
          onSourceVisibilityChanged()
        end)
      end
    end
    if setupMirror then
      setupMirror.EventHandler = function()
        runHandler("Setup Mirror", function()
          applySetupMasterToRooms(setupMirror, roomOptionMirror, true)
          muteHandlers(function()
            if setupMirror.Boolean == true then
              setAllPerOutputMirrors(false)
            end
          end)
          onSourceVisibilityChanged()
          if setupMirror.Boolean then
            applyCurrentMirrorAllRooms()
          end
        end)
      end
    end
    if setupMirrorOut then
      for outIdx = 1, getOutputsPerRoom() do
        mSetup = setupMirrorOutCtl(outIdx)
        if mSetup then
          mSetup.EventHandler = (function(capturedOut)
            return function()
              runHandler("Setup Mirror " .. capturedOut, function()
                if capturedOut > getOutputsPerRoom() then return end
                masterCtl = setupMirrorOutCtl(capturedOut)
                if not masterCtl then return end
                wantOn = masterCtl.Boolean == true
                muteHandlers(function()
                  for roomIdx = 1, getRoomCount() do
                    mOutCtl = roomOutputMirrorCtl(roomIdx, capturedOut)
                    if mOutCtl then
                      mOutCtl.Boolean = wantOn
                    end
                    if wantOn then
                      if roomOptionMirror[roomIdx] then
                        roomOptionMirror[roomIdx].Boolean = false
                      end
                      if roomOptionVisibility[roomIdx] then
                        roomOptionVisibility[roomIdx].Boolean = true
                      end
                    end
                  end
                  if wantOn then
                    if setupMirror then
                      setupMirror.Boolean = false
                    end
                    if setupVisibility then
                      setupVisibility.Boolean = true
                    end
                  end
                end)
                onSourceVisibilityChanged()
                if wantOn then
                  applyCurrentOutputMirrorAllRooms(capturedOut)
                end
              end)
            end
          end)(outIdx)
        end
      end
    end
    if setupGlobalOut then
      for outIdx = 1, getOutputsPerRoom() do
        gSetup = setupGlobalOutCtl(outIdx)
        if gSetup then
          gSetup.EventHandler = (function(capturedOut)
            return function()
              runHandler("Setup Global " .. capturedOut, function()
                if capturedOut > getOutputsPerRoom() then return end
                masterCtl = setupGlobalOutCtl(capturedOut)
                if not masterCtl then return end
                wantOn = masterCtl.Boolean == true
                muteHandlers(function()
                  for roomIdx = 1, getRoomCount() do
                    gOutCtl = roomOutputGlobalCtl(roomIdx, capturedOut)
                    if gOutCtl then
                      gOutCtl.Boolean = wantOn
                    end
                  end
                end)
                onSourceVisibilityChanged()
              end)
            end
          end)(outIdx)
        end
      end
    end
    if setupOutputStringFormat then
      setupOutputStringFormat.EventHandler = function()
        runHandler("Setup OutputString Format", function()
          applyOutputStringFormatMode()
        end)
      end
    end
  end

  -- Binder factories take room/output/slot as parameters so each handler
  -- closes over a stable value. Function parameters are scoped to the call,
  -- which avoids the shared-global capture hazard without scattering locals.
  function bindRoomGlobalHandler(roomIdx)
    roomOptionGlobal[roomIdx].EventHandler = (function(capturedRoom)
      return function()
        runHandler("Global option", function()
          muteHandlers(function()
            setRoomPerOutputGlobals(capturedRoom, isRoomGlobalEnabled(capturedRoom))
          end)
          onSourceVisibilityChanged()
        end)
      end
    end)(roomIdx)
  end

  function bindRoomVisibilityHandler(roomIdx)
    roomOptionVisibility[roomIdx].EventHandler = (function(capturedRoom)
      return function()
        runHandler("Visibility option", function()
          muteHandlers(function()
            -- Visibility OFF clears Mirror first so enforce cannot snap Visibility back on.
            clearMirrorIfVisibilityOff(capturedRoom)
            enforceMirrorRequiresVisibility(capturedRoom)
          end)
          onSourceVisibilityChanged()
        end)
      end
    end)(roomIdx)
  end

  function bindRoomMirrorHandler(roomIdx)
    roomOptionMirror[roomIdx].EventHandler = (function(capturedRoom)
      return function()
        runHandler("Mirror option", function()
          muteHandlers(function()
            enforceMirrorRequiresVisibility(capturedRoom)
            if isRoomMirrorEnabled(capturedRoom) then
              setRoomPerOutputMirrors(capturedRoom, false)
            end
          end)
          onSourceVisibilityChanged()
          if isRoomMirrorEnabled(capturedRoom) then
            applyCurrentMirror(capturedRoom, true)
          end
        end)
      end
    end)(roomIdx)
  end

  function bindRoomOutputMirrorHandler(roomIdx, outIdx)
    mOutCtl = roomOutputMirrorCtl(roomIdx, outIdx)
    if not mOutCtl then return end
    mOutCtl.EventHandler = (function(capturedRoom, capturedOut)
      return function()
        runHandler("Mirror " .. capturedOut, function()
          muteHandlers(function()
            if isRoomOutputMirrorEnabled(capturedRoom, capturedOut) then
              if roomOptionMirror[capturedRoom] then
                roomOptionMirror[capturedRoom].Boolean = false
              end
            end
            enforceMirrorRequiresVisibility(capturedRoom)
          end)
          onSourceVisibilityChanged()
          if isRoomOutputMirrorEnabled(capturedRoom, capturedOut) then
            applyCurrentOutputMirror(capturedRoom, capturedOut, true)
          end
        end)
      end
    end)(roomIdx, outIdx)
  end

  function bindRoomOutputGlobalHandler(roomIdx, outIdx)
    gOutCtl = roomOutputGlobalCtl(roomIdx, outIdx)
    if not gOutCtl then return end
    gOutCtl.EventHandler = (function(capturedRoom, capturedOut)
      return function()
        runHandler("Global " .. capturedOut, function()
          onSourceVisibilityChanged()
        end)
      end
    end)(roomIdx, outIdx)
  end

  function bindRoomOptionHandlers()
    for roomIdx = 1, getRoomCount() do
      if roomOptionGlobal and roomOptionGlobal[roomIdx] then bindRoomGlobalHandler(roomIdx) end
      if roomOptionVisibility and roomOptionVisibility[roomIdx] then bindRoomVisibilityHandler(roomIdx) end
      if roomOptionMirror and roomOptionMirror[roomIdx] then bindRoomMirrorHandler(roomIdx) end
      for outIdx = 1, getOutputsPerRoom() do
        bindRoomOutputMirrorHandler(roomIdx, outIdx)
        bindRoomOutputGlobalHandler(roomIdx, outIdx)
      end
    end
  end

  function bindComboHandler(roomIdx, outIdx)
    routeCtl = comboCtl(roomIdx, outIdx)
    if not routeCtl then return end
    routeCtl.EventHandler = (function(capturedRoom, capturedOut)
      return function(ctl)
        runHandler("ComboBox", function()
          if mirroringNow then return end
          invalidateCaches()
          noteRoomInteraction(capturedRoom)
          chosen = findSlotByLabel(buildSourcePool(capturedRoom, capturedOut), ctl.String)
            or findActiveSlotByLabel(ctl.String)
          if chosen then
            selectSlot(capturedRoom, capturedOut, chosen)
          else
            refreshOutputColumn(capturedRoom, capturedOut)
            setColumnSelects(capturedRoom, capturedOut, getRoutedSlot(capturedRoom, capturedOut))
          end
        end)
      end
    end)(roomIdx, outIdx)
  end

  -- Per-output Select: room/out/slot captured at bind time (no page_index lookup).
  --
  -- Rising-edge only: Toggle/momentary buttons fire EventHandler on false
  -- (release or interlock clear). Acting on false re-applies that slot and
  -- undoes column radio. Ignore Boolean ~= true; if this slot is still the
  -- routed source, deferred-relatch after Designer finishes the false write.
  function bindSelectHandler(roomIdx, outIdx, avSlot)
    selCtl = selectCtl(roomIdx, outIdx, avSlot)
    if not selCtl then return end
    selCtl.EventHandler = (function(capturedRoomArg, capturedOut, capturedSlot)
      return function(ctl)
        runHandler("Source select", function()
          if mirroringNow then return end
          -- Each output owns its Select bank, so the room/column is known at
          -- bind time. No page_index lookup, which used to dead-end this handler.
          capturedRoom = capturedRoomArg
          noteRoomInteraction(capturedRoom)
          if ctl == nil then
            ctl = selectCtl(capturedRoom, capturedOut, capturedSlot)
          end
          if ctl == nil then return end
          routedNow = getRoutedSlot(capturedRoom, capturedOut)
          if ctl.Boolean ~= true then
            if routedNow == capturedSlot then
              setColumnSelects(capturedRoom, capturedOut, capturedSlot)
              Timer.CallAfter(function()
                if mirroringNow then return end
                if getRoutedSlot(capturedRoom, capturedOut) ~= capturedSlot then return end
                setColumnSelects(capturedRoom, capturedOut, capturedSlot)
              end, 0)
            end
            return
          end
          invalidateCaches()
          selectSlot(capturedRoom, capturedOut, capturedSlot)
        end)
      end
    end)(roomIdx, outIdx, avSlot)
  end

  function bindSetupSrcSelHandler(avSlot)
    sharedIdx = sharedSlotIndex(avSlot)
    selCtl = setupSrcSelCtl(sharedIdx)
    if not selCtl then return end
    selCtl.EventHandler = function(ctl)
      runHandler("Setup source preview", function()
        if ctl and ctl.Boolean == true then
          muteHandlers(function()
            ctl.Boolean = false
          end)
        end
      end)
    end
  end

  function bindSharedLabelHandler(avSlot)
    labelCtl = canonicalLabelControl(avSlot)
    if not labelCtl then return end
    labelCtl.EventHandler = function(ctl)
      runHandler("Source label", function()
        -- Immediate Legend fan-out for all rooms (incl. 5–8); deferred layout
        -- still rebuilds Choices / show-hide after the faceplate settles.
        propagateSlotNameChange(avSlot, ctl and ctl.String or "")
        scheduleDeferredLayout(true)
      end)
    end
  end

  function bindSharedOutputHandler(avSlot)
    outputCtl = canonicalOutputControl(avSlot)
    if not outputCtl then return end
    outputCtl.EventHandler = function(ctl)
      runHandler("Source output", function()
        setSlotOutput(avSlot, trimString(ctl.String))
        scheduleDeferredLayout(true)
      end)
    end
  end

  function bindRoomOutputHandlers()
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, getOutputsPerRoom() do
        bindComboHandler(roomIdx, outIdx)
      end
    end
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, getOutputsPerRoom() do
        for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
          bindSelectHandler(roomIdx, outIdx, avSlot)
        end
      end
    end
    for _, avSlot in ipairs(ACTIVE_SLOT_LIST) do
      bindSharedLabelHandler(avSlot)
      bindSharedOutputHandler(avSlot)
      bindSetupSrcSelHandler(avSlot)
    end
  end

  function bindGlobalSelectHandler(globalIdx)
    globalSourceControls[globalIdx].EventHandler = (function(capturedGlobal)
      return function(ctl)
        runHandler("Global select", function()
          if ctl == nil then
            ctl = globalSourceControls[capturedGlobal]
          end
          if ctl == nil then return end
          -- Rising-edge only (same Toggle/momentary false trap as room Selects).
          if ctl.Boolean ~= true then
            Timer.CallAfter(function()
              refreshGlobalTab()
            end, 0)
            return
          end
          selectGlobalSlot(capturedGlobal)
        end)
      end
    end)(globalIdx)
  end

  function bindGlobalTabHandlers()
    if Controls.globalSourceComboBox then
      Controls.globalSourceComboBox.EventHandler = function()
        runHandler("Global combo", function()
          refreshGlobalTab()
        end)
      end
    end
    for globalIdx = 1, getGlobalSourceCount() do
      if globalSourceControls and globalSourceControls[globalIdx] then bindGlobalSelectHandler(globalIdx) end
    end
  end

  layoutDirty = false
  layoutDirtyFanOut = false
  function scheduleDeferredLayout(doFanOut)
    if doFanOut then layoutDirtyFanOut = true end
    if layoutDirty then return end
    layoutDirty = true
    Timer.CallAfter(function()
      wantFan = layoutDirtyFanOut
      layoutDirty = false
      layoutDirtyFanOut = false
      if not bootComplete or isUpdating then return end
      if wantFan then
        safeHandleLayoutChange()
      else
        okPage, errPage = pcall(function()
          handleLayoutChange(false)
        end)
        resetUpdateGate()
        if not okPage then
          reportScriptError("Deferred layout", errPage)
        end
      end
    end, 0)
  end

  function onPluginPropertiesChanged()
    if not bootComplete or isUpdating then return end
    refreshActiveDimensions()
    if dimensionFingerprint() == lastDimensionFingerprint then
      return
    end
    -- Property path: only dirty + deferred sync (Designer also rebuilds Counts).
    scheduleDeferredLayout(true)
  end

  function bindPropertyHandlers()
    propNames = {
      "Room Count",
      "Sources Per Room",
      "Outputs Per Room",
      "Global Source Count",
    }
    for _, propName in ipairs(propNames) do
      propCtl = Properties and Properties[propName]
      if propCtl then
        propCtl.EventHandler = function()
          onPluginPropertiesChanged()
        end
      end
    end
  end

  function bindPluginHandlers()
    if Properties and Properties["page_index"] then
      Properties["page_index"].EventHandler = function()
        refreshActivePage()
        if isUpdating then
          resetUpdateGate()
        end
        pcall(syncViewedRoomSelects)
        -- Style=None Selects need a forced Legend rewrite on every tab open
        -- (rooms 5+ especially); deferred layout alone is not enough.
        pcall(refreshSelectLegendsForPage)
        scheduleDeferredLayout(false)
      end
    end
    bindPropertyHandlers()
    bindSetupHandlers()
    bindRoomOptionHandlers()
    bindRoomOutputHandlers()
    bindGlobalTabHandlers()
    configPollTimer.EventHandler = function()
      pollCombinerChanges()
    end
  end

  -- Boot --------------------------------------------------------------------

  function seedDefaultRoutes()
    for roomIdx = 1, getRoomCount() do
      for outIdx = 1, getOutputsPerRoom() do
        flatOut = outputFlatIndex(roomIdx, outIdx)
        routeCtl = comboCtl(roomIdx, outIdx)
        if routeCtl and trimString(routeCtl.String) == "" then
          slots = visibleSlotsForOutput(roomIdx, outIdx)
          if #slots > 0 then
            applyRouteSlot(roomIdx, outIdx, slots[1])
          end
        end
      end
    end
  end

  function initDefaults()
    resetUpdateGate()
    syncPropertyPins()
    -- Name ("AV N") product default on fresh controls; Legend tracks Boolean.
    syncOutputStringFormatLegend(true)
    -- Labels / OutputStrings / Select Legends must not be written while
    -- isUpdating; populateSlotStrings runs after the gate is clear.
    populateSlotStrings(true)
    invalidateCaches()
    muteHandlers(function()
      -- Saved Global All on + new Global 1–N (default off): turn 1–N on.
      for roomIdx = 1, getRoomCount() do
        if isRoomGlobalEnabled(roomIdx) then
          setRoomPerOutputGlobals(roomIdx, true)
        end
      end
      if setupGlobal and setupGlobal.Boolean == true then
        setAllPerOutputGlobals(true)
      end
      seedDefaultRoutes()
    end)
    if status then
      selBound, optBound = countBoundHandlers()
      status.String = string.format(
        "sel=%d opt=%d | labels %d | v%s | boot",
        selBound,
        optBound,
        lastLabelsSeeded or 0,
        PluginInfo.Version
      )
    end
  end

  function boot()
    initDefaults()
    resetUpdateGate()
    scanRoomCombiners()
    savedCombiner = trimString(setupDefaultRC.String)
    if combinerIsValid(savedCombiner) then
      setRoomCombiner(savedCombiner)
    elseif #roomCombiners > 0 then
      setRoomCombiner(roomCombiners[1])
    end
    bootComplete = true
    refreshActivePage()
    -- Seed the paint target so a stuck page_index still has a room to latch
    -- before the user has touched anything. Each room owns its Select bank;
    -- this only names which bank to paint when page_index cannot.
    noteRoomInteraction(viewedRoomIdx() or 1)
    -- First full sync: combo lists from Sources Per Room / Global count, and
    -- Select/Label/Output show/hide from the combiner config if it is ready.
    handleLayoutChange()
    resetUpdateGate()
    pagePollTimer.EventHandler = function()
      pageIdx = Properties["page_index"].Value
      pageChanged = pageIdx ~= lastPageIdx
      if pageChanged then
        lastPageIdx = pageIdx
        refreshActivePage()
        pcall(syncViewedRoomSelects)
        pcall(refreshSelectLegendsForPage)
      end
      -- Designer sometimes changes integer properties without firing
      -- EventHandler; defer a single rebuild instead of syncing inline.
      refreshActiveDimensions()
      propsChanged = dimensionFingerprint() ~= lastDimensionFingerprint
      if propsChanged then
        scheduleDeferredLayout(true)
      elseif pageChanged then
        scheduleDeferredLayout(false)
      end
    end
    -- Slow poll: property/page EventHandlers are primary; this is a backstop.
    pagePollTimer:Start(1.0)
  end

  okBind, errBind = pcall(bindPluginHandlers)
  if not okBind then
    reportScriptError("Bind handlers", errBind)
  end
  ok, err = pcall(boot)
  resetUpdateGate()
  bootComplete = true
  if not ok then
    reportScriptError("Script error", err)
  else
    -- One more sync after bootComplete so Choices, Labels, Legends and
    -- selects are applied with handlers live and the update gate clear.
    pcall(handleLayoutChange)
    resetUpdateGate()
  end

  -- Combiner fingerprint backstop; wall/config EventHandlers are primary.
  configPollTimer:Start(2.0)
  selectPressTimer.EventHandler = function()
    applyPressedSelects()
  end
  selectPressTimer:Start(0.1)
  -- Emulate often attaches the Room Combiner a beat after script start. Rebind
  -- and force combo + show/hide from the live configuration once it is there.
  Timer.CallAfter(function()
    pcall(function()
      scanRoomCombiners()
      savedCombiner = trimString(setupDefaultRC.String)
      if combinerIsValid(savedCombiner) then
        setRoomCombiner(savedCombiner)
      elseif #roomCombiners > 0 then
        setRoomCombiner(roomCombiners[1])
      else
        invalidateCaches()
        handleLayoutChange()
        resetUpdateGate()
      end
    end)
  end, 0.25)
  Timer.CallAfter(function()
    pcall(function()
      scanRoomCombiners()
      savedCombiner = trimString(setupDefaultRC.String)
      if combinerIsValid(savedCombiner) then
        setRoomCombiner(savedCombiner)
      elseif #roomCombiners > 0 then
        setRoomCombiner(roomCombiners[1])
      else
        invalidateCaches()
        handleLayoutChange()
        resetUpdateGate()
      end
    end)
  end, 0.75)
end
